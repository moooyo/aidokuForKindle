import { State, Commands } from "state.slint";
import { Strings } from "strings.slint";
import { ToggleRow } from "widgets.slint";
import { SettingsSectionLabel, SettingsValueRow } from "settings-controls.slint";

export component HardwareOptions inherits Rectangle {
    height: capability.y + capability.height;
    heading := SettingsSectionLabel { x: 0px; y: 0px; width: root.width; text: Strings.image-processing; }
    jpeg := ToggleRow {
        x: 0px; y: heading.height + 8px; width: root.width;
        text: Strings.jpeg-hardware-decode;
        value: State.hardware-acceleration;
        enabled: State.hardware-media-available;
        toggled => { Commands.action("settings", "set", "hardware-acceleration=" + (State.hardware-acceleration ? "false" : "true")); }
    }
    capability := SettingsValueRow {
        x: 0px; y: jpeg.y + jpeg.height; width: root.width;
        text: Strings.setting-device-support;
        value: State.hardware-media-available ? Strings.setting-available : Strings.unavailable;
    }
}
