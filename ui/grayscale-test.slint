import { State } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { Caption } from "widgets.slint";
import { SettingsSectionLabel } from "settings-controls.slint";

export component GrayscaleTest inherits Rectangle {
    height: bar.y + bar.height + 6px + 24px;

    label := SettingsSectionLabel {
        x: 0px; y: 0px; width: root.width; text: Strings.grayscale-test;
    }
    bar := Rectangle {
        x: 0px; y: label.height + 8px; width: root.width; height: State.large-screen ? 56px : 48px;
        border-width: 1px; border-color: Theme.secondary;
        Image {
            x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
            source: State.grayscale-preview; image-fit: fill;
        }
    }
    for endpoint[index] in ["0", "255"]: Caption {
        x: index == 0 ? 0px : root.width - self.width; y: bar.y + bar.height + 6px;
        width: 60px; height: 24px;
        text: endpoint; font-family: Theme.numbers; horizontal-alignment: index == 0 ? left : right;
    }
}
