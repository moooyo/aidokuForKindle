import { State, Commands } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { Caption, ActionButton, SegmentedControl } from "widgets.slint";
import { PanelHeader } from "panels-common.slint";
import { TagFlow } from "tag-flow.slint";

export component CatalogFilterPanel inherits Rectangle {
    property <length> pad: State.large-screen ? 24px : 22px;
    property <length> pad-top: State.large-screen ? 24px : 20px;
    property <length> heading-height: State.large-screen ? 50px : 44px;
    property <length> label-height: State.large-screen ? 24px : 22px;
    property <length> sort-label-top: root.pad-top + root.heading-height + 14px;
    property <length> tags-label-top: sort.y + sort.height + 18px;
    property <length> apply-top: (State.catalog-tag-options.length > 0 ? tags.y + tags.height : sort.y + sort.height) + 20px;
    height: root.apply-top + Theme.touch + 24px;
    background: Theme.paper;
    border-width: State.large-screen ? Theme.popup-border : 0px;
    border-color: Theme.ink;
    if !State.large-screen: Rectangle { x: 0px; y: 0px; width: parent.width; height: Theme.popup-border; background: Theme.ink; }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    PanelHeader {
        x: root.pad; y: root.pad-top; width: parent.width - root.pad * 2; height: root.heading-height;
        text: Strings.filter; action-text: Strings.keyboard-done; primary: false;
        closed => { Commands.action("catalog", "apply-filter", ""); }
    }
    Caption { x: root.pad; y: root.sort-label-top; width: parent.width - root.pad * 2; height: root.label-height; text: Strings.sort; letter-spacing: 2px; }
    sort := SegmentedControl {
        x: root.pad; y: root.sort-label-top + root.label-height + 10px; width: parent.width - root.pad * 2;
        labels: [Strings.popular, Strings.recently-updated, Strings.sort-rating];
        item-enabled: [true, true, State.catalog-rating-available];
        selected: State.catalog-sort-index;
        cell-height: State.large-screen ? 48px : 44px;
        chosen(index) => { Commands.action("catalog", "filter-choice", index == 0 ? "sort:relevance" : index == 1 ? "sort:latest" : "sort:rating"); }
    }
    if State.catalog-tag-options.length > 0: Caption {
        x: root.pad; y: root.tags-label-top; width: parent.width - root.pad * 2; height: root.label-height;
        text: Strings.tags; letter-spacing: 2px;
    }
    tags := TagFlow {
        x: root.pad; y: root.tags-label-top + root.label-height + 10px; width: parent.width - root.pad * 2;
        filter-options: State.catalog-tag-options; item-height: 44px;
        text-size: Theme.caption; horizontal-padding: 16px; intrinsic-width: true;
        chosen(index) => { Commands.action("catalog", "filter-choice", State.catalog-tag-options[index].id); }
    }
    ActionButton {
        x: root.pad; y: root.apply-top; width: parent.width - root.pad * 2;
        text: (State.catalog-has-more ? Strings.show-loaded-results : Strings.show-catalog-results) + State.catalog-filter-result-count + " " + Strings.books-unit;
        primary: true; clicked => { Commands.action("catalog", "apply-filter", ""); }
    }
}
