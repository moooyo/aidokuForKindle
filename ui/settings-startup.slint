import { State, Commands } from "state.slint";
import { Strings } from "strings.slint";
import { Theme } from "theme.slint";
import { ActionButton, ToggleRow } from "widgets.slint";
import { SettingsSectionLabel } from "settings-controls.slint";

export component StartupSettings inherits Rectangle {
    property <length> row-height: State.large-screen ? 60px : 54px;
    property <length> controls-top: heading.height + 8px;
    height: presets.y + presets.height + 10px + Theme.touch;

    heading := SettingsSectionLabel { x: 0px; y: 0px; width: root.width; text: Strings.setting-startup; }
    for item[index] in State.settings-details: ToggleRow {
        x: 0px; y: root.controls-top + index * root.row-height;
        width: root.width; height: root.row-height;
        text: item.title; enabled: item.enabled; value: item.value == "on";
        toggled => { Commands.action("settings", "startup-set", item.id + (self.value ? "=off" : "=on")); }
    }
    presets := HorizontalLayout {
        x: 0px; y: root.controls-top + State.settings-details.length * root.row-height + 14px;
        width: root.width; height: Theme.touch; spacing: 10px;
        ActionButton {
            preferred-width: 1px; horizontal-stretch: 1; text: Strings.startup-enable-all;
            clicked => { Commands.action("settings", "startup-preset", "all"); }
        }
        ActionButton {
            preferred-width: 1px; horizontal-stretch: 1; text: Strings.startup-restore-recommended;
            clicked => { Commands.action("settings", "startup-preset", "recommended"); }
        }
    }
    ActionButton {
        x: 0px; y: presets.y + presets.height + 10px; width: root.width;
        text: Strings.startup-return-kindle; primary: true; enabled: State.quick-return-available;
        clicked => { Commands.action("app", "quick-return", ""); }
    }
}
