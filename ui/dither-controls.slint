import { State, Commands } from "state.slint";
import { Strings } from "strings.slint";
import { SegmentedControl } from "widgets.slint";
import { SettingsSectionLabel } from "settings-controls.slint";

export component DitherSelector inherits Rectangle {
    height: options.y + options.height;
    SettingsSectionLabel {
        x: 0px; y: 0px; width: root.width; text: Strings.dither;
    }
    options := SegmentedControl {
        x: 0px; y: State.large-screen ? 30px : 27px; width: root.width;
        labels: [Strings.off, Strings.dither-bayer8, "Floyd–Steinberg"];
        selected: !State.dither ? 0 : State.dither-method == "floyd_steinberg" ? 2 : 1;
        cell-height: State.large-screen ? 50px : 44px;
        chosen(index) => {
            Commands.action("settings", "set", "dither-mode=" + (index == 0 ? "off" : index == 1 ? "bayer8" : "floyd_steinberg"));
        }
    }
}
