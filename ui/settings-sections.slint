import { State, Commands } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, BodyText, Caption, Icon, InlineAction, SegmentedControl, ToggleRow, TitleText } from "widgets.slint";
import { ReadingOptions, LightOptions, RefreshOptions } from "native-controls.slint";
import { SettingsSectionLabel, SettingsValueRow } from "settings-controls.slint";
import { HardwareOptions } from "hardware-options.slint";
import { DitherSelector } from "dither-controls.slint";
import { GrayscaleTest } from "grayscale-test.slint";
import { StartupSettings } from "settings-startup.slint";
import { TapLayoutSelector } from "settings-tap-card.slint";
import { StorageSettings, CategoriesSettings, DownloadSettings, SourceListsSettings } from "settings-data.slint";

component ReadingSettings inherits Rectangle {
    property <length> section-gap: State.large-screen ? 26px : 20px;
    height: reverse.y + reverse.height;
    heading := SettingsSectionLabel { x: 0px; y: 0px; width: root.width; text: Strings.setting-page-turn; }
    reading := ReadingOptions { x: 0px; y: heading.height + 8px; width: root.width; }
    tap-heading := SettingsSectionLabel {
        x: 0px; y: reading.y + reading.height + root.section-gap; width: root.width;
        text: Strings.tap-regions;
    }
    tap-options := TapLayoutSelector { x: 0px; y: tap-heading.y + tap-heading.height + 8px; width: root.width; }
    reverse := ToggleRow {
        x: 0px; y: tap-options.y + tap-options.height + 12px; width: root.width;
        text: Strings.reverse-tap; value: State.reverse-taps;
        toggled => { Commands.action("settings", "set", "reverse-taps=" + (self.value ? "false" : "true")); }
    }
}

component LanguageSettings inherits Rectangle {
    property <length> row-height: State.large-screen ? 60px : 54px;
    height: heading.height + 8px + root.row-height * 4;
    heading := SettingsSectionLabel { x: 0px; y: 0px; width: root.width; text: Strings.setting-choose-language; }
    for label[index] in [Strings.chinese, Strings.traditional-chinese, Strings.english, Strings.japanese]: Rectangle {
        property <string> code: index == 0 ? "zh-CN" : index == 1 ? "zh-TW" : index == 2 ? "en" : "ja";
        property <bool> selected: State.language == self.code;
        x: 0px; y: heading.height + 8px + index * root.row-height;
        width: root.width; height: root.row-height;
        accessible-role: radio-button; accessible-label: label; accessible-checkable: true; accessible-checked: self.selected;
        BodyText {
            x: 0px; y: 0px; width: parent.width - 34px; height: parent.height;
            text: label; font-weight: parent.selected ? 700 : 400;
            font-family: parent.code == "zh-TW" || parent.code == "ja" ? Theme.locale-fallback : Theme.sans;
        }
        if self.selected: Icon {
            x: parent.width - 22px; y: (parent.height - 22px) / 2;
            width: 22px; height: 22px; kind: "check";
        }
        TouchArea {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            clicked => { if !parent.selected { Commands.action("settings", "set", "language=" + parent.code); } }
        }
    }
}

component AboutSettings inherits Rectangle {
    property <length> row-height: State.large-screen ? 60px : 54px;
    height: heading.height + 8px + State.settings-details.length * root.row-height;
    heading := SettingsSectionLabel { x: 0px; y: 0px; width: root.width; text: "Aidoku for Kindle"; }
    for item[index] in State.settings-details: SettingsValueRow {
        x: 0px; y: heading.height + 8px + index * root.row-height; width: root.width;
        text: item.title; value: item.id == "license" ? "" : item.value;
        value-family: item.id == "version" ? Theme.numbers : Theme.sans;
        action: item.id == "license" ? Strings.view : ""; enabled: item.enabled && !State.busy;
        clicked => { Commands.action("settings", "detail", item.id); }
    }
}

component BackupSettings inherits Rectangle {
    property <length> row-height: State.large-screen ? 72px : 64px;
    height: heading.y + heading.height + 8px + max(1, State.settings-details.length) * root.row-height;
    actions := HorizontalLayout {
        x: 0px; y: 0px; width: root.width; height: Theme.touch; spacing: 10px;
        ActionButton {
            preferred-width: 1px; horizontal-stretch: 1;
            text: Strings.backup-now; primary: true; enabled: !State.busy;
            clicked => { Commands.action("settings", "backup-create", ""); }
        }
        ActionButton {
            preferred-width: 1px; horizontal-stretch: 1;
            text: Strings.restore-backup; enabled: !State.busy;
            clicked => { Commands.action("settings", "backup-restore", ""); }
        }
    }
    heading := SettingsSectionLabel {
        x: 0px; y: actions.height + (State.large-screen ? 26px : 20px); width: root.width;
        text: Strings.recent-backups;
    }
    for item[index] in State.settings-details: Rectangle {
        x: 0px; y: heading.y + heading.height + 8px + index * root.row-height;
        width: root.width; height: root.row-height;
        BodyText {
            x: 0px; y: (parent.height - 48px) / 2; width: restore.x - 12px; height: 26px;
            text: item.title; font-family: item.group == "backup-auto" ? Theme.sans : Theme.numbers;
        }
        HorizontalLayout {
            x: 0px; y: (parent.height - 48px) / 2 + 26px; width: restore.x - 12px; height: 22px;
            spacing: 6px; alignment: start;
            Caption { text: Strings.metadata-backup-counts; }
            Caption { text: item.value; font-family: Theme.numbers; }
        }
        restore := InlineAction {
            x: parent.width - self.width; y: (parent.height - self.height) / 2;
            text: Strings.setting-restore; enabled: item.enabled && !State.busy;
            clicked => { Commands.action("settings", item.id, ""); }
        }
    }
    if State.settings-details.length == 0: Caption {
        x: 0px; y: heading.y + heading.height + 8px; width: root.width; height: root.row-height;
        text: State.busy ? Strings.loading : State.settings-status != "" ? State.settings-status : Strings.metadata-backup-empty;
    }
}

component AccountCard inherits Rectangle {
    in property <string> service;
    in property <string> service-id;
    in property <bool> connected;
    in property <string> status;
    height: State.large-screen ? 60px : 54px;
    SettingsValueRow {
        x: 0px; y: 0px; width: root.width; height: root.height;
        text: root.service;
        detail: root.status != "" ? root.status : root.connected ? Strings.connected : Strings.not-configured;
        action: root.connected ? Strings.logout : Strings.login;
        enabled: !State.busy && !State.tracking-busy;
        clicked => { Commands.action("settings", root.connected ? "tracking-disconnect" : "tracking-connect", root.service-id); }
    }
}

export component SettingsBody inherits Rectangle {
    in property <string> section;
    property <length> row-height: State.large-screen ? 60px : 54px;
    property <length> section-gap: State.large-screen ? 26px : 20px;
    clip: true;

    Rectangle {
        x: 0px; y: root.section-gap; width: root.width; height: root.height - self.y;
        if root.section == "default-direction": ReadingSettings { x: 0px; y: 0px; width: root.width; }
        if root.section == "frontlight-warmth": Rectangle {
            x: 0px; y: 0px; width: root.width; height: heading.height + 8px + light.height;
            heading := SettingsSectionLabel { x: 0px; y: 0px; width: root.width; text: Strings.setting-frontlight-picture; }
            light := LightOptions { x: 0px; y: heading.height + 8px; width: root.width; }
        }
        if root.section == "screen-refresh": Rectangle {
            x: 0px; y: 0px; width: root.width; height: test.y + test.height;
            refresh := RefreshOptions { x: 0px; y: 0px; width: root.width; }
            dither := DitherSelector { x: 0px; y: refresh.height + root.section-gap; width: root.width; }
            test := GrayscaleTest { x: 0px; y: dither.y + dither.height + root.section-gap; width: root.width; }
        }
        if root.section == "hardware-acceleration": HardwareOptions { x: 0px; y: 0px; width: root.width; }
        if root.section == "storage": StorageSettings { x: 0px; y: 0px; width: root.width; }
        if root.section == "categories": CategoriesSettings { x: 0px; y: 0px; width: root.width; }
        if root.section == "backup": BackupSettings { x: 0px; y: 0px; width: root.width; }
        if root.section == "language": LanguageSettings { x: 0px; y: 0px; width: root.width; }
        if root.section == "about": AboutSettings { x: 0px; y: 0px; width: root.width; }
        if root.section == "startup-options": StartupSettings { x: 0px; y: 0px; width: root.width; }

        if root.section == "downloads": DownloadSettings { x: 0px; y: 0px; width: root.width; }
        if root.section == "source-lists": SourceListsSettings { x: 0px; y: 0px; width: root.width; }
        if root.section == "wifi-sleep-exit": Rectangle {
            x: 0px; y: 0px; width: root.width; height: parent.height;
            property <string> saver-mode: State.screensaver-mode == "cover" && !State.sleep-cover ? "system" : State.screensaver-mode;
            property <length> heading-top: 3 * root.row-height + root.section-gap;
            ToggleRow { x: 0px; y: 0px; width: parent.width; text: Strings.keep-awake; value: State.keep-awake; toggled => { Commands.action("settings", "set", "keep-awake=" + (self.value ? "false" : "true")); } }
            ToggleRow { x: 0px; y: root.row-height; width: parent.width; text: Strings.charging-updates; value: State.charging-updates; enabled: State.charging-status-supported; toggled => { Commands.action("settings", "set", "charging-updates=" + (self.value ? "false" : "true")); } }
            ToggleRow { x: 0px; y: 2 * root.row-height; width: parent.width; text: Strings.reading-wifi-off; value: State.reading-wifi-off; enabled: State.wifi-policy-supported; toggled => { Commands.action("settings", "set", "reading-wifi-off=" + (self.value ? "false" : "true")); } }
            saver-heading := SettingsSectionLabel { x: 0px; y: parent.heading-top; width: parent.width; text: Strings.screensaver; }
            for label[index] in [Strings.saver-cover, Strings.saver-progress, Strings.saver-system]: Rectangle {
                property <string> mode: index == 0 ? "cover" : index == 1 ? "progress" : "system";
                property <bool> selected: parent.saver-mode == self.mode;
                property <bool> available: index != 1 || State.screensaver-supported;
                x: index * (parent.width + 12px) / 3; y: saver-heading.y + saver-heading.height + 8px;
                width: (parent.width - 24px) / 3; height: State.large-screen ? 201px : 179px;
                accessible-role: radio-button; accessible-label: label; accessible-enabled: self.available; accessible-checkable: true; accessible-checked: self.selected;
                preview := Rectangle {
                    x: 0px; y: 0px; width: parent.width; height: State.large-screen ? 170px : 150px;
                    background: Theme.paper; border-width: parent.selected ? 2px : 1px;
                    border-color: parent.selected ? Theme.ink : parent.available ? Theme.secondary : Theme.disabled;
                    clip: true;
                    if index == 0 && State.current-book.cover.width > 0: Image {
                        x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px;
                        source: State.current-book.cover; image-fit: contain;
                    }
                    if index == 0 && State.current-book.cover.width == 0: TitleText {
                        x: 8px; y: 0px; width: parent.width - 16px; height: parent.height;
                        text: State.current-book.title != "" ? State.current-book.title : Strings.sleep-neutral;
                        font-size: Theme.caption; horizontal-alignment: center; wrap: word-wrap;
                    }
                    if index != 0: Caption {
                        x: 8px; y: 0px; width: parent.width - 16px; height: parent.height;
                        text: index == 2 ? "Kindle" : !State.screensaver-supported ? Strings.unavailable : State.reader-image-ready ? State.reader-page + " / " + State.reader-total : "—";
                        horizontal-alignment: center; wrap: word-wrap;
                    }
                }
                BodyText {
                    x: 0px; y: preview.height; width: parent.width; height: parent.height - self.y;
                    text: label; font-size: Theme.caption; color: parent.available ? Theme.ink : Theme.disabled;
                    font-weight: parent.selected ? 700 : 400; horizontal-alignment: center;
                }
                TouchArea {
                    x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: parent.available;
                    clicked => { if !parent.selected { Commands.action("settings", "set", "screensaver-mode=" + parent.mode); } }
                }
            }
        }
        if root.section == "auto-update": Rectangle {
            x: 0px; y: 0px; width: root.width; height: parent.height;
            update-heading := SettingsSectionLabel { x: 0px; y: 0px; width: root.width; text: Strings.update-frequency; }
            interval := SegmentedControl {
                x: 0px; y: update-heading.height + 8px; width: parent.width;
                labels: [Strings.off, Strings.daily, Strings.weekly];
                selected: State.auto-update-interval == "daily" ? 1 : State.auto-update-interval == "weekly" ? 2 : 0;
                chosen(index) => { Commands.action("settings", "set", "auto-update-interval=" + (index == 0 ? "off" : index == 1 ? "daily" : "weekly")); }
            }
            wifi := ToggleRow { x: 0px; y: interval.y + interval.height + 12px; width: parent.width; text: Strings.wifi-only; value: State.update-wifi-only; toggled => { Commands.action("settings", "set", "update-wifi-only=" + (self.value ? "false" : "true")); } }
            ToggleRow { x: 0px; y: wifi.y + root.row-height; width: parent.width; text: Strings.charging-only; value: State.update-charging-only; enabled: State.charging-status-supported; toggled => { Commands.action("settings", "set", "update-charging-only=" + (self.value ? "false" : "true")); } }
            ToggleRow { x: 0px; y: wifi.y + 2 * root.row-height; width: parent.width; text: Strings.skip-completed; value: State.update-skip-completed; toggled => { Commands.action("settings", "set", "update-skip-completed=" + (self.value ? "false" : "true")); } }
        }
        if root.section == "tracking": Rectangle {
            x: 0px; y: 0px; width: root.width; height: parent.height;
            AccountCard { x: 0px; y: 0px; width: parent.width; service: "AniList"; service-id: "anilist"; connected: State.anilist-connected; status: State.anilist-status; }
            AccountCard { x: 0px; y: root.row-height; width: parent.width; service: "MyAnimeList"; service-id: "myanimelist"; connected: State.myanimelist-connected; status: State.myanimelist-status; }
            ToggleRow { x: 0px; y: 2 * root.row-height; width: parent.width; text: Strings.auto-sync-chapter; value: State.tracking-auto-sync; toggled => { Commands.action("settings", "set", "tracking-auto-sync=" + (self.value ? "false" : "true")); } }
            ToggleRow { x: 0px; y: 3 * root.row-height; width: parent.width; text: Strings.queue-offline-tracking; value: State.tracking-queue-offline; toggled => { Commands.action("settings", "set", "tracking-queue-offline=" + (self.value ? "false" : "true")); } }
        }
        if root.section == "logs": Rectangle {
            x: 0px; y: 0px; width: root.width; height: parent.height;
            ToggleRow { x: 0px; y: 0px; width: parent.width; text: Strings.write-logs; value: State.write-logs; toggled => { Commands.action("settings", "set", "write-logs=" + (self.value ? "false" : "true")); } }
            log-actions := HorizontalLayout {
                x: 0px; y: root.row-height + 12px; width: parent.width; height: Theme.touch; spacing: 10px; alignment: start;
                ActionButton { text: Strings.export-logs; enabled: !State.busy; clicked => { Commands.action("settings", "logs-export", ""); } }
                ActionButton { text: Strings.clear-logs; enabled: !State.busy; clicked => { Commands.action("settings", "logs-clear", ""); } }
            }
            log-status := Caption {
                x: 0px; y: log-actions.y + log-actions.height + 12px; width: parent.width; height: 26px;
                text: State.settings-status == "" ? (State.write-logs ? Strings.on : Strings.off) : State.settings-status;
            }
            for item[index] in State.settings-details: SettingsValueRow {
                x: 0px; y: log-status.y + log-status.height + index * root.row-height; width: parent.width;
                text: item.title; value: item.value;
            }
        }
    }
}
