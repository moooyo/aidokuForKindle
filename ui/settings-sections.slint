import { State, Commands } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, BodyText, Caption, GroupLabel, Icon, RadioCard, ToggleRow, TitleText } from "widgets.slint";
import { SettingsChoice, SettingsSlider, SettingsValueRow, UnavailablePolicyRow } from "settings-controls.slint";
import { TapLayoutCard } from "settings-tap-card.slint";
import { StorageSettings, CategoriesSettings, DownloadSettings, SourceListsSettings } from "settings-data.slint";

component AccountCard inherits Rectangle {
    in property <string> service;
    in property <string> initial;
    x: 0px; y: 0px;
    height: State.large-screen ? 84px : 74px;
    border-width: Theme.control-border;
    border-color: Theme.ink;
    border-radius: Theme.control-radius;
    background: Theme.paper;
    Rectangle {
        x: State.large-screen ? 18px : 16px;
        y: (parent.height - self.height) / 2;
        width: State.large-screen ? 50px : 44px;
        height: self.width;
        border-width: Theme.control-border;
        border-color: Theme.ink;
        border-radius: Theme.control-radius;
        background: Theme.paper;
        Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: root.initial; font-family: Theme.numbers; font-size: State.large-screen ? 18px : 16px; font-weight: 700; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; }
    }
    BodyText { x: State.large-screen ? 84px : 74px; y: State.large-screen ? 16px : 13px; width: max(0px, parent.width - self.x - 112px); height: 28px; text: root.service; font-size: State.large-screen ? 18px : 17px; font-weight: 700; }
    Caption { x: State.large-screen ? 84px : 74px; y: State.large-screen ? 46px : 41px; width: max(0px, parent.width - self.x - 112px); height: 22px; text: Strings.not-configured; font-size: State.large-screen ? 14px : 13px; }
    ActionButton { x: parent.width - self.width - (State.large-screen ? 18px : 16px); y: (parent.height - self.height) / 2; height: State.large-screen ? 44px : 40px; width: 80px; text: Strings.login; enabled: false; }
}

export component SettingsBody inherits Rectangle {
    in property <string> section;
    property <length> row-height: State.large-screen ? 60px : 54px;
    property <length> group-height: State.large-screen ? 21px : 18px;
    property <length> section-gap: State.large-screen ? 12px : 10px;

    if root.section == "screen-refresh": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        GroupLabel { x: 0px; y: State.large-screen ? 10px : 0px; width: parent.width; height: root.group-height; text: Strings.refresh-interval; font-size: State.large-screen ? 14px : 12px; }
        for value[index] in [1, 3, 6, 10, 0]: SettingsChoice {
            x: index * (parent.width + 8px) / 5;
            y: State.large-screen ? 43px : 28px;
            width: (parent.width - 32px) / 5;
            text: value == 0 ? Strings.refresh-chapter : State.large-screen ? value == 1 ? Strings.refresh-each : value + " " + Strings.pages-unit : value;
            selected: State.refresh-every == value;
            clicked => { if State.refresh-every != value { Commands.action("settings", "set", "refresh-every=" + value); } }
        }
        GroupLabel { x: 0px; y: State.large-screen ? 115px : 90px; width: parent.width - 110px; height: root.group-height; text: Strings.page-quality; font-size: State.large-screen ? 14px : 12px; }
        Caption { x: parent.width - 110px; y: State.large-screen ? 115px : 90px; width: 110px; height: root.group-height; text: Strings.unavailable; horizontal-alignment: right; }
        for label[index] in [Strings.quality-first, Strings.balanced-recommended, Strings.speed-first]: RadioCard {
            x: 0px;
            y: (State.large-screen ? 148px : 118px) + index * (State.large-screen ? 68px : 60px);
            width: parent.width;
            text: label;
            selected: false;
            enabled: false;
        }
        ToggleRow { x: 0px; y: State.large-screen ? 356px : 304px; width: parent.width; text: Strings.chapter-full-refresh + " · " + Strings.fixed-on; value: true; enabled: false; }
        ToggleRow { x: 0px; y: (State.large-screen ? 356px : 304px) + root.row-height; width: parent.width; text: Strings.flash-close; value: State.flash-on-close; toggled => { Commands.action("settings", "set", "flash-on-close=" + (State.flash-on-close ? "false" : "true")); } }
        ToggleRow { x: 0px; y: (State.large-screen ? 356px : 304px) + root.row-height * 2; width: parent.width; text: Strings.night-mode; value: State.night-mode; toggled => { Commands.action("settings", "set", "night-mode=" + (State.night-mode ? "false" : "true")); } }
        GroupLabel { x: 0px; y: State.large-screen ? 558px : 482px; width: parent.width; height: root.group-height; text: Strings.grayscale-test; font-size: State.large-screen ? 14px : 12px; }
        Rectangle {
            x: 0px;
            y: State.large-screen ? 591px : 510px;
            width: parent.width; height: State.large-screen ? 38px : 34px;
            border-width: 1px; border-color: Theme.secondary; border-radius: Theme.control-radius; background: Theme.paper; clip: true;
            Rectangle {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                border-radius: 3px; clip: true;
                for index in 16: Rectangle { x: index * parent.width / 16; y: 0px; width: parent.width / 16 + 1px; height: parent.height; background: rgb(index * 17, index * 17, index * 17); }
            }
        }
    }

    if root.section == "frontlight-warmth": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        if State.has-frontlight: SettingsSlider { x: 0px; y: 6px; width: parent.width; text: Strings.brightness; preference: "brightness"; value: State.brightness; }
        if State.has-warmth: SettingsSlider { x: 0px; y: State.large-screen ? 114px : 102px; width: parent.width; text: Strings.warmth; preference: "warmth"; value: State.warmth; }
        if !State.has-frontlight: Caption { x: 0px; y: 0px; width: parent.width; height: 32px; text: Strings.unavailable; }
    }

    if root.section == "pen": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        ToggleRow { x: 0px; y: 0px; width: parent.width; text: Strings.pen-tap; value: false; enabled: false; }
        ToggleRow { x: 0px; y: root.row-height; width: parent.width; text: Strings.palm-rejection; value: false; enabled: false; }
        Caption { x: 0px; y: root.row-height * 2 + 12px; width: parent.width; height: 26px; text: Strings.unavailable; }
    }

    if root.section == "wifi-sleep-exit": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        property <length> saver-label-top: State.large-screen ? 202px : root.row-height * 3 + root.section-gap + 8px;
        property <length> saver-label-height: State.large-screen ? root.group-height : 17.5px;
        property <length> saver-grid-top: self.saver-label-top + self.saver-label-height + root.section-gap;
        property <length> saver-card-height: State.large-screen ? 201px : 179px;
        ToggleRow { x: 0px; y: 0px; width: parent.width; text: Strings.keep-awake; value: State.keep-awake; toggled => { Commands.action("settings", "set", "keep-awake=" + (State.keep-awake ? "false" : "true")); } }
        UnavailablePolicyRow { x: 0px; y: root.row-height; width: parent.width; text: Strings.charging-updates; reason: Strings.charging-updates-unavailable; }
        UnavailablePolicyRow { x: 0px; y: root.row-height * 2; width: parent.width; text: Strings.reading-wifi-off; reason: Strings.reading-wifi-off-unavailable; }
        GroupLabel { x: 0px; y: parent.saver-label-top; width: parent.width - 110px; height: parent.saver-label-height; text: Strings.screensaver; font-size: State.large-screen ? 14px : 12px; }
        Caption { x: parent.width - 110px; y: parent.saver-label-top; width: 110px; height: parent.saver-label-height; text: Strings.unavailable; horizontal-alignment: right; }
        for label[index] in [Strings.saver-cover, Strings.saver-progress, Strings.saver-system]: Rectangle {
            x: index * (parent.width + (State.large-screen ? 14px : 12px)) / 3;
            y: parent.saver-grid-top;
            width: (parent.width - (State.large-screen ? 28px : 24px)) / 3;
            height: parent.saver-card-height;
            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: State.large-screen ? 170px : 150px;
                background: Theme.paper; border-width: 1px; border-color: Theme.disabled; border-radius: Theme.control-radius; clip: true;
                if index == 0 && State.current-book.cover.width > 0: Image { x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px; source: State.current-book.cover; image-fit: cover; }
                if index == 0 && State.current-book.cover.width == 0: TitleText { x: 8px; y: 12px; width: parent.width - 16px; height: parent.height - 24px; text: State.current-book.title; font-size: State.large-screen ? 17px : 15px; horizontal-alignment: center; wrap: word-wrap; }
                if index == 1: Text { x: 8px; y: 0px; width: parent.width - 16px; height: parent.height; text: State.reader-image-ready ? State.reader-page + " / " + State.reader-total : "—"; font-family: Theme.numbers; font-size: State.large-screen ? 19px : 17px; font-weight: 700; color: Theme.secondary; horizontal-alignment: center; vertical-alignment: center; }
                if index == 2 && State.large-screen: Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: "Kindle"; font-family: Theme.numbers; font-size: State.large-screen ? 19px : 17px; font-weight: 700; color: Theme.secondary; horizontal-alignment: center; vertical-alignment: center; }
                if index == 2 && !State.large-screen: Rectangle {
                    x: (parent.width - self.width) / 2; y: parent.height - self.height - 10px;
                    width: kindle-caption.preferred-width + 20px; height: kindle-caption.preferred-height + 4px;
                    background: Theme.paper; border-radius: 4px;
                    kindle-caption := Text { x: 10px; y: 2px; width: self.preferred-width; height: self.preferred-height; text: "Kindle"; font-family: Theme.serif; font-size: 12px; font-weight: 900; color: Theme.secondary; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
            if State.large-screen: BodyText { x: 0px; y: State.large-screen ? 178px : 158px; width: parent.width; height: State.large-screen ? 23px : 21px; text: label; font-size: State.large-screen ? 15px : 14px; color: Theme.disabled; horizontal-alignment: center; }
            if !State.large-screen: BodyText { x: 0px; y: 158px; width: parent.width; height: 21px; text: label; font-size: 14px; font-weight: 500; color: Theme.disabled; horizontal-alignment: center; }
        }
        Rectangle {
            x: 0px;
            y: parent.saver-grid-top + parent.saver-card-height + root.section-gap + (State.large-screen ? 0px : 3px);
            width: parent.width; height: State.large-screen ? 60px : 74px;
            border-width: State.large-screen ? 0px : Theme.control-border;
            border-color: Theme.ink; border-radius: Theme.control-radius; background: Theme.paper;
            if State.large-screen: Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
            BodyText { x: State.large-screen ? 0px : 18px; y: 0px; width: parent.width - self.x - 108px; height: parent.height; text: Strings.exit-to-home; font-size: State.large-screen ? 17px : 16px; font-weight: State.large-screen ? 400 : 700; }
            ActionButton { x: parent.width - self.width - (State.large-screen ? 0px : 18px); y: (parent.height - self.height) / 2; height: 44px; width: 66px; text: Strings.logout; primary: !State.large-screen; clicked => { Commands.action("panel", "choose", "exit"); } }
            if State.large-screen: Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
        }
    }

    if root.section == "default-direction": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        GroupLabel { x: 0px; y: State.large-screen ? 10px : 0px; width: parent.width; height: root.group-height; text: Strings.default-direction; font-size: State.large-screen ? 14px : 12px; }
        for label[index] in [Strings.rtl, Strings.ltr, Strings.vertical-paging, Strings.webtoon]: SettingsChoice {
            property <string> direction: index == 0 ? "rtl" : index == 1 ? "ltr" : index == 2 ? "vertical-pages" : "vertical";
            x: index * (parent.width + 8px) / 4; y: State.large-screen ? 43px : 28px;
            width: (parent.width - 24px) / 4;
            text: label; selected: State.reading-direction == self.direction;
            clicked => { if State.reading-direction != self.direction { Commands.action("settings", "set", "reading-direction=" + self.direction); } }
        }
        ToggleRow { x: 0px; y: State.large-screen ? 105px : 84px; width: parent.width; text: Strings.per-book-direction; value: State.remember-book-direction; toggled => { Commands.action("settings", "set", "remember-book-direction=" + (State.remember-book-direction ? "false" : "true")); } }
        ToggleRow { x: 0px; y: (State.large-screen ? 105px : 84px) + root.row-height; width: parent.width; text: Strings.double-tap-zoom; value: State.double-tap-zoom; toggled => { Commands.action("settings", "set", "double-tap-zoom=" + (State.double-tap-zoom ? "false" : "true")); } }
    }

    if root.section == "tap-regions": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        for label[index] in [Strings.thirds, Strings.tap-l-shape, Strings.swipe-only]: TapLayoutCard {
            property <string> target-layout: index == 0 ? "thirds" : index == 1 ? "l-shaped" : "swipe-only";
            property <string> current-layout: State.tap-layout == "reverse" || State.tap-layout == "reversed" ? "thirds" : State.tap-layout;
            x: 0px;
            y: index * (State.large-screen ? 71px : 60px); width: parent.width; height: State.large-screen ? 63px : 52px;
            text: label;
            layout: self.target-layout;
            selected: self.current-layout == self.target-layout;
            clicked => { if self.current-layout != self.target-layout { Commands.action("settings", "set", "tap-layout=" + self.target-layout); } }
        }
        ToggleRow { x: 0px; y: State.large-screen ? 217px : 184px; width: parent.width; text: Strings.reverse; value: State.reverse-taps; toggled => { Commands.action("settings", "set", "reverse-taps=" + (State.reverse-taps ? "false" : "true")); } }
        ToggleRow { x: 0px; y: (State.large-screen ? 217px : 184px) + root.row-height; width: parent.width; text: Strings.show-tap-zones; value: State.show-tap-zones; toggled => { Commands.action("settings", "set", "show-tap-zones=" + (State.show-tap-zones ? "false" : "true")); } }
    }

    if root.section == "image-processing": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        GroupLabel { x: 0px; y: State.large-screen ? 10px : 0px; width: parent.width; height: root.group-height; text: Strings.contrast; font-size: State.large-screen ? 14px : 12px; }
        for label[index] in ["−2", "−1", Strings.standard, "+1", "+2"]: SettingsChoice {
            x: index * (parent.width + 8px) / 5; y: State.large-screen ? 43px : 28px;
            width: (parent.width - 32px) / 5; text: label; selected: State.contrast == index - 2;
            clicked => { if State.contrast != index - 2 { Commands.action("settings", "set", "contrast=" + (index - 2)); } }
        }
        ToggleRow { x: 0px; y: State.large-screen ? 105px : 84px; width: parent.width; text: Strings.crop-borders; value: State.crop-borders; toggled => { Commands.action("settings", "set", "crop-borders=" + (State.crop-borders ? "false" : "true")); } }
        ToggleRow { x: 0px; y: (State.large-screen ? 105px : 84px) + root.row-height; width: parent.width; text: Strings.dither; value: State.dither; toggled => { Commands.action("settings", "set", "dither=" + (State.dither ? "false" : "true")); } }
        ToggleRow { x: 0px; y: (State.large-screen ? 105px : 84px) + root.row-height * 2; width: parent.width; text: Strings.split-wide; value: false; enabled: false; }
    }

    if root.section == "spread": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        GroupLabel { x: 0px; y: State.large-screen ? 10px : 0px; width: parent.width; height: root.group-height; text: Strings.when-landscape; font-size: State.large-screen ? 14px : 12px; }
        for label[index] in [Strings.auto-spread, Strings.always-spread, Strings.keep-single]: SettingsChoice {
            property <string> layout: index == 0 ? "automatic" : index == 1 ? "double" : "single";
            x: index * (parent.width + 8px) / 3; y: State.large-screen ? 43px : 28px;
            width: (parent.width - 16px) / 3; text: label;
            selected: State.page-layout-mode == self.layout;
            clicked => { if State.page-layout-mode != self.layout { Commands.action("settings", "set", "page-layout-mode=" + self.layout); } }
        }
        GroupLabel { x: 0px; y: State.large-screen ? 115px : 90px; width: parent.width - 110px; height: root.group-height; text: Strings.wide-images; font-size: State.large-screen ? 14px : 12px; }
        Caption { x: parent.width - 110px; y: State.large-screen ? 115px : 90px; width: 110px; height: root.group-height; text: Strings.unavailable; horizontal-alignment: right; }
        for label[index] in [Strings.whole-page, Strings.split-two-pages]: SettingsChoice { x: index * (parent.width + 8px) / 2; y: State.large-screen ? 148px : 118px; width: (parent.width - 8px) / 2; text: label; enabled: false; }
        ToggleRow { x: 0px; y: State.large-screen ? 210px : 174px; width: parent.width; text: Strings.cover-alone; value: State.cover-alone; toggled => { Commands.action("settings", "set", "cover-alone=" + (State.cover-alone ? "false" : "true")); } }
    }

    if root.section == "auto-update": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        GroupLabel { x: 0px; y: State.large-screen ? 10px : 0px; width: parent.width - 110px; height: root.group-height; text: Strings.update-frequency; font-size: State.large-screen ? 14px : 12px; }
        Caption { x: parent.width - 110px; y: State.large-screen ? 10px : 0px; width: 110px; height: root.group-height; text: Strings.unavailable; horizontal-alignment: right; }
        for label[index] in [Strings.off, Strings.daily, Strings.weekly]: SettingsChoice { x: index * (parent.width + 8px) / 3; y: State.large-screen ? 43px : 28px; width: (parent.width - 16px) / 3; text: label; enabled: false; }
        ToggleRow { x: 0px; y: State.large-screen ? 105px : 84px; width: parent.width; text: Strings.wifi-only; value: false; enabled: false; }
        ToggleRow { x: 0px; y: (State.large-screen ? 105px : 84px) + root.row-height; width: parent.width; text: Strings.charging-only; value: false; enabled: false; }
        ToggleRow { x: 0px; y: (State.large-screen ? 105px : 84px) + root.row-height * 2; width: parent.width; text: Strings.skip-completed; value: false; enabled: false; }
    }

    if root.section == "downloads": DownloadSettings { x: 0px; y: 0px; width: root.width; height: root.height; }

    if root.section == "storage": StorageSettings { x: 0px; y: 0px; width: root.width; height: root.height; }

    if root.section == "categories": CategoriesSettings { x: 0px; y: 0px; width: root.width; height: root.height; }

    if root.section == "source-lists": SourceListsSettings { x: 0px; y: 0px; width: root.width; height: root.height; }

    if root.section == "tracking": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        AccountCard { x: 0px; y: 0px; width: parent.width; service: "AniList"; initial: "AL"; }
        AccountCard { x: 0px; y: State.large-screen ? 96px : 86px; width: parent.width; service: "MyAnimeList"; initial: "MAL"; }
        ToggleRow { x: 0px; y: State.large-screen ? 192px : 172px; width: parent.width; text: Strings.auto-sync-chapter; value: false; enabled: false; }
        ToggleRow { x: 0px; y: (State.large-screen ? 192px : 172px) + root.row-height; width: parent.width; text: Strings.queue-offline-tracking; value: false; enabled: false; }
    }

    if root.section == "backup" || root.section == "logs" || root.section == "about": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        property <length> list-top: root.section == "backup" ? (State.large-screen ? 108px : 98px) : root.section == "logs" ? root.row-height + (State.large-screen ? 116px : 110px) : 0px;
        if root.section == "backup": HorizontalLayout {
            x: 0px; y: 0px; width: parent.width; height: State.large-screen ? 54px : 48px; spacing: 12px; alignment: start;
            ActionButton { text: Strings.backup-now; horizontal-padding: 24px; primary: true; enabled: false; }
            ActionButton { text: Strings.restore-backup; horizontal-padding: 24px; enabled: false; }
        }
        if root.section == "backup": GroupLabel { x: 0px; y: State.large-screen ? 76px : 68px; width: parent.width; height: root.group-height; text: Strings.recent-backups; font-size: State.large-screen ? 14px : 12px; }
        if root.section == "logs": ToggleRow { x: 0px; y: 0px; width: parent.width; text: Strings.write-logs; value: false; enabled: false; }
        if root.section == "logs": Rectangle {
            x: 0px; y: root.row-height + 12px; width: parent.width; height: State.large-screen ? 54px : 48px;
            ActionButton { x: 0px; y: 0px; width: 118px; height: parent.height; text: Strings.export-logs; enabled: false; }
            ActionButton { x: 130px; y: 0px; width: 118px; height: parent.height; text: Strings.clear-logs; enabled: false; }
        }
        if root.section == "logs": Caption {
            x: 0px;
            y: root.row-height + (State.large-screen ? 78px : 72px);
            width: parent.width;
            height: 26px;
            text: (State.settings-status == "" ? Strings.unavailable : State.settings-status) + " · " + Strings.logs-unavailable-detail;
            font-size: State.large-screen ? 15px : 13px;
        }
        if State.settings-details.length > 0: Rectangle { x: 0px; y: parent.list-top; width: parent.width; height: 1px; background: Theme.line; }
        for item[index] in State.settings-details: SettingsValueRow {
            x: 0px;
            y: parent.list-top + index * root.row-height;
            width: parent.width;
            text: item.title;
            value: root.section == "source-lists" ? "" : item.value;
            detail: root.section == "source-lists" ? item.value : "";
            action: item.enabled ? item.id == "license" ? Strings.view : root.section == "source-lists" ? Strings.remove : Strings.configure : "";
            enabled: item.enabled;
            clicked => { Commands.action("settings", "detail", item.id); }
        }
        if State.settings-details.length == 0 && root.section != "logs": Caption { x: 0px; y: parent.list-top; width: parent.width; height: 32px; text: State.settings-status == "" ? "—" : State.settings-status; }
    }

    if root.section == "language": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
        for label[index] in [Strings.chinese, Strings.traditional-chinese, "English", Strings.japanese]: Rectangle {
            x: 0px;
            y: index * root.row-height;
            width: parent.width; height: root.row-height;
            accessible-role: radio-button; accessible-label: label; accessible-enabled: index == 0; accessible-checkable: true; accessible-checked: index == 0;
            BodyText { x: 0px; y: 0px; width: parent.width - 40px; height: parent.height; text: label; font-size: State.large-screen ? 17px : 16px; font-weight: index == 0 ? 700 : 400; color: index == 0 ? Theme.ink : Theme.disabled; }
            if index == 0: Icon { x: parent.width - 22px; y: (parent.height - 22px) / 2; width: 22px; height: 22px; kind: "check"; }
            Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
        }
    }
}

