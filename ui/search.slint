import { CompactPager } from "native-controls.slint";
import { State, Commands, BookItem, SearchGroup } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { BodyText, Caption, Icon, ActionButton, InlineAction, Cover, TitleText } from "widgets.slint";
import { IdentityTextFit } from "identity-text.slint";
import { DownChevron } from "sources.slint";
import { PanelHeader } from "panels-common.slint";

component ScopeChip inherits Rectangle {
    in property <string> text;
    in property <string> compact-text;
    in property <bool> selected;
    in property <bool> more: false;
    in property <bool> preserve-tail: false;
    in property <length> width-limit;
    callback clicked();
    property <length> frame-height: State.large-screen ? 46px : 40px;
    property <length> horizontal-padding: root.more && root.selected ? 8px : 14px;
    property <length> arrow-space: root.more ? 20px : 0px;
    min-width: Theme.touch;
    preferred-width: min(root.width-limit, max(Theme.touch, fit.preferred-width + root.horizontal-padding * 2 + root.arrow-space));
    height: Theme.touch;
    accessible-role: button;
    accessible-label: root.more && root.text != Strings.more ? Strings.search-scope-title + ": " + root.text : root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;
    Rectangle {
        x: 0px; y: (parent.height - self.height) / 2; width: parent.width; height: root.frame-height;
        border-width: Theme.control-border; border-color: Theme.ink; background: root.selected ? Theme.ink : Theme.paper;
    }
    fit := IdentityTextFit {
        x: 0px; y: 0px; full-text: root.text; compact-text: root.compact-text; available-width: label-box.width;
        font-family: Theme.sans; font-size: Theme.caption; font-weight: root.selected ? 700 : 500;
    }
    label-box := Rectangle {
        x: root.horizontal-padding; y: (parent.height - root.frame-height) / 2 + 2px;
        width: max(0px, parent.width - root.horizontal-padding * 2 - root.arrow-space); height: root.frame-height - 4px;
        clip: true;
        property <bool> overflowed: root.preserve-tail && label.preferred-width > self.width;
        label := BodyText {
            x: parent.overflowed ? parent.width - self.preferred-width : 0px; y: 0px;
            width: parent.overflowed ? self.preferred-width : parent.width; height: parent.height;
            text: fit.display-text; font-size: Theme.caption; font-weight: root.selected ? 700 : 500;
            color: root.selected ? Theme.paper : Theme.ink; horizontal-alignment: center;
        }
        if label-box.overflowed: Rectangle {
            x: 0px; y: 0px; width: ellipsis.preferred-width + 2px; height: parent.height;
            background: root.selected ? Theme.ink : Theme.paper;
            ellipsis := BodyText { x: 0px; y: 0px; height: parent.height; text: "…"; font-size: Theme.caption; color: root.selected ? Theme.paper : Theme.ink; }
        }
    }
    if root.more: DownChevron {
        x: parent.width - root.horizontal-padding - self.width; y: (parent.height - self.height) / 2; width: 16px; height: 16px;
        color: root.selected ? Theme.paper : Theme.ink;
    }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { root.clicked(); } }
}

component SearchBookRow inherits Rectangle {
    in property <BookItem> book;
    in property <bool> local-match: false;
    property <length> cover-width: root.local-match ? (State.large-screen ? 52px : 44px) : (State.large-screen ? 72px : 62px);
    property <length> cover-height: root.local-match ? (State.large-screen ? 70px : 60px) : (State.large-screen ? 98px : 84px);
    property <length> label-x: root.cover-width + (root.local-match ? 14px : State.large-screen ? 20px : 16px);
    property <length> title-height: State.large-screen ? 30px : 26px;
    property <length> caption-height: State.large-screen ? 24px : 22px;
    property <length> line-gap: root.local-match ? 2px : 4px;
    property <bool> show-library: !root.local-match && root.book.in-library;
    property <length> label-height: root.title-height + root.caption-height + root.line-gap + (root.show-library ? root.caption-height + root.line-gap : 0px);
    height: root.local-match ? (State.large-screen ? 88px : 76px) : (State.large-screen ? 112px : 98px);
    accessible-role: button;
    accessible-label: root.book.title;
    Cover {
        x: 0px; y: (parent.height - self.height) / 2; width: root.cover-width; height: root.cover-height;
        book: root.book; border-color: Theme.ink; border-radius: Theme.control-radius; accessible-role: none;
    }
    TitleText {
        x: root.label-x; y: (parent.height - root.label-height) / 2; width: max(0px, parent.width - self.x - 28px); height: root.title-height;
        text: root.book.title; font-size: State.large-screen ? 22px : 19px; font-weight: 700;
    }
    Caption {
        x: root.label-x; y: (parent.height - root.label-height) / 2 + root.title-height + root.line-gap;
        width: max(0px, parent.width - self.x - 28px); height: root.caption-height; text: root.book.subtitle;
    }
    if root.show-library: Rectangle {
        x: root.label-x; y: (parent.height + root.label-height) / 2 - root.caption-height;
        width: max(0px, parent.width - self.x - 28px); height: root.caption-height;
        Icon { x: 0px; y: (parent.height - self.height) / 2; width: 14px; height: 14px; kind: "bookmark-filled"; }
        BodyText { x: 18px; y: 0px; width: parent.width - 18px; height: parent.height; text: Strings.in-library; font-size: Theme.caption; }
    }
    Icon { x: parent.width - self.width; y: (parent.height - self.height) / 2; width: 20px; height: 20px; kind: "chevron-right"; }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { Commands.action("search", "open", root.book.id); } }
}

component SearchGroupView inherits Rectangle {
    in property <SearchGroup> group;
    property <bool> has-books: root.group.books.length > 0;
    property <bool> retryable: root.group.error && !root.group.pending;
    property <length> heading-height: root.has-books ? (State.large-screen ? 52px : 44px) : (State.large-screen ? 60px : 52px);
    property <length> row-height: State.large-screen ? 112px : 98px;
    property <length> extent: root.heading-height + (root.has-books ? root.group.books.length * root.row-height + 16px : 0px);
    min-height: root.extent; preferred-height: root.extent; max-height: root.extent;
    BodyText {
        x: 0px; y: 0px; width: parent.width - (root.has-books ? view-all.width + 12px : max(0px, parent.width - status.x) + 12px); height: root.heading-height;
        text: root.group.title; font-size: State.large-screen ? 20px : 18px; font-weight: 700;
    }
    view-all := Rectangle {
        visible: root.has-books && (root.group.count > root.group.books.length || root.group.has-more);
        x: parent.width - self.width; y: (root.heading-height - self.height) / 2;
        width: text-label.preferred-width + 22px; height: Theme.touch;
        accessible-role: button; accessible-label: text-label.text;
        text-label := BodyText {
            x: 0px; y: 0px; width: self.preferred-width; height: parent.height;
            text: Strings.view-all + " " + root.group.count + (root.group.has-more ? "+" : "");
            font-size: Theme.caption; font-weight: 700;
        }
        Icon { x: parent.width - self.width; y: (parent.height - self.height) / 2; width: 18px; height: 18px; kind: "chevron-right"; }
        TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { Commands.action("search", "all", root.group.id); } }
    }
    status := Caption {
        visible: !root.has-books;
        x: parent.width - self.width - (root.retryable ? retry.width + 12px : 0px); y: 0px;
        width: min(parent.width * 0.55, self.preferred-width); height: root.heading-height;
        text: root.group.status; horizontal-alignment: right;
    }
    retry := InlineAction {
        visible: root.retryable; x: parent.width - self.width; y: (root.heading-height - self.height) / 2;
        text: Strings.retry; clicked => { Commands.action("search", "retry", root.group.id); }
    }
    for book[index] in root.group.books: SearchBookRow {
        x: 0px; y: root.heading-height + index * root.row-height; width: parent.width; book: book;
    }
}

export component SearchPage inherits Rectangle {
    property <bool> typing: (State.modal == "keyboard" && State.keyboard-target == "search") || (State.modal == "choices" && State.modal-context == "search-scope:typing");
    property <int> shortcut-count: State.large-screen ? 3 : 2;
    property <bool> more-selected: State.search-scope != "" && State.search-scope != "all" &&
        (!State.large-screen || State.search-scope != "library") &&
        !(State.search-sources.length > 0 && State.search-scope == State.search-sources[0].id) &&
        !(State.search-sources.length > 1 && State.search-scope == State.search-sources[1].id) &&
        !(State.large-screen && State.search-sources.length > 2 && State.search-scope == State.search-sources[2].id);
    property <string> visible-query: root.typing ? State.keyboard-text : State.query;
    property <bool> has-composition: root.typing && State.keyboard-composition != "";
    property <bool> has-query: root.visible-query != "" || root.has-composition;
    property <length> field-row-height: State.large-screen ? 80px : 64px;
    property <length> scope-height: State.large-screen ? 66px : 56px;
    property <length> content-top: root.field-row-height + root.scope-height;
    property <length> summary-height: State.page-count > 1 ? Theme.touch : State.large-screen ? 52px : 40px;
    property <length> keyboard-height: State.large-screen ? 370px : 300px;
    property <bool> searching: State.search-pending;
    property <bool> empty: !root.typing && (State.query == "" || (!State.search-has-results && !State.search-pending));
    background: Theme.paper;
    clip: true;
    Rectangle {
        x: Theme.margin; y: (root.field-row-height - self.height) / 2;
        width: max(0px, cancel.x - self.x - 10px); height: State.large-screen ? 60px : 52px;
        border-width: root.typing ? Theme.popup-border : Theme.control-border; border-color: Theme.ink; background: Theme.paper;
        accessible-role: button; accessible-label: Strings.search-hint;
        TouchArea {
            x: 0px; y: 0px; width: parent.width - (root.has-query ? Theme.touch : 0px); height: parent.height;
            clicked => { Commands.action("search", "edit", ""); }
        }
        search-icon := Icon {
            x: 14px; y: (parent.height - self.height) / 2; width: State.large-screen ? 26px : 22px; height: self.width; kind: "search";
        }
        query := BodyText {
            x: search-icon.x + search-icon.width + 10px; y: 0px; height: parent.height;
            width: min(self.preferred-width, max(0px, parent.width - self.x - (root.has-query ? Theme.touch + 4px : 12px) - (root.typing ? 6px : 0px) - (root.has-composition ? composition.width + 4px : 0px)));
            text: root.has-query || root.typing ? root.visible-query : Strings.search-hint;
            font-family: Theme.serif; font-size: State.large-screen ? 24px : 19px; font-weight: 700;
            color: root.has-query ? Theme.ink : Theme.secondary;
        }
        composition := BodyText {
            visible: root.has-composition;
            x: query.x + query.width + (query.width > 0px ? 4px : 0px); y: 0px;
            width: min(parent.width / 3, self.preferred-width); height: parent.height;
            text: State.keyboard-composition; font-family: Theme.numbers; font-size: State.large-screen ? 24px : 19px;
        }
        if root.has-composition: Rectangle { x: composition.x; y: parent.height / 2 + (State.large-screen ? 17px : 14px); width: composition.width; height: 1px; background: Theme.ink; }
        if root.typing: Rectangle {
            x: root.has-composition ? composition.x + composition.width + 4px : query.x + query.width + 2px;
            y: (parent.height - self.height) / 2; width: 2px; height: State.large-screen ? 28px : 24px; background: Theme.ink;
        }
        if root.has-query: Rectangle {
            x: parent.width - self.width; y: 0px; width: Theme.touch; height: parent.height;
            accessible-role: button; accessible-label: Strings.clear;
            Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: State.large-screen ? 24px : 22px; height: self.width; kind: "close"; }
            TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { Commands.action("search", "clear", ""); } }
        }
    }
    cancel := Rectangle {
        x: parent.width - (State.large-screen ? 30px : 16px) - self.width; y: (root.field-row-height - self.height) / 2;
        width: max(Theme.touch, cancel-label.preferred-width + 12px); height: Theme.touch;
        accessible-role: button; accessible-label: Strings.cancel;
        cancel-label := BodyText { x: 0px; y: 0px; width: parent.width; height: parent.height; text: Strings.cancel; font-weight: 700; horizontal-alignment: center; }
        TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { Commands.action(root.typing ? "keyboard" : "search", "cancel", ""); } }
    }
    HorizontalLayout {
        x: Theme.margin; y: root.field-row-height; width: parent.width - Theme.margin * 2; height: root.scope-height;
        alignment: start; spacing: 8px;
        ScopeChip { text: Strings.all-sources + " · " + State.search-source-count; width-limit: State.large-screen ? 174px : 155px; selected: State.search-scope == "" || State.search-scope == "all"; clicked => { Commands.action("search", "source", "all"); } }
        if State.large-screen: ScopeChip { text: Strings.library; width-limit: 80px; selected: State.search-scope == "library"; clicked => { Commands.action("search", "source", "library"); } }
        for index in min(root.shortcut-count, State.search-sources.length): ScopeChip {
            text: State.search-sources[index].name; compact-text: State.search-sources[index].display-name;
            width-limit: State.large-screen ? 148px : 138px; preserve-tail: !State.large-screen;
            selected: State.search-scope == State.search-sources[index].id;
            clicked => { Commands.action("search", "source", State.search-sources[index].id); }
        }
        if !State.large-screen || State.search-sources.length > root.shortcut-count || root.more-selected: ScopeChip {
            text: root.more-selected ? State.search-scope-name : Strings.more;
            width-limit: State.large-screen ? 110px : 107px; more: true;
            preserve-tail: root.more-selected; selected: root.more-selected;
            clicked => { Commands.action("search", "source-picker", ""); }
        }
    }
    Rectangle { x: 0px; y: root.content-top - 1px; width: parent.width; height: 1px; background: Theme.line; }
    if root.typing: Rectangle {
        x: Theme.margin; y: root.content-top; width: parent.width - Theme.margin * 2;
        height: max(0px, parent.height - self.y - root.keyboard-height); clip: true;
        property <length> heading-height: State.large-screen ? 52px : 40px;
        Caption {
            x: 0px; y: 0px; width: parent.width; height: parent.heading-height - 6px;
            text: Strings.library-matches; font-weight: 700; letter-spacing: 1px; vertical-alignment: bottom;
        }
        for book[index] in State.search-local-matches: SearchBookRow {
            x: 0px; y: parent.heading-height + index * self.height; width: parent.width; book: book; local-match: true;
        }
        if State.search-local-matches.length == 0: Caption {
            x: 0px; y: parent.heading-height; width: parent.width; height: State.large-screen ? 88px : 76px;
            text: Strings.no-library-match; font-size: Theme.body;
        }
    }
    if !root.typing && !root.searching && State.query != "" && (State.search-has-results || State.search-has-errors): Rectangle {
        x: Theme.margin; y: root.content-top; width: parent.width - Theme.margin * 2;
        height: max(0px, parent.height - self.y - (root.empty ? Theme.touch * 2 + 18px : 0px)); clip: true;
        Caption {
            x: 0px; y: 0px; width: parent.width - (State.page-count > 1 ? pager.width + 12px : 0px); height: root.summary-height;
            text: State.search-status;
        }
        pager := CompactPager {
            x: parent.width - self.width; y: (root.summary-height - self.height) / 2; page: State.page; count: State.page-count;
            turn(delta) => { Commands.action("page", "turn", delta); }
        }
        VerticalLayout {
            x: 0px; y: root.summary-height; width: parent.width; height: max(0px, parent.height - self.y);
            alignment: start;
            for group in State.search-groups: SearchGroupView { group: group; }
        }
    }
    if !root.typing && (root.searching || root.empty): Rectangle {
        x: Theme.margin;
        y: root.empty && State.search-has-errors && State.query != "" ? parent.height - self.height - 8px : (State.large-screen ? 404px : 272px);
        width: parent.width - Theme.margin * 2; height: (State.query == "" ? 0px : Theme.touch) + 10px + (root.searching ? 0px : Theme.touch);
        if State.query != "": TitleText {
            x: 0px; y: 0px; width: parent.width; height: Theme.touch;
            text: root.searching ? Strings.searching : Strings.no-results;
            font-size: State.large-screen ? 28px : 22px; font-weight: 700; horizontal-alignment: center;
        }
        if !root.searching: ActionButton {
            x: (parent.width - self.width) / 2; y: (State.query == "" ? 0px : Theme.touch) + 10px; width: self.preferred-width;
            text: State.query == "" ? Strings.search : Strings.retry; primary: true; horizontal-padding: 36px;
            clicked => { Commands.action("search", State.query == "" ? "edit" : "query", State.query); }
        }
    }
}

export component SearchScopePanel inherits Rectangle {
    property <length> pad: State.large-screen ? 28px : 22px;
    property <length> pad-top: State.large-screen ? 26px : 20px;
    property <length> row-height: State.large-screen ? 62px : 56px;
    property <length> list-top: root.pad-top + (State.large-screen ? 50px : 44px) + 8px;
    property <length> pager-height: State.panel-page-count > 1 ? Theme.touch : 0px;
    height: root.list-top + State.modal-items.length * root.row-height + root.pager-height + (State.large-screen ? 28px : 24px);
    background: Theme.paper;
    border-width: State.large-screen ? Theme.popup-border : 0px;
    border-color: Theme.ink;
    if !State.large-screen: Rectangle { x: 0px; y: 0px; width: parent.width; height: Theme.popup-border; background: Theme.ink; }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    PanelHeader {
        x: root.pad; y: root.pad-top; width: parent.width - root.pad * 2;
        text: Strings.search-scope-title; action-text: Strings.keyboard-done;
        closed => { Commands.action("panel", "close", ""); }
    }
    for item[index] in State.modal-items: Rectangle {
        x: root.pad; y: root.list-top + index * root.row-height; width: parent.width - root.pad * 2; height: root.row-height;
        property <bool> selected: item.value == "✓";
        accessible-role: radio-button; accessible-label: item.title;
        accessible-checkable: true; accessible-checked: self.selected;
        BodyText { x: 0px; y: 0px; width: parent.width - 34px; height: parent.height; text: item.title; font-weight: parent.selected ? 700 : 400; }
        if item.value == "✓": Icon { x: parent.width - 22px; y: (parent.height - 22px) / 2; width: 22px; height: 22px; kind: "check"; }
        TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { Commands.action("panel", "choose", item.id); } }
    }
    if State.panel-page-count > 1: CompactPager {
        x: parent.width - root.pad - self.width; y: root.list-top + State.modal-items.length * root.row-height;
        page: State.panel-page; count: State.panel-page-count;
        turn(delta) => { Commands.action("panel", "page", delta); }
    }
}
