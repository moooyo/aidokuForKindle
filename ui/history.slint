import { State, Commands, HistoryItem } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { BodyText, Caption, TitleText, Icon, IconButton, ActionButton, PageBar } from "widgets.slint";

component HistoryTab inherits Rectangle {
    in property <string> text;
    in property <int> count;
    in property <bool> selected;
    callback picked();
    preferred-width: label.preferred-width + 4px + (State.large-screen ? 8px : 6px) + (root.count > 0 ? count-label.preferred-width : 0px);
    height: State.large-screen ? 64px : 48px;
    background: touch.pressed ? Theme.ink : Theme.paper;
    accessible-role: tab;
    accessible-label: root.text + (root.count > 0 ? " " + root.count : "");
    accessible-checkable: true;
    accessible-checked: root.selected;
    label := BodyText {
        x: 2px; width: self.preferred-width; height: parent.height;
        text: root.text; font-size: State.large-screen ? 20px : 17px;
        font-weight: root.selected ? 700 : 500;
        color: touch.pressed ? Theme.paper : root.selected ? Theme.ink : Theme.secondary;
    }
    count-label := Text {
        x: label.x + label.width + (State.large-screen ? 8px : 6px);
        width: root.count > 0 ? self.preferred-width : 0px; height: parent.height;
        text: root.count > 0 ? "" + root.count : "";
        font-family: Theme.numbers; font-size: State.large-screen ? 15px : 13px;
        font-weight: 600; vertical-alignment: center;
        color: touch.pressed ? Theme.paper : root.selected ? Theme.ink : Theme.secondary;
    }
    if root.selected: Rectangle {
        x: 0px; y: parent.height - self.height;
        width: parent.width; height: State.large-screen ? 4px : 3px;
        border-radius: State.large-screen ? 2px : 0px;
        background: touch.pressed ? Theme.paper : Theme.ink;
    }
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { Commands.refresh("fast"); }
            else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { Commands.refresh("ui"); }
        }
        clicked => { root.picked(); }
    }
}

component HistoryDownload inherits Rectangle {
    in property <HistoryItem> entry;
    property <bool> completed: root.entry.download-state == "completed" || root.entry.download-state == "done";
    property <bool> active: root.entry.download-state == "downloading" || root.entry.download-state == "active";
    property <bool> queued: root.entry.download-state == "queued" || root.entry.download-state == "paused";
    property <bool> available: !root.completed && !root.active && !root.queued && root.entry.download-state != "failed";
    property <length> state-size: State.large-screen ? 38px : 32px;
    background: touch.pressed ? Theme.ink : Theme.paper;
    border-radius: Theme.control-radius;
    accessible-role: button;
    accessible-label: (root.completed ? Strings.remove-download : root.active || root.queued ? Strings.cancel-download : root.entry.download-state == "failed" ? Strings.retry : Strings.download) + " " + root.entry.title;
    Rectangle {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: root.state-size; height: self.width;
        background: root.completed != touch.pressed ? Theme.ink : Theme.paper;
        border-width: root.queued ? 0px : Theme.control-border;
        border-color: touch.pressed ? Theme.paper : root.completed || root.active ? Theme.ink : Theme.disabled;
        border-radius: Theme.control-radius; clip: true;
        if root.queued: Rectangle {
            width: parent.width; height: parent.height; background: transparent;
            for step in ceil(root.state-size / 6px): Rectangle {
                x: step * 6px; y: 0px; width: 4px; height: 1.5px;
                background: touch.pressed ? Theme.paper : Theme.ink;
            }
            for step in ceil(root.state-size / 6px): Rectangle {
                x: step * 6px; y: parent.height - 1.5px; width: 4px; height: 1.5px;
                background: touch.pressed ? Theme.paper : Theme.ink;
            }
            for step in ceil(root.state-size / 6px): Rectangle {
                x: 0px; y: step * 6px; width: 1.5px; height: 4px;
                background: touch.pressed ? Theme.paper : Theme.ink;
            }
            for step in ceil(root.state-size / 6px): Rectangle {
                x: parent.width - 1.5px; y: step * 6px; width: 1.5px; height: 4px;
                background: touch.pressed ? Theme.paper : Theme.ink;
            }
        }
        if !root.active && !root.available: Icon {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: State.large-screen ? 18px : 15px; height: self.width;
            kind: root.completed ? "check" : root.queued ? "history" : root.entry.download-state == "failed" ? "warning" : "download";
            inverted: root.completed != touch.pressed;
        }
        if root.available: Path {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: State.large-screen ? 18px : 15px; height: self.width;
            viewbox-width: 24; viewbox-height: 24;
            fill: transparent; stroke: touch.pressed ? Theme.paper : Theme.ink;
            stroke-width: State.large-screen ? 2.6px : 2.8px;
            stroke-line-cap: round; stroke-line-join: round;
            accessible-role: none;
            commands: "M12 5v12M7 12l5 5 5-5";
        }
        if root.active: Rectangle {
            x: (parent.width - 9px) / 2; y: (parent.height - 9px) / 2 - 1px;
            width: 9px; height: 9px; background: touch.pressed ? Theme.paper : Theme.ink;
        }
        if root.active: Rectangle {
            x: 3px; y: parent.height - 5px;
            width: (parent.width - 6px) * clamp(root.entry.download-progress, 0, 1);
            height: 2px; background: touch.pressed ? Theme.paper : Theme.ink;
        }
    }
    touch := TouchArea {
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { Commands.refresh("fast"); }
            else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { Commands.refresh("ui"); }
        }
        clicked => { Commands.action("history", "download", root.entry.chapter-id); }
    }
}

component HistoryEntry inherits Rectangle {
    in property <HistoryItem> entry;
    property <length> cover-width: State.large-screen ? 74px : 48px;
    property <length> cover-height: State.large-screen ? 100px : 66px;
    property <length> text-left: root.cover-width + (State.large-screen ? 16px : 14px);
    property <length> action-width: Theme.touch;
    property <length> action-gap: State.large-screen ? 8px : 6px;
    property <bool> has-progress: State.history-filter == 0 && !root.entry.completed && root.entry.fraction > 0;
    property <string> metadata: State.history-filter == 0 ? root.entry.progress :
        root.entry.download-state == "completed" || root.entry.download-state == "done" ? Strings.downloaded :
        root.entry.download-state == "downloading" || root.entry.download-state == "active" ? Strings.downloading + " " + round(clamp(root.entry.download-progress, 0, 1) * 100) + "%" :
        root.entry.download-state == "queued" ? Strings.queued :
        root.entry.download-state == "paused" ? Strings.paused :
        root.entry.download-state == "failed" ? Strings.download-failed : root.entry.progress;
    property <length> text-top: (root.height - (State.large-screen ? 77px : 66.5px)) / 2;
    height: State.large-screen ? 124px : 76px;
    background: Theme.paper;
    open-area := Rectangle {
        x: 0px; y: 0px;
        width: parent.width - root.action-width - root.action-gap; height: parent.height;
        background: open-touch.pressed ? Theme.ink : Theme.paper;
        accessible-role: button;
        accessible-label: root.entry.title + " " + root.entry.subtitle + " " + root.metadata;
        Rectangle {
            x: 0px; y: (parent.height - root.cover-height) / 2;
            width: root.cover-width; height: root.cover-height;
            background: open-touch.pressed ? Theme.ink : Theme.paper;
            border-width: 1px; border-color: open-touch.pressed ? Theme.paper : Theme.secondary;
            border-radius: 2px; clip: true;
            if root.entry.cover.width == 0: TitleText {
                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                text: root.entry.title; font-size: State.large-screen ? 13px : 12px;
                color: open-touch.pressed ? Theme.paper : Theme.ink;
                wrap: word-wrap; horizontal-alignment: center;
            }
            Image {
                x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
                source: root.entry.cover; image-fit: cover; accessible-role: none;
            }
        }
        TitleText {
            x: root.text-left; y: root.text-top;
            width: max(0px, parent.width - self.x); height: State.large-screen ? 26px : 23px;
            text: root.entry.title; font-size: State.large-screen ? 19px : 17px;
            letter-spacing: 1px; color: open-touch.pressed ? Theme.paper : Theme.ink;
        }
        BodyText {
            x: root.text-left; y: root.text-top + (State.large-screen ? 30px : 25px);
            width: max(0px, parent.width - self.x); height: State.large-screen ? 22px : 20px;
            text: root.entry.subtitle; font-size: State.large-screen ? 16px : 14px;
            color: open-touch.pressed ? Theme.paper : Theme.ink;
        }
        if root.has-progress: Rectangle {
            x: root.text-left; y: root.text-top + (State.large-screen ? 64.5px : 53.25px);
            width: 90px; height: State.large-screen ? 4px : 3px;
            background: Theme.line;
            Rectangle {
                x: 0px; y: 0px;
                width: parent.width * clamp(root.entry.fraction, 0, 1); height: parent.height;
                background: open-touch.pressed ? Theme.paper : Theme.ink;
            }
        }
        Text {
            x: root.text-left + (root.has-progress ? 100px : 0px);
            y: root.text-top + (State.large-screen ? 56px : 47px);
            width: max(0px, parent.width - self.x); height: State.large-screen ? 21px : 19.5px;
            text: root.metadata; font-family: Theme.numbers;
            font-size: State.large-screen ? 14px : 13px; overflow: elide;
            vertical-alignment: center; color: open-touch.pressed ? Theme.paper : Theme.secondary;
        }
        open-touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down { Commands.refresh("fast"); }
                else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { Commands.refresh("ui"); }
            }
            clicked => { Commands.action("history", "open", root.entry.chapter-id); }
        }
    }
    Rectangle {
        x: State.large-screen ? 0px : root.text-left;
        y: parent.height - 1px; width: parent.width - self.x - (State.large-screen ? 0px : root.action-width + root.action-gap);
        height: 1px; background: Theme.line;
    }
    if State.history-filter == 0: Rectangle {
        x: parent.width - root.action-width; y: (parent.height - Theme.touch) / 2;
        width: root.action-width; height: Theme.touch;
        background: remove-touch.pressed ? Theme.ink : Theme.paper;
        border-radius: Theme.control-radius;
        accessible-role: button;
        accessible-label: Strings.delete + " " + root.entry.title;
        Icon {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: State.large-screen ? 18px : 16px; height: self.width;
            kind: "close"; secondary: !remove-touch.pressed; inverted: remove-touch.pressed;
        }
        remove-touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down { Commands.refresh("fast"); }
                else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { Commands.refresh("ui"); }
            }
            clicked => { Commands.action("history", "delete", root.entry.chapter-id); }
        }
    }
    if State.history-filter == 1: HistoryDownload {
        x: parent.width - root.action-width; y: (parent.height - Theme.touch) / 2;
        width: root.action-width; height: Theme.touch; entry: root.entry;
    }
}

export component HistoryPage inherits Rectangle {
    background: Theme.paper;
    property <length> header-height: State.large-screen ? 106.5px : 75.5px;
    property <length> tabs-height: State.large-screen ? 64px : 48px;
    property <length> group-height: State.large-screen ? 60px : 44px;
    property <length> row-height: State.large-screen ? 124px : 76px;
    property <length> content-top: root.header-height + root.tabs-height + 1px + (State.large-screen ? 6px : 0px);
    property <length> action-right: State.large-screen ? 24px : 10px;
    property <length> trailing-width: State.history-filter == 1 ? (State.large-screen ? 112px : 88px) : Theme.touch;
    property <length> incognito-width: State.large-screen ? 103px : 79px;
    property <length> header-bottom: State.large-screen ? 16px : 8px;
    property <length> header-action-height: State.large-screen ? 52px : 40px;
    property <length> header-gap: State.large-screen ? 10px : 6px;
    Caption {
        x: Theme.margin; y: State.large-screen ? 8px : 4px;
        width: parent.width - Theme.margin * 2; height: State.large-screen ? 22.5px : 19.5px;
        text: State.history-filter == 0 ? Strings.last-seven-days + " · " + Strings.chapters-read + " " + State.weekly-read-count + " " + Strings.chapters-unit : Strings.chapter-updates + " " + State.chapter-update-count + " " + Strings.chapters-unit;
        font-size: State.large-screen ? 15px : 13px; letter-spacing: State.large-screen ? 3px : 2px;
    }
    TitleText {
        x: Theme.margin; y: State.large-screen ? 34.5px : 25.5px;
        width: parent.width - self.x - root.action-right - root.trailing-width - root.incognito-width - root.header-gap - 12px;
        height: Theme.title-line; text: State.history-filter == 0 ? Strings.history : Strings.update;
        letter-spacing: Theme.title-tracking;
    }
    incognito-action := Rectangle {
        x: parent.width - root.action-right - root.trailing-width - root.header-gap - root.incognito-width;
        y: root.header-height - root.header-bottom - root.header-action-height - (Theme.touch - root.header-action-height) / 2;
        width: root.incognito-width; height: Theme.touch;
        property <bool> inverted: State.incognito != incognito-touch.pressed;
        accessible-role: button; accessible-label: Strings.incognito;
        accessible-checkable: true; accessible-checked: State.incognito;
        Rectangle {
            y: (parent.height - root.header-action-height) / 2;
            width: parent.width; height: root.header-action-height;
            background: incognito-action.inverted ? Theme.ink : Theme.paper;
            border-width: Theme.control-border; border-color: Theme.ink; border-radius: Theme.control-radius;
            Icon {
                x: State.large-screen ? 17.5px : 11.5px; y: (parent.height - self.height) / 2;
                width: State.large-screen ? 22px : 18px; height: self.width;
                kind: "eye-off"; inverted: incognito-action.inverted;
            }
            BodyText {
                x: State.large-screen ? 47.5px : 35.5px; width: parent.width - self.x - (State.large-screen ? 20px : 14px);
                height: parent.height; text: Strings.incognito; font-size: State.large-screen ? 17px : 14px;
                font-weight: 700; color: incognito-action.inverted ? Theme.paper : Theme.ink;
            }
        }
        incognito-touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down { Commands.refresh("fast"); }
                else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { Commands.refresh("ui"); }
            }
            clicked => { Commands.action("history", "incognito", ""); }
        }
    }
    if State.history-filter == 0: IconButton {
        x: parent.width - root.action-right - self.width;
        y: root.header-height - root.header-bottom - Theme.touch;
        icon: "trash"; label: Strings.clear-history; enabled: State.history.length > 0;
        clicked => { Commands.action("history", "clear", ""); }
    }
    if State.history-filter == 1: Rectangle {
        x: parent.width - root.action-right - root.trailing-width;
        y: root.header-height - root.header-bottom - root.header-action-height - (Theme.touch - root.header-action-height) / 2;
        width: root.trailing-width; height: Theme.touch;
        accessible-role: button; accessible-label: Strings.history-download-all;
        accessible-enabled: State.chapter-update-count > 0;
        Rectangle {
            y: (parent.height - root.header-action-height) / 2;
            width: parent.width; height: root.header-action-height;
            background: download-all-touch.pressed || State.chapter-update-count == 0 ? Theme.paper : Theme.ink;
            border-width: State.chapter-update-count == 0 ? Theme.control-border : 0px;
            border-color: Theme.dotted; border-radius: Theme.control-radius;
            BodyText {
                width: parent.width; height: parent.height; text: Strings.history-download-all;
                font-size: State.large-screen ? 17px : 14px; font-weight: 700;
                horizontal-alignment: center;
                color: State.chapter-update-count == 0 ? Theme.disabled : download-all-touch.pressed ? Theme.ink : Theme.paper;
            }
        }
        download-all-touch := TouchArea {
            enabled: State.chapter-update-count > 0;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down { Commands.refresh("fast"); }
                else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { Commands.refresh("ui"); }
            }
            clicked => { Commands.action("history", "download-all", ""); }
        }
    }
    Rectangle {
        y: root.header-height; width: parent.width; height: root.tabs-height + 1px;
        Rectangle { y: root.tabs-height; width: parent.width; height: 1px; background: Theme.line; }
        HorizontalLayout {
            x: Theme.margin; width: parent.width - Theme.margin * 2; height: root.tabs-height;
            spacing: State.large-screen ? 30px : 24px; alignment: start;
            HistoryTab {
                text: Strings.reading-history; selected: State.history-filter == 0;
                picked => { Commands.action("history", "filter", "0"); }
            }
            HistoryTab {
                text: Strings.chapter-updates; count: State.chapter-update-count;
                selected: State.history-filter == 1;
                picked => { Commands.action("history", "filter", "1"); }
            }
        }
    }
    Rectangle {
        x: Theme.margin; y: root.content-top;
        width: parent.width - self.x - (State.large-screen ? Theme.margin : 10px);
        height: max(0px, parent.height - self.y - Theme.pager-height); clip: true;
        property <length> column-width: State.large-screen ? (self.width - 32px) / 2 : self.width;
        for entry in State.history: Rectangle {
            visible: entry.group-start; y: entry.group-offset * 1px;
            width: parent.width; height: root.group-height; background: Theme.paper;
            date-label := TitleText {
                x: 0px; y: parent.height - (State.large-screen ? 8px + 27px : 6px + 22.5px);
                width: self.preferred-width; height: State.large-screen ? 27px : 22.5px;
                text: entry.date-label; font-size: State.large-screen ? 18px : 15px;
                letter-spacing: State.large-screen ? 3px : 2px;
            }
            Text {
                x: date-label.width + (State.large-screen ? 12px : 10px);
                y: parent.height - (State.large-screen ? 8px + 22.5px : 6px + 19.5px);
                width: max(0px, parent.width - self.x); height: State.large-screen ? 22.5px : 19.5px;
                text: entry.date-value; font-family: Theme.numbers; font-size: State.large-screen ? 15px : 13px;
                color: Theme.secondary; vertical-alignment: center; overflow: elide;
            }
        }
        for entry in State.history: HistoryEntry {
            x: State.large-screen ? entry.column * (parent.column-width + 32px) : 0px;
            y: entry.group-offset * 1px + root.group-height + entry.row-index * root.row-height;
            width: parent.column-width; entry: entry;
        }
        if State.history.length == 0: Rectangle {
            width: parent.width; height: parent.height;
            property <length> content-height: State.history-filter == 0 ? (State.large-screen ? 202px : 178px) : 150px;
            property <length> empty-top: max(0px, (self.height - self.content-height) / 2);
            Icon {
                x: (parent.width - self.width) / 2; y: parent.empty-top;
                width: State.large-screen ? 56px : 48px; height: self.width; kind: "history"; secondary: true;
            }
            TitleText {
                x: 0px; y: parent.empty-top + (State.large-screen ? 80px : 70px);
                width: parent.width; height: 42px; text: State.history-filter == 0 ? Strings.empty-history : Strings.no-updates;
                font-size: State.large-screen ? 26px : 20px; letter-spacing: State.large-screen ? 3px : 2px;
                horizontal-alignment: center;
            }
            if State.history-filter == 0: Rectangle {
                property <length> gap: State.large-screen ? 16px : 12px;
                x: (parent.width - self.width) / 2;
                y: parent.empty-top + (State.large-screen ? 146px : 130px);
                width: min(parent.width, max(library-action.preferred-width, browse-action.preferred-width) * 2 + self.gap);
                height: Theme.touch;
                library-action := ActionButton {
                    x: 0px; y: 0px; width: (parent.width - parent.gap) / 2; height: parent.height;
                    text: Strings.return-library; primary: true;
                    horizontal-padding: State.large-screen ? 24px : 20px;
                    clicked => { Commands.action("navigation", "open", "0"); }
                }
                browse-action := ActionButton {
                    x: parent.width - self.width; y: 0px; width: (parent.width - parent.gap) / 2; height: parent.height;
                    text: Strings.browse-sources;
                    horizontal-padding: State.large-screen ? 24px : 20px;
                    clicked => { Commands.action("navigation", "open", "1"); }
                }
            }
        }
    }
    PageBar {
        x: 0px; y: parent.height - self.height; width: parent.width;
        page: State.page; count: State.page-count;
        turn(direction) => { Commands.action("page", "turn", direction); }
    }
}
