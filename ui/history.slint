import { CompactPager } from "native-controls.slint";
import { State, Commands, HistoryItem } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { BodyText, Caption, TitleText, Icon, IconButton, ActionButton, ChapterDownloadButton } from "widgets.slint";

component HistoryTab inherits Rectangle {
    in property <string> text;
    in property <int> count;
    in property <bool> selected;
    callback picked();
    preferred-width: label.preferred-width + 4px + (root.count > 0 ? count-label.preferred-width + 6px : 0px);
    accessible-role: tab;
    accessible-label: root.text + (root.count > 0 ? " " + root.count : "");
    accessible-checkable: true;
    accessible-checked: root.selected;
    label := BodyText {
        x: 2px; y: 0px; width: max(0px, parent.width - 4px - (root.count > 0 ? count-label.width + 6px : 0px)); height: parent.height - 3px;
        text: root.text; font-size: State.large-screen ? 20px : 18px; font-weight: root.selected ? 700 : 400;
        color: root.selected ? Theme.ink : Theme.secondary;
    }
    count-label := Text {
        x: label.x + label.width + 6px; y: 0px; width: root.count > 0 ? self.preferred-width : 0px; height: label.height;
        text: root.count; font-family: Theme.numbers; font-size: State.large-screen ? 16px : 14px;
        color: Theme.secondary; vertical-alignment: center;
        visible: root.count > 0;
    }
    if root.selected: Rectangle { x: 0px; y: parent.height - 3px; width: parent.width; height: 3px; background: Theme.ink; }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { root.picked(); } }
}

component HistoryEntry inherits Rectangle {
    in property <HistoryItem> entry;
    property <length> cover-width: State.large-screen ? 74px : 52px;
    property <length> cover-height: State.large-screen ? 100px : 70px;
    property <length> text-left: root.cover-width + (State.large-screen ? 16px : 14px);
    property <length> text-top: (root.height - (State.large-screen ? 78px : 66px)) / 2;
    property <bool> has-progress: State.history-filter == 0 && !root.entry.completed && root.entry.fraction > 0;
    property <length> bar-width: State.large-screen ? 100px : 90px;
    property <string> metadata: root.entry.progress;
    height: State.large-screen ? 118px : 80px;
    Rectangle {
        x: 0px; y: 0px; width: parent.width - Theme.touch - 6px; height: parent.height;
        accessible-role: button;
        accessible-label: root.entry.title + " " + root.entry.subtitle + " " + root.metadata;
        Rectangle {
            x: 0px; y: (parent.height - self.height) / 2; width: root.cover-width; height: root.cover-height;
            border-width: 1px; border-color: Theme.ink; clip: true;
            if root.entry.cover.width == 0: TitleText {
                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                text: root.entry.title; font-size: State.large-screen ? 13px : 12px; wrap: word-wrap; horizontal-alignment: center;
            }
            Image { x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px; source: root.entry.cover; image-fit: cover; accessible-role: none; }
        }
        TitleText {
            x: root.text-left; y: root.text-top; width: max(0px, parent.width - self.x); height: State.large-screen ? 27px : 23px;
            text: root.entry.title; font-size: State.large-screen ? 20px : 17px; font-weight: 700;
        }
        Caption {
            x: root.text-left; y: root.text-top + (State.large-screen ? 30px : 24px);
            width: max(0px, parent.width - self.x); height: State.large-screen ? 22px : 20px;
            text: root.entry.subtitle; font-size: State.large-screen ? 16px : 14px;
        }
        if root.has-progress: Rectangle {
            x: root.text-left; y: root.text-top + (State.large-screen ? 64px : 55px);
            width: root.bar-width; height: 3px; background: Theme.line;
            Rectangle { x: 0px; y: 0px; width: parent.width * clamp(root.entry.fraction, 0, 1); height: parent.height; background: Theme.ink; }
        }
        Caption {
            x: root.text-left + (root.has-progress ? root.bar-width + 10px : 0px);
            y: root.text-top + (State.large-screen ? 55px : 46px); width: max(0px, parent.width - self.x); height: 21px;
            text: root.metadata; font-size: State.large-screen ? 14px : 13px;
        }
        TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { Commands.action("history", "open", root.entry.chapter-id); } }
    }
    if State.history-filter == 0: IconButton {
        x: parent.width - Theme.touch; y: (parent.height - self.height) / 2;
        icon: "close"; label: Strings.delete + " " + root.entry.title;
        clicked => { Commands.action("history", "delete", root.entry.chapter-id); }
    }
    if State.history-filter == 1: ChapterDownloadButton {
        x: parent.width - Theme.touch; y: (parent.height - self.height) / 2; width: Theme.touch;
        state: root.entry.download-state; progress: root.entry.download-progress;
        clicked => { Commands.action("history", "download", root.entry.chapter-id); }
    }
}

export component HistoryPage inherits Rectangle {
    background: Theme.paper;
    property <length> group-height: State.large-screen ? 56px : 40px;
    property <length> row-height: State.large-screen ? 118px : 80px;
    property <length> toolbar-inset: State.large-screen ? 28px : 14px;
    property <bool> reading: State.history-filter == 0;
    property <length> content-height: max(0px, root.height - Theme.toolbar-height);
    property <HistoryItem> last-entry: State.history.length > 0 ? State.history[State.history.length - 1] : { };
    property <length> used-height: root.last-entry.group-offset * 1px + root.group-height + root.last-entry.group-row-count * root.row-height;
    // The taller compact viewport can spread a full page without resizing its rows.
    property <length> row-spacing: !State.large-screen && State.page < State.page-count && State.history.length > 1
        ? max(0px, min(root.height - 724px, root.content-height - root.used-height - 28px)) / (State.history.length - 1)
        : 0px;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: Theme.toolbar-height;
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
        HorizontalLayout {
            x: Theme.margin; y: 0px; width: max(0px, (pager.visible ? pager.x : incognito.x) - self.x - 8px);
            height: parent.height; spacing: State.large-screen ? 28px : 16px; alignment: start;
            HistoryTab {
                width: min(self.preferred-width, parent.width / 2 - 8px);
                text: Strings.reading-history; selected: root.reading; picked => { Commands.action("history", "filter", "0"); }
            }
            HistoryTab {
                width: min(self.preferred-width, parent.width / 2 - 8px);
                text: Strings.chapter-updates; count: State.chapter-update-count; selected: !root.reading; picked => { Commands.action("history", "filter", "1"); }
            }
        }
        pager := CompactPager {
            x: incognito.x - self.width; y: (parent.height - self.height) / 2;
            page: State.page; count: State.page-count;
            turn(delta) => { Commands.action("page", "turn", delta); }
        }
        incognito := IconButton {
            x: top-action.x - self.width; y: (parent.height - self.height) / 2;
            icon: "eye-off"; label: Strings.incognito; text: State.incognito ? Strings.incognito : "";
            filled: State.incognito; checkable: true; checked: State.incognito;
            clicked => { Commands.action("history", "incognito", ""); }
        }
        top-action := IconButton {
            x: parent.width - root.toolbar-inset - self.width; y: (parent.height - self.height) / 2;
            icon: root.reading ? "trash" : "download";
            label: root.reading ? Strings.clear-history : Strings.history-download-all;
            enabled: State.history.length > 0;
            clicked => { Commands.action("history", root.reading ? "clear" : "download-all", ""); }
        }
    }
    Rectangle {
        x: Theme.margin; y: Theme.toolbar-height; width: parent.width - Theme.margin * 2;
        height: root.content-height; clip: true;
        property <length> column-width: State.large-screen ? (self.width - 32px) / 2 : self.width;
        for entry[index] in State.history: Rectangle {
            x: 0px; y: entry.group-offset * 1px + index * root.row-spacing; width: parent.width; height: root.group-height;
            visible: entry.group-start;
            date-label := TitleText {
                x: 0px; y: parent.height - self.height - 6px; width: self.preferred-width; height: State.large-screen ? 27px : 23px;
                text: entry.date-label; font-size: State.large-screen ? 18px : 16px; font-weight: 700; letter-spacing: 2px;
            }
            Caption {
                x: date-label.width + 10px; y: parent.height - self.height - 6px; width: max(0px, parent.width - self.x); height: State.large-screen ? 24px : 20px;
                text: entry.date-value; font-family: Theme.numbers; font-size: State.large-screen ? 16px : 14px;
            }
        }
        for entry[index] in State.history: HistoryEntry {
            x: entry.column * (parent.column-width + 32px);
            y: entry.group-offset * 1px + root.group-height + entry.row-index * root.row-height + index * root.row-spacing;
            width: parent.column-width; entry: entry;
        }
        if State.history.length == 0: Rectangle {
            x: 0px; y: (State.large-screen ? 400px : 250px) - Theme.status-height - Theme.toolbar-height;
            width: parent.width; height: 196px;
            Icon { x: (parent.width - self.width) / 2; y: 0px; width: State.large-screen ? 56px : 48px; height: self.width; kind: "history"; secondary: true; }
            TitleText {
                x: 0px; y: State.large-screen ? 70px : 62px; width: parent.width; height: 42px;
                text: root.reading ? Strings.empty-history : Strings.no-updates;
                font-size: State.large-screen ? 26px : 22px; font-weight: 700; letter-spacing: 2px; horizontal-alignment: center;
            }
            if root.reading: HorizontalLayout {
                x: (parent.width - self.width) / 2; y: State.large-screen ? 124px : 116px; width: min(parent.width, State.large-screen ? 420px : 360px); height: Theme.touch;
                spacing: 12px;
                ActionButton { horizontal-stretch: 1; text: Strings.return-library; primary: true; clicked => { Commands.action("navigation", "open", "0"); } }
                ActionButton { horizontal-stretch: 1; text: Strings.browse-sources; clicked => { Commands.action("navigation", "open", "1"); } }
            }
        }
    }
}
