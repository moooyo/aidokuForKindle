import { State, Commands } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { Icon, BodyText, Caption } from "widgets.slint";

component KeyboardKey inherits Rectangle {
    in property <string> text;
    in property <string> label: root.text;
    in property <string> symbol;
    in property <bool> function-key: false;
    in property <bool> selected: false;
    in property <bool> primary: false;
    in property <length> text-size: State.large-screen ? 24px : 20px;
    in property <color> text-color: Theme.ink;
    callback clicked();
    property <bool> inverted: root.selected || root.primary;
    background: root.inverted ? Theme.ink : root.function-key ? Theme.fill : Theme.paper;
    border-color: Theme.secondary;
    border-width: root.primary ? 0px : 1px;
    accessible-role: button;
    accessible-label: root.label;
    if root.symbol == "": BodyText {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        text: root.text; font-size: root.text-size;
        font-weight: root.primary || root.function-key ? 700 : 400;
        color: root.inverted ? Theme.paper : root.text-color; horizontal-alignment: center;
    }
    if root.symbol != "": Path {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: root.symbol == "backspace" ? 26px : 22px; height: 22px;
        viewbox-width: 24; viewbox-height: 24;
        fill: transparent; stroke: root.inverted ? Theme.paper : Theme.ink; stroke-width: 1.8px;
        stroke-line-cap: round; stroke-line-join: round;
        commands: root.symbol == "backspace" ? "M9 5h12v14H9l-7-7zM12 9l6 6M18 9l-6 6" : "M12 4 4 12h4.5v7h7v-7H20z";
    }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { root.clicked(); } }
}

component CandidateKey inherits Rectangle {
    in property <string> text;
    in property <length> available-width;
    callback clicked();
    width: min(root.available-width, max(30px, label.preferred-width + (State.large-screen ? 36px : 28px)));
    horizontal-stretch: 0;
    accessible-role: button;
    accessible-label: root.text;
    label := BodyText {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        text: root.text; font-size: State.large-screen ? 24px : 20px;
        font-weight: 500; horizontal-alignment: center;
    }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { root.clicked(); } }
}

export component KeyboardPanel inherits Rectangle {
    x: 0px; y: 0px;
    in property <bool> show-input: State.keyboard-target != "search" && State.keyboard-target != "source-query";
    out property <length> keyboard-height: State.large-screen ? 370px : 300px;
    property <length> input-height: root.show-input ? (State.large-screen ? 106px : 90px) : 0px;
    property <length> candidate-height: State.large-screen ? 60px : 50px;
    property <length> row-gap: State.large-screen ? 7px : 5px;
    property <length> side-pad: State.large-screen ? 12px : 6px;
    property <length> bottom-pad: State.large-screen ? 10px : 8px;
    property <length> row-height: (root.keyboard-height - Theme.popup-border - root.candidate-height - root.bottom-pad - root.row-gap * 4) / 4;
    property <length> first-top: root.input-height + Theme.popup-border + root.candidate-height + root.row-gap;
    property <length> key-width: (root.width - root.side-pad * 2 - root.row-gap * 9) / 10;
    property <length> third-unit: (root.width - root.side-pad * 2 - root.row-gap * 8) / 10;
    property <length> footer-unit: (root.width - root.side-pad * 2 - root.row-gap * 5) / 10.5;
    property <length> function-text-size: State.large-screen ? 19px : 16px;
    property <bool> capitals: false;
    property <bool> alternate-symbols: false;
    property <string> letter-mode: "pinyin";
    property <bool> numeric: State.keyboard-mode == "numbers";
    property <bool> english: State.keyboard-mode == "english" || (root.numeric && root.letter-mode == "english");
    height: root.keyboard-height + root.input-height;
    background: Theme.paper;
    clip: true;

    if root.show-input: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: root.input-height;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: Theme.popup-border; background: Theme.ink; }
        BodyText {
            x: State.large-screen ? 24px : 16px; y: 7px;
            width: parent.width - self.x * 2 - Theme.touch; height: State.large-screen ? 28px : 24px;
            text: State.modal-title; font-size: State.large-screen ? 17px : 15px; font-weight: 700;
        }
        Rectangle {
            x: State.large-screen ? 24px : 16px; y: State.large-screen ? 42px : 36px;
            width: parent.width - self.x * 2; height: State.large-screen ? 54px : 46px;
            background: Theme.paper; border-width: Theme.popup-border; border-color: Theme.ink;
            BodyText {
                x: 12px; y: 0px; width: parent.width - 24px; height: parent.height;
                text: State.keyboard-text + State.keyboard-composition;
                font-size: State.large-screen ? 22px : 19px;
            }
        }
        Rectangle {
            x: parent.width - (State.large-screen ? 24px : 16px) - Theme.touch; y: 0px;
            width: Theme.touch; height: State.large-screen ? 42px : 36px;
            accessible-role: button; accessible-label: Strings.cancel;
            Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 20px; height: 20px; kind: "close"; }
            TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { Commands.action("keyboard", "cancel", ""); } }
        }
    }

    Rectangle { x: 0px; y: root.input-height; width: parent.width; height: Theme.popup-border; background: Theme.ink; }
    candidate-bar := Rectangle {
        x: root.side-pad; y: root.input-height + Theme.popup-border;
        width: parent.width - root.side-pad * 2; height: root.candidate-height;
        property <length> page-controls: State.keyboard-candidate-page-count > 1 ? (State.large-screen ? 72px : 56px) : 0px;
        property <length> composition-width: State.keyboard-composition == "" ? 0px : min(parent.width * 0.28, composition-label.preferred-width + 24px);
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
        Rectangle {
            x: 0px; y: (parent.height - self.height) / 2; width: parent.composition-width; height: 36px;
            visible: State.keyboard-composition != "";
            border-width: Theme.control-border; border-color: Theme.ink;
            composition-label := BodyText {
                x: 12px; y: 0px; width: max(0px, parent.width - 24px); height: parent.height;
                text: State.keyboard-composition;
                font-family: Theme.numbers; font-size: Theme.caption;
            }
        }
        mode := Caption {
            x: parent.width - self.width - 6px; y: 0px; width: self.preferred-width; height: parent.height;
            text: root.numeric ? Strings.keyboard-ime-numbers : root.english ? Strings.keyboard-english : Strings.keyboard-pinyin;
        }
        HorizontalLayout {
            x: parent.composition-width > 0px ? parent.composition-width + 4px : 0px; y: 0px;
            width: max(0px, mode.x - self.x - parent.page-controls - 8px); height: parent.height - 1px;
            spacing: 4px; alignment: start;
            for candidate in State.keyboard-candidates: CandidateKey {
                height: parent.height;
                available-width: max(0px, (parent.width - max(0, State.keyboard-candidates.length - 1) * 4px) / max(1, State.keyboard-candidates.length));
                text: candidate; clicked => { Commands.action("keyboard", "candidate", candidate); }
            }
        }
        if candidate-bar.page-controls > 0px: Rectangle {
            x: mode.x - self.width - 8px; y: 0px; width: parent.page-controls; height: parent.height;
            for delta[index] in [-1, 1]: Rectangle {
                property <bool> can-turn: index == 0 ? State.keyboard-candidate-page > 1 : State.keyboard-candidate-page < State.keyboard-candidate-page-count;
                x: index * parent.width / 2; y: 0px; width: parent.width / 2; height: parent.height;
                accessible-role: button; accessible-label: index == 0 ? Strings.previous : Strings.next; accessible-enabled: self.can-turn;
                Icon {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    width: 18px; height: 18px; kind: index == 0 ? "chevron-left" : "chevron-right"; enabled: parent.can-turn;
                }
                TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: parent.can-turn; clicked => { Commands.action("keyboard", "candidate-page", delta); } }
            }
        }
    }

    for key[index] in root.numeric ? (root.alternate-symbols ? ["!", "@", "#", "$", "%", "^", "&", "*", "(", ")"] : ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]) : root.capitals && root.english ? ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"] : ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"]: KeyboardKey {
        x: root.side-pad + index * (root.key-width + root.row-gap); y: root.first-top;
        width: root.key-width; height: root.row-height; text: key;
        clicked => { Commands.action("keyboard", "key", key); }
    }
    for key[index] in root.numeric ? (root.alternate-symbols ? ["_", "+", "=", "[", "]", "{", "}", "\\", "|"] : ["-", "/", ":", "(", ")", "@", "·", "「", "」"]) : root.capitals && root.english ? ["A", "S", "D", "F", "G", "H", "J", "K", "L"] : ["a", "s", "d", "f", "g", "h", "j", "k", "l"]: KeyboardKey {
        x: root.side-pad + (index + 0.5) * (root.key-width + root.row-gap); y: root.first-top + root.row-height + root.row-gap;
        width: root.key-width; height: root.row-height; text: key;
        clicked => { Commands.action("keyboard", "key", key); }
    }
    Rectangle {
        x: root.side-pad; y: root.first-top + (root.row-height + root.row-gap) * 2;
        width: parent.width - root.side-pad * 2; height: root.row-height;
        KeyboardKey {
            x: 0px; y: 0px; width: root.third-unit * 1.5; height: root.row-height;
            symbol: root.numeric ? "" : "shift"; text: root.alternate-symbols ? "123" : "#+=";
            label: root.numeric ? Strings.keyboard-ime-numbers : Strings.keyboard-shift;
            function-key: true; text-size: root.function-text-size; selected: root.numeric ? root.alternate-symbols : root.capitals;
            clicked => { if root.numeric { root.alternate-symbols = !root.alternate-symbols; } else { root.capitals = !root.capitals; } }
        }
        for key[index] in root.numeric ? (root.alternate-symbols ? ["<", ">", "~", "`", ";", "_", "—"] : [".", ",", "?", "!", "'", "\"", "…"]) : root.capitals && root.english ? ["Z", "X", "C", "V", "B", "N", "M"] : ["z", "x", "c", "v", "b", "n", "m"]: KeyboardKey {
            x: root.third-unit * 1.5 + root.row-gap + index * (root.third-unit + root.row-gap);
            y: 0px; width: root.third-unit; height: root.row-height; text: key;
            clicked => { Commands.action("keyboard", "key", key); }
        }
        KeyboardKey {
            x: parent.width - self.width; y: 0px; width: root.third-unit * 1.5; height: root.row-height;
            symbol: "backspace"; label: Strings.keyboard-backspace; function-key: true;
            clicked => { Commands.action("keyboard", "backspace", ""); }
        }
    }
    Rectangle {
        x: root.side-pad; y: root.first-top + (root.row-height + root.row-gap) * 3;
        width: parent.width - root.side-pad * 2; height: root.row-height;
        number-key := KeyboardKey {
            x: 0px; y: 0px; width: root.footer-unit * 1.5; height: parent.height;
            text: root.numeric ? "abc" : "123"; label: Strings.keyboard-numbers;
            function-key: true; text-size: root.function-text-size;
            clicked => {
                root.capitals = false; root.alternate-symbols = false;
                if root.numeric { Commands.action("keyboard", "mode", root.letter-mode); }
                else { root.letter-mode = State.keyboard-mode; Commands.action("keyboard", "mode", "numbers"); }
            }
        }
        language-key := KeyboardKey {
            x: number-key.x + number-key.width + root.row-gap; y: 0px; width: root.footer-unit; height: parent.height;
            text: root.english ? "EN" : Strings.keyboard-language-chinese; label: Strings.keyboard-language;
            function-key: true; text-size: root.function-text-size;
            clicked => {
                root.capitals = false; root.letter-mode = root.english ? "pinyin" : "english";
                if !root.numeric { Commands.action("keyboard", "mode", root.letter-mode); }
            }
        }
        comma := KeyboardKey {
            x: language-key.x + language-key.width + root.row-gap; y: 0px; width: root.footer-unit; height: parent.height;
            text: State.keyboard-mode == "pinyin" ? "，" : ",";
            clicked => { Commands.action("keyboard", "key", self.text); }
        }
        space := KeyboardKey {
            x: comma.x + comma.width + root.row-gap; y: 0px; width: root.footer-unit * 4; height: parent.height;
            text: Strings.keyboard-space; text-size: root.function-text-size; text-color: Theme.secondary;
            clicked => { Commands.action("keyboard", "space", ""); }
        }
        period := KeyboardKey {
            x: space.x + space.width + root.row-gap; y: 0px; width: root.footer-unit; height: parent.height;
            text: State.keyboard-mode == "pinyin" ? "。" : ".";
            clicked => { Commands.action("keyboard", "key", self.text); }
        }
        KeyboardKey {
            x: period.x + period.width + root.row-gap; y: 0px; width: root.footer-unit * 2; height: parent.height;
            text: root.show-input ? Strings.keyboard-done : Strings.search; primary: true; text-size: root.function-text-size;
            clicked => { Commands.action("keyboard", "done", ""); }
        }
    }
}
