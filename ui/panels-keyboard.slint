import { State, Commands } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { Icon } from "widgets.slint";

component KeyboardKey inherits Rectangle {
    x: 0px;
    y: 0px;
    width: State.large-screen ? 80px : 54px;
    in property <string> text;
    in property <string> label: root.text;
    in property <string> symbol;
    in property <bool> strong: false;
    in property <bool> selected: false;
    in property <bool> primary: false;
    in property <bool> secondary: false;
    in property <bool> ui-font: false;
    in property <length> text-size: State.large-screen ? 24px : 20px;
    callback clicked();
    property <bool> inverted: (root.selected || root.primary) != key-touch.pressed;
    height: State.large-screen ? 62px : 52px;
    background: root.inverted ? Theme.ink : Theme.paper;
    border-color: root.strong || root.selected || root.primary ? Theme.ink : Theme.disabled;
    border-width: root.primary ? 0px : 1px;
    border-radius: Theme.control-radius;
    accessible-role: button;
    accessible-label: root.label;
    if root.symbol == "": Text {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        text: root.text;
        font-family: root.secondary || root.primary || root.ui-font ? Theme.sans : Theme.numbers;
        font-size: root.text-size;
        font-weight: root.primary || root.strong ? 700 : 600;
        color: root.inverted ? Theme.paper : root.secondary ? Theme.secondary : Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.symbol != "": Path {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: State.large-screen ? 26px : 24px;
        height: self.width;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.inverted ? Theme.paper : Theme.ink;
        stroke-width: root.symbol == "backspace" ? 2px : 1px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: root.symbol == "backspace" ? "M9 5h12v14H9l-7-7zM12 9l6 6M18 9l-6 6" : "M12 2l7 8h-4v12H9V10H5z";
    }
    key-touch := TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { Commands.refresh("fast"); }
            else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { Commands.refresh("ui"); }
        }
        clicked => { root.clicked(); }
    }
}

component CandidateKey inherits Rectangle {
    in property <string> text;
    in property <length> available-width;
    callback clicked();
    width: min(root.available-width, max(State.large-screen ? 64px : 46px, candidate-label.preferred-width + (State.large-screen ? 16px : 12px)));
    height: State.large-screen ? 56px : 46px;
    background: candidate-touch.pressed ? Theme.ink : Theme.paper;
    border-radius: Theme.control-radius;
    accessible-role: button;
    accessible-label: root.text;
    candidate-label := Text {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        text: root.text;
        font-family: Theme.serif;
        font-size: State.large-screen ? 28px : 22px;
        font-weight: 700;
        color: candidate-touch.pressed ? Theme.paper : Theme.ink;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    candidate-touch := TouchArea {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { Commands.refresh("fast"); }
            else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { Commands.refresh("ui"); }
        }
        clicked => { root.clicked(); }
    }
}

export component KeyboardPanel inherits Rectangle {
    x: 0px;
    y: 0px;
    in property <bool> show-input: State.keyboard-target != "search" && State.keyboard-target != "source-query";
    out property <length> keyboard-height: State.large-screen ? 370px : 300px;
    property <length> input-height: root.show-input ? (State.large-screen ? 106px : 90px) : 0px;
    property <length> candidate-height: State.large-screen ? 64px : 52px;
    property <length> row-height: State.large-screen ? 62px : 52px;
    property <length> row-gap: State.large-screen ? 10px : 7px;
    property <length> key-gap: State.large-screen ? 8px : 6px;
    property <length> key-width: (root.width - (State.large-screen ? 58px : 24px) - root.key-gap * 9) / 10;
    property <length> special-width: State.large-screen ? 110px : 72px;
    property <length> first-top: root.input-height + 2px + root.candidate-height + root.row-gap;
    property <length> third-width: root.key-width * 7 + root.special-width * 2 + root.key-gap * 8;
    property <length> number-third-width: root.key-width * 4 + (State.large-screen ? 120px : 84px) + root.key-gap * 4;
    property <bool> capitals: false;
    property <bool> alternate-symbols: false;
    property <string> letter-mode: "pinyin";
    property <bool> numeric: State.keyboard-mode == "numbers";
    property <bool> english: State.keyboard-mode == "english" || (root.numeric && root.letter-mode == "english");
    property <length> composition-width: State.keyboard-composition == "" ? 0px : min(State.large-screen ? 240px : 160px, composition-label.preferred-width + (State.large-screen ? 36px : 26px));
    property <length> candidate-actions-width: State.keyboard-candidates.length > 0 ? (State.large-screen ? 64px : 48px) : 0px;
    height: root.keyboard-height + root.input-height;
    background: Theme.paper;
    clip: true;

    if root.show-input: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: root.input-height;
        background: Theme.paper;
        Text {
            x: State.large-screen ? 24px : 16px; y: 7px;
            width: parent.width - self.x * 2 - Theme.touch; height: State.large-screen ? 28px : 24px;
            text: State.modal-title;
            font-family: Theme.sans; font-size: State.large-screen ? 17px : 15px;
            font-weight: 700; color: Theme.ink; vertical-alignment: center; overflow: elide;
        }
        Rectangle {
            x: State.large-screen ? 24px : 16px; y: State.large-screen ? 42px : 36px;
            width: parent.width - self.x * 2; height: State.large-screen ? 54px : 46px;
            background: Theme.paper; border-width: 1.5px; border-color: Theme.ink; border-radius: Theme.control-radius;
            Text {
                x: 12px; y: 0px; width: parent.width - 24px; height: parent.height;
                text: State.keyboard-text;
                font-family: Theme.sans; font-size: State.large-screen ? 22px : 19px;
                color: Theme.ink; vertical-alignment: center; overflow: elide;
            }
        }
        Rectangle {
            x: parent.width - (State.large-screen ? 24px : 16px) - Theme.touch; y: 0px;
            width: Theme.touch; height: State.large-screen ? 40px : 34px;
            background: cancel-touch.pressed ? Theme.ink : Theme.paper;
            border-radius: Theme.control-radius;
            accessible-role: button; accessible-label: Strings.cancel;
            Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 20px; height: 20px; kind: "close"; inverted: cancel-touch.pressed; }
            cancel-touch := TouchArea {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                clicked => { Commands.action("keyboard", "cancel", ""); }
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down { Commands.refresh("fast"); }
                    else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { Commands.refresh("ui"); }
                }
            }
        }
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
    }

    Rectangle { x: 0px; y: root.input-height; width: parent.width; height: 2px; background: Theme.ink; }
    Rectangle {
        x: 0px; y: root.input-height + 2px; width: parent.width; height: root.candidate-height;
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
        composition-label := Text {
            x: State.large-screen ? 30px : 14px; y: 0px;
            width: max(0px, root.composition-width - (State.large-screen ? 24px : 20px)); height: parent.height - 6px;
            text: State.keyboard-composition;
            font-family: Theme.numbers; font-size: State.large-screen ? 20px : 16px;
            font-weight: 600; color: Theme.ink; vertical-alignment: center; overflow: elide;
        }
        if State.keyboard-composition != "": Rectangle {
            x: State.large-screen ? 24px : 10px;
            y: parent.height - (State.large-screen ? 14px : 12px);
            width: root.composition-width - (State.large-screen ? 18px : 12px); height: 2px; background: Theme.ink;
        }
        if State.keyboard-composition == "" && State.keyboard-candidates.length == 0: Text {
            x: State.large-screen ? 32px : 18px; y: 0px; width: parent.width - self.x * 2; height: parent.height;
            text: root.numeric ? Strings.keyboard-ime-numbers : root.english ? Strings.keyboard-english : Strings.keyboard-pinyin;
            font-family: Theme.sans; font-size: State.large-screen ? 16px : 14px;
            color: Theme.secondary; vertical-alignment: center;
        }
        if root.numeric && State.keyboard-candidates.length == 0: KeyboardKey {
            x: parent.width - (State.large-screen ? 100px : 80px);
            y: (parent.height - self.height) / 2;
            width: State.large-screen ? 76px : 68px;
            height: State.large-screen ? 48px : 40px;
            text: root.alternate-symbols ? "123" : "#+=";
            label: Strings.keyboard-ime-numbers;
            text-size: State.large-screen ? 19px : 16px;
            strong: true;
            selected: root.alternate-symbols;
            clicked => { root.alternate-symbols = !root.alternate-symbols; }
        }
        HorizontalLayout {
            x: (State.large-screen ? 24px : 10px) + root.composition-width;
            y: (parent.height - (State.large-screen ? 56px : 46px)) / 2;
            width: parent.width - self.x - (State.large-screen ? 24px : 10px) - root.candidate-actions-width;
            height: State.large-screen ? 56px : 46px;
            spacing: State.large-screen ? 4px : 2px;
            alignment: start;
            for candidate[index] in State.keyboard-candidates: CandidateKey {
                visible: index < 8;
                available-width: max(0px, (parent.width - (min(State.keyboard-candidates.length, 8) - 1) * (State.large-screen ? 4px : 2px)) / max(1, min(State.keyboard-candidates.length, 8)));
                text: candidate;
                clicked => { Commands.action("keyboard", "candidate", candidate); }
            }
        }
        if State.keyboard-candidates.length > 0: Rectangle {
            x: parent.width - (State.large-screen ? 24px : 10px) - root.candidate-actions-width;
            y: 0px; width: root.candidate-actions-width; height: parent.height;
            for delta[index] in [-1, 1]: Rectangle {
                x: index * parent.width / 2; y: 0px; width: parent.width / 2; height: parent.height;
                background: candidate-page-touch.pressed ? Theme.ink : Theme.paper;
                border-radius: Theme.control-radius;
                accessible-role: button; accessible-label: index == 0 ? Strings.previous : Strings.next;
                Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: State.large-screen ? 20px : 16px; height: self.width; kind: index == 0 ? "chevron-left" : "chevron-right"; inverted: candidate-page-touch.pressed; }
                candidate-page-touch := TouchArea {
                    x: 0px; y: 0px; width: parent.width; height: parent.height;
                    clicked => { Commands.action("keyboard", "candidate-page", delta); }
                    pointer-event(event) => {
                        if event.kind == PointerEventKind.down { Commands.refresh("fast"); }
                        else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { Commands.refresh("ui"); }
                    }
                }
            }
        }
    }

    for key[index] in root.numeric ? (root.alternate-symbols ? ["!", "@", "#", "$", "%", "^", "&", "*", "(", ")"] : ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"]) : root.capitals && root.english ? ["Q", "W", "E", "R", "T", "Y", "U", "I", "O", "P"] : ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"]: KeyboardKey {
        x: (root.width - root.key-width * 10 - root.key-gap * 9) / 2 + index * (root.key-width + root.key-gap);
        y: root.first-top; width: root.key-width; height: root.row-height;
        text: key;
        clicked => { Commands.action("keyboard", "key", key); }
    }
    for key[index] in root.numeric ? (root.alternate-symbols ? ["_", "+", "=", "[", "]", "{", "}", "\\", "|"] : ["-", "/", ":", "(", ")", "@", "·", "「", "」"]) : root.capitals && root.english ? ["A", "S", "D", "F", "G", "H", "J", "K", "L"] : ["a", "s", "d", "f", "g", "h", "j", "k", "l"]: KeyboardKey {
        x: (root.width - root.key-width * 9 - root.key-gap * 8) / 2 + index * (root.key-width + root.key-gap);
        y: root.first-top + root.row-height + root.row-gap; width: root.key-width; height: root.row-height;
        text: key;
        ui-font: key == "「" || key == "」";
        clicked => { Commands.action("keyboard", "key", key); }
    }
    if !root.numeric: Rectangle {
        x: (root.width - root.third-width) / 2;
        y: root.first-top + (root.row-height + root.row-gap) * 2;
        width: root.third-width; height: root.row-height;
        KeyboardKey {
            x: 0px; y: 0px; width: root.special-width; height: root.row-height; symbol: "shift"; label: Strings.keyboard-shift;
            strong: true; selected: root.capitals;
            clicked => { root.capitals = !root.capitals; }
        }
        for key[index] in root.capitals && root.english ? ["Z", "X", "C", "V", "B", "N", "M"] : ["z", "x", "c", "v", "b", "n", "m"]: KeyboardKey {
            x: root.special-width + root.key-gap + index * (root.key-width + root.key-gap);
            y: 0px; width: root.key-width; height: root.row-height; text: key;
            clicked => { Commands.action("keyboard", "key", key); }
        }
        KeyboardKey {
            x: parent.width - root.special-width; y: 0px; width: root.special-width; height: root.row-height;
            symbol: "backspace"; label: Strings.keyboard-backspace; strong: true;
            clicked => { Commands.action("keyboard", "backspace", ""); }
        }
    }
    if root.numeric: Rectangle {
        x: (root.width - root.number-third-width) / 2;
        y: root.first-top + (root.row-height + root.row-gap) * 2;
        width: root.number-third-width; height: root.row-height;
        for key[index] in root.alternate-symbols ? ["<", ">", "\"", "'"] : root.english || root.show-input ? [",", ".", "?", "!"] : ["，", "。", "？", "！"]: KeyboardKey {
            x: index * (root.key-width + root.key-gap); y: 0px; width: root.key-width; height: root.row-height;
            text: key;
            clicked => { Commands.action("keyboard", "key", key); }
        }
        KeyboardKey {
            x: (root.key-width + root.key-gap) * 4; y: 0px; width: State.large-screen ? 120px : 84px; height: root.row-height;
            symbol: "backspace"; label: Strings.keyboard-backspace; strong: true;
            clicked => { Commands.action("keyboard", "backspace", ""); }
        }
    }
    Rectangle {
        x: State.large-screen ? 29px : 12px;
        y: root.first-top + (root.row-height + root.row-gap) * 3;
        width: parent.width - self.x * 2; height: root.row-height;
        KeyboardKey {
            x: 0px; y: 0px; width: State.large-screen ? 110px : 72px; height: root.row-height;
            text: root.numeric ? "abc" : "123";
            label: root.numeric ? Strings.keyboard-english : Strings.keyboard-numbers;
            strong: true; text-size: State.large-screen ? 19px : 16px;
            clicked => {
                root.capitals = false;
                root.alternate-symbols = false;
                if root.numeric { Commands.action("keyboard", "mode", root.letter-mode); }
                else { root.letter-mode = State.keyboard-mode; Commands.action("keyboard", "mode", "numbers"); }
            }
        }
        KeyboardKey {
            x: (State.large-screen ? 110px : 72px) + root.key-gap;
            y: 0px; width: State.large-screen ? 96px : 72px; height: root.row-height;
            text: root.english ? "EN" : Strings.keyboard-language-chinese;
            label: Strings.keyboard-language;
            ui-font: true;
            strong: true; text-size: State.large-screen ? 20px : 17px;
            clicked => {
                root.capitals = false;
                root.letter-mode = root.english ? "pinyin" : "english";
                if !root.numeric { Commands.action("keyboard", "mode", root.letter-mode); }
            }
        }
        KeyboardKey {
            x: (State.large-screen ? 206px : 144px) + root.key-gap * 2;
            y: 0px; width: parent.width - self.x - (State.large-screen ? 170px : 120px) - root.key-gap; height: root.row-height;
            text: Strings.keyboard-space; secondary: true;
            text-size: State.large-screen ? 17px : 15px;
            clicked => { Commands.action("keyboard", "space", ""); }
        }
        KeyboardKey {
            x: parent.width - (State.large-screen ? 170px : 120px);
            y: 0px; width: State.large-screen ? 170px : 120px; height: root.row-height;
            text: root.show-input ? Strings.keyboard-done : Strings.search;
            primary: true; text-size: State.large-screen ? 20px : 17px;
            clicked => { Commands.action("keyboard", "done", ""); }
        }
    }
}
