import { State } from "state.slint";
import { Theme } from "theme.slint";
import { ReadingOptions, LightOptions, RefreshOptions } from "native-controls.slint";

export component ReaderPanel inherits Rectangle {
    in property <string> context: State.modal-context;
    out property <length> content-height: context == "reader-mode" ? (State.large-screen ? 300px : 268px) : context == "reader-brightness" ? (State.large-screen ? 346px : 302px) : (State.large-screen ? 128px : 112px);
    height: root.content-height + 48px;
    background: Theme.paper;
    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.ink; }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    if root.context == "reader-mode": ReadingOptions { x: Theme.margin; y: 24px; width: parent.width - Theme.margin * 2; }
    if root.context == "reader-brightness": LightOptions { x: Theme.margin; y: 24px; width: parent.width - Theme.margin * 2; }
    if root.context == "reader-picture": RefreshOptions { x: Theme.margin; y: 24px; width: parent.width - Theme.margin * 2; }
}
