import { State, Commands } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { BodyText, Caption, ActionButton, IconButton, Icon } from "widgets.slint";
import { SettingsBody } from "settings-sections.slint";

export component SettingsPage inherits Rectangle {
    background: Theme.paper;
    property <bool> root-list: !State.large-screen && State.settings-section == "";
    property <string> section: State.settings-section == "" ? "default-direction" : State.settings-section;
    property <length> sidebar-width: State.large-screen ? 320px : root.width;
    property <string> section-title: root.section == "default-direction" ? Strings.turn-and-zoom : root.section == "frontlight-warmth" ? Strings.frontlight-warmth : root.section == "screen-refresh" ? Strings.screen-refresh : root.section == "storage" ? Strings.download-management : root.section == "categories" ? Strings.category : root.section == "backup" ? Strings.backup-restore : root.section == "language" ? Strings.interface-language : Strings.about;
    if root.root-list || State.large-screen: Rectangle { x: 0px; y: 0px;
        width: root.sidebar-width; height: parent.height;
        if State.large-screen: Rectangle { x: parent.width - 1px; y: 20px; width: 1px; height: parent.height - 40px; background: Theme.line; }
        VerticalLayout {
            x: Theme.margin; y: 8px; width: parent.width - Theme.margin * 2; height: parent.height - Theme.touch - 36px;
            alignment: start; spacing: 0px;
            for item[index] in State.settings: Rectangle {
                property <bool> starts-group: index == 0 || item.group != State.settings[index - 1].group;
                property <length> heading: self.starts-group ? (State.large-screen ? 40px : 30px) : 0px;
                min-height: Theme.touch + self.heading; max-height: Theme.touch + self.heading;
                if self.starts-group: BodyText { x: 0px; y: 0px; width: parent.width; height: parent.heading; text: item.group == "reading" ? Strings.reading-group : item.group == "device" ? Strings.device : item.group == "library" ? Strings.content : Strings.general; font-size: Theme.caption; font-weight: 700; }
                Rectangle { x: 0px;
                    y: parent.heading; width: parent.width; height: Theme.touch;
                    background: hit.pressed ? Theme.fill : Theme.paper;
                    accessible-role: button; accessible-label: item.title;
                    BodyText { x: 0px; y: 0px; width: parent.width - 24px - (State.large-screen ? 0px : 120px); height: parent.height; text: item.title; font-size: State.large-screen ? 20px : 18px; font-weight: root.section == item.id && State.large-screen ? 700 : 400; }
                    if !State.large-screen: Caption { y: 0px; x: parent.width - 144px; width: 120px; height: parent.height; text: item.value; horizontal-alignment: right; }
                    Icon { x: parent.width - 18px; y: (parent.height - 16px) / 2; width: 16px; height: 16px; kind: "chevron-right"; }
                    if State.large-screen && root.section == item.id: Rectangle { x: 0px; y: parent.height - 7px; width: 64px; height: 2px; background: Theme.ink; }
                    if !State.large-screen: Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
                    hit := TouchArea { x: 0px; y: 0px; clicked => { Commands.action("settings", "open", item.id); } }
                }
            }
        }
        Rectangle { x: Theme.margin; y: parent.height - Theme.touch - 16px; width: parent.width - Theme.margin * 2; height: 1px; background: Theme.ink; }
        ActionButton { x: Theme.margin; y: parent.height - Theme.touch - 8px; width: parent.width - Theme.margin * 2; text: Strings.exit-app; quiet: true; clicked => { Commands.action("app", "exit", ""); } }
    }
    if !root.root-list: Rectangle { y: 0px;
        x: State.large-screen ? root.sidebar-width : 0px; width: parent.width - self.x; height: parent.height;
        if !State.large-screen: Rectangle { x: 0px; y: 0px;
            width: parent.width; height: Theme.touch + 8px;
            IconButton { y: 0px; x: Theme.margin - 8px; icon: "back"; label: Strings.settings; clicked => { Commands.action("settings", "back", ""); } }
            BodyText { y: 0px; x: Theme.margin + Theme.touch; width: parent.width - self.x - Theme.margin; height: Theme.touch; text: root.section-title; font-size: 20px; font-weight: 700; }
            Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
        }
        SettingsBody { x: Theme.margin; y: State.large-screen ? 28px : Theme.touch + 32px; width: parent.width - Theme.margin * 2; height: parent.height - self.y - 20px; section: root.section; }
    }
}