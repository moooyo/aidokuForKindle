import { CompactPager } from "native-controls.slint";
import { State, Commands, BookItem } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { BodyText, Caption, TitleText, Icon, IconButton, ActionButton, Tab, Cover } from "widgets.slint";
import { IdentityTextFit } from "identity-text.slint";

component LibraryBookCaption inherits Rectangle {
    in property <BookItem> book;
    property <bool> same-label: State.optimized-library-projection
        && (root.book.display-title == "" || root.book.display-title == root.book.title);
    property <length> download-width: State.large-screen ? 16px : 15px;
    property <bool> has-download: root.book.downloaded;
    height: State.large-screen ? 28px : 24px;
    title-fit := IdentityTextFit {
        x: 0px; y: 0px;
        // Avoid measuring the title when both variants are identical.
        full-text: root.same-label ? "" : root.book.title;
        compact-text: root.book.display-title;
        available-width: title-label.width;
        font-family: title-label.font-family;
        font-size: title-label.font-size;
        font-weight: title-label.font-weight;
        letter-spacing: title-label.letter-spacing;
    }
    title-label := BodyText {
        x: 0px; y: 0px;
        width: parent.width - (root.has-download ? root.download-width + 6px : 0px);
        height: parent.height; text: root.same-label ? root.book.title : title-fit.display-text;
        font-size: State.large-screen ? 19px : 17px;
    }
    if root.has-download: Icon {
        x: parent.width - root.download-width; y: (parent.height - self.height) / 2;
        width: root.download-width; height: self.width; kind: "download";
        secondary: true;
    }
}

export component LibraryPage inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <int> columns: State.large-screen ? 5 : 4;
    property <int> rows: State.large-screen ? 3 : 2;
    property <bool> continuation-visible: State.current-book.id != "" && !State.selection-mode;
    property <bool> has-filters: State.library-filters[0] != 0 || State.library-filters[1] != 0 || State.library-filters[2] != 0 || State.library-filters[3] != 0;
    property <length> continuation-height: State.large-screen ? 136px : 124px;
    property <length> grid-top: Theme.toolbar-height + (root.continuation-visible ? root.continuation-height : 0px) + (State.large-screen ? 26px : 22px);
    property <length> column-gap: State.large-screen ? 24px : 14px;
    property <length> base-row-gap: State.large-screen ? 30px : 26px;
    property <length> caption-height: (State.large-screen ? 28px : 24px) + 8px;
    property <length> cell-width: (root.width - Theme.margin * 2 - root.column-gap * (root.columns - 1)) / root.columns;
    property <length> grid-height: root.height - root.grid-top;
    property <length> cover-height: max(1px, min(round(root.cell-width / 1px * 1.55) * 1px, (root.grid-height - root.base-row-gap * (root.rows - 1)) / root.rows - root.caption-height - 8px));
    property <length> row-gap: !State.selection-mode
        ? max(root.base-row-gap, (root.grid-height - 28px - root.rows * (root.cover-height + root.caption-height)) / (root.rows - 1))
        : root.base-row-gap;
    property <length> tile-height: root.cover-height + root.caption-height;
    property <length> toolbar-inset: State.large-screen ? 28px : 14px;

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: Theme.toolbar-height;
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
        if !State.selection-mode: HorizontalLayout {
            x: Theme.margin; y: 0px; width: max(0px, pager.x - self.x - 4px);
            height: parent.height; alignment: start; spacing: State.large-screen ? 18px : 8px;
            for name[index] in [Strings.all, State.category-reading-name, State.category-planned-name, State.category-completed-name, Strings.uncategorized]: Tab {
                visible: index < 4 || State.large-screen;
                width: min(parent.width / (State.large-screen ? 5 : 4) - (State.large-screen ? 2px : 3px), self.preferred-width);
                height: parent.height; text: name; text-padding: 0px;
                selected: State.library-filter == index;
                clicked => { Commands.action("library", "filter", index); }
            }
        }
        if State.selection-mode: BodyText {
            x: Theme.margin; y: 0px; width: max(0px, select-page.x - self.x - 8px); height: parent.height;
            text: Strings.selected-books-prefix + State.selected-books.length + Strings.selected-books-suffix;
        }
        select-page := ActionButton {
            visible: State.selection-mode; x: finish.x - self.width - 8px; y: (parent.height - self.height) / 2;
            width: self.preferred-width; text: Strings.select-page; quiet: true;
            clicked => { Commands.action("library", "select-page", ""); }
        }
        finish := ActionButton {
            visible: State.selection-mode; x: parent.width - root.toolbar-inset - self.width; y: (parent.height - self.height) / 2;
            width: self.preferred-width; text: Strings.keyboard-done; primary: true;
            clicked => { Commands.action("library", "finish-selection", ""); }
        }
        pager := CompactPager {
            visible: !State.selection-mode;
            y: (parent.height - self.height) / 2; x: parent.width - root.toolbar-inset - Theme.touch * 2 - self.width;
            page: State.page; count: State.page-count;
            turn(delta) => { Commands.action("page", "turn", delta); }
        }
        if !State.selection-mode: IconButton {
            x: parent.width - root.toolbar-inset - Theme.touch * 2; y: (parent.height - self.height) / 2;
            icon: "sliders"; label: Strings.sort-and-filter;
            clicked => { Commands.action("library", "filter-menu", ""); }
            if root.has-filters: Rectangle { x: parent.width - 12px; y: 8px; width: 7px; height: 7px; background: Theme.ink; }
        }
        if !State.selection-mode: IconButton {
            x: parent.width - root.toolbar-inset - Theme.touch; y: (parent.height - self.height) / 2;
            icon: "more"; label: Strings.more;
            clicked => { Commands.action("library", "more", ""); }
        }
    }
    if root.continuation-visible: Rectangle {
        x: Theme.margin; y: Theme.toolbar-height; width: parent.width - Theme.margin * 2; height: root.continuation-height;
        property <length> text-left: State.large-screen ? 96px : 80px;
        Cover {
            x: 0px; y: (parent.height - self.height) / 2;
            width: State.large-screen ? 76px : 64px; height: State.large-screen ? 104px : 88px;
            book: State.current-book;
            opened => { Commands.action("library", "open", State.current-book.id); }
        }
        TitleText {
            x: parent.text-left; y: State.large-screen ? 25px : 23px; width: resume.x - self.x - 14px; height: 32px;
            text: State.current-book.title; font-size: State.large-screen ? 23px : 19px; font-weight: 700;
        }
        Caption {
            x: parent.text-left; y: State.large-screen ? 61px : 56px; width: resume.x - self.x - 14px; height: 24px;
            text: State.current-chapter-number == "" ? "" : Strings.chapter-prefix + State.current-chapter-number + Strings.chapter-suffix + (State.current-chapter == "" ? "" : " · " + State.current-chapter);
            font-size: State.large-screen ? 18px : 16px;
        }
        if State.current-chapter-number != "": Rectangle {
            x: parent.text-left; y: State.large-screen ? 92px : 85px;
            width: resume.x - self.x - 14px; height: 24px;
            track := Rectangle {
                x: 0px; y: (parent.height - self.height) / 2; width: min(parent.width * 0.53, State.large-screen ? 200px : 120px); height: 3px;
                background: Theme.line;
                Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * clamp(State.reader-page / max(1.0, State.reader-total), 0, 1); background: Theme.ink; }
            }
            Text {
                x: track.width + 10px; y: 0px; width: parent.width - self.x; height: parent.height;
                text: State.reader-page + " / " + State.reader-total; font-family: Theme.numbers;
                font-size: State.large-screen ? 18px : 16px; color: Theme.ink; vertical-alignment: center; overflow: elide;
            }
        }
        TouchArea {
            x: parent.text-left; y: 0px; width: max(0px, resume.x - self.x - 10px); height: parent.height - 1px;
            accessible-role: button; accessible-label: State.current-book.title;
            clicked => { Commands.action("library", "open", State.current-book.id); }
        }
        resume := ActionButton {
            x: parent.width - self.width; y: (parent.height - self.height) / 2;
            width: self.preferred-width; horizontal-padding: State.large-screen ? 30px : 22px;
            text: Strings.continue-reading; primary: true;
            clicked => { Commands.action("library", "continue", ""); }
        }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
    }
    if State.books.length == 0: Rectangle {
        x: Theme.margin; y: (State.large-screen ? 420px : 300px) - Theme.status-height;
        width: parent.width - Theme.margin * 2; height: message.height + 20px + Theme.touch;
        message := BodyText {
            x: 0px; y: 0px; width: parent.width; height: State.large-screen ? 32px : 26px;
            text: State.library-count == 0 ? Strings.empty-library : Strings.no-results;
            color: Theme.secondary; horizontal-alignment: center;
        }
        ActionButton {
            x: (parent.width - self.width) / 2; y: message.height + 20px;
            width: self.preferred-width; horizontal-padding: 28px;
            text: State.library-count == 0 ? Strings.browse-sources : Strings.clear-filters;
            clicked => {
                if State.library-count == 0 { Commands.action("navigation", "open", "1"); }
                else { Commands.action("library", "clear-filters", ""); }
            }
        }
    }
    for book[index] in State.books: Rectangle {
        x: Theme.margin + mod(index, root.columns) * (root.cell-width + root.column-gap);
        y: root.grid-top + floor(index / root.columns) * (root.tile-height + root.row-gap);
        width: root.cell-width; height: root.tile-height;
        LibraryBookCaption { x: 0px; y: root.cover-height + 8px; width: parent.width; book: book; }
        Cover {
            x: 0px; y: 0px; width: parent.width; height: root.cover-height; hit-height: root.tile-height;
            book: book; selected: book.selected; selection-mode: State.selection-mode; show-badge: true;
            opened => { Commands.action("library", State.selection-mode ? "select" : "open", book.id); }
            held => { Commands.action("library", "select", book.id); }
        }
    }
}
