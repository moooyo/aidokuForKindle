import { Strings } from "strings.slint";

export struct BookItem {
    id: string,
    title: string,
    display-title: string,
    author: string,
    subtitle: string,
    status: string,
    cover: image,
    unread: int,
    downloaded: bool,
    in-library: bool,
    progress: float,
    selected: bool,
}

export struct ChapterItem {
    id: string,
    number: string,
    title: string,
    date: string,
    read: bool,
    downloaded: bool,
    download-state: string,
    download-progress: float,
    current: bool,
    progress: string,
    selected: bool,
}

export struct SourceItem {
    id: string,
    name: string,
    display-name: string,
    subtitle: string,
    compact-status: string,
    update-subtitle: string,
    initial: string,
    available: bool,
    installed: bool,
    update: bool,
    builtin: bool,
}

export struct HistoryItem {
    id: string,
    chapter-id: string,
    title: string,
    subtitle: string,
    progress: string,
    date: string,
    date-label: string,
    date-value: string,
    cover: image,
    fraction: float,
    completed: bool,
    group-start: bool,
    column: int,
    row-index: int,
    group-row-count: int,
    group-offset: int,
    download-state: string,
    download-progress: float,
}

export struct SearchGroup {
    id: string,
    title: string,
    status: string,
    error: bool,
    pending: bool,
    error-detail: string,
    count: int,
    books: [BookItem],
}

export struct SettingItem {
    id: string,
    title: string,
    value: string,
    group: string,
    enabled: bool,
}

export struct DownloadItem {
    id: string,
    book-id: string,
    title: string,
    chapter: string,
    cover: image,
    progress: float,
    state: string,
    status: string,
    completed: int,
    total: int,
}

export struct FilterOption {
    id: string,
    title: string,
    state: int,
}

export struct SourcePreferenceGroup {
    id: string,
    title: string,
    kind: string,
    value: string,
    options: [SettingItem],
    enabled: bool,
}

export global Commands {
    callback action(string, string, string);
    callback refresh(string);
    callback job-ready();
    callback exit-requested();
}

