import { CompactPager } from "native-controls.slint";
import { State, Commands, SourceItem } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { BodyText, Caption, Icon, IconButton, ActionButton, SegmentedControl, Tab, Cover, TitleText } from "widgets.slint";
import { IdentityTextFit } from "identity-text.slint";

export component DownChevron inherits Path {
    in property <color> color: Theme.ink;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: root.color;
    stroke-width: 2.2px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: "M6 9l6 6 6-6";
    accessible-role: none;
}

component SourceTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <int> count: 0;
    callback clicked();
    property <length> inset: State.large-screen ? 14px : 10px;
    preferred-width: label.preferred-width + root.inset * 2 + (root.count > 0 ? badge.width + 6px : 0px);
    min-width: Theme.touch;
    accessible-role: tab;
    accessible-label: root.text + (root.count > 0 ? " " + root.count : "");
    label := BodyText {
        x: root.inset; y: 0px; width: min(self.preferred-width, max(0px, parent.width - root.inset * 2 - (root.count > 0 ? badge.width + 6px : 0px))); height: parent.height;
        text: root.text; font-size: State.large-screen ? 20px : 18px;
        font-weight: root.active ? 700 : 400; color: root.active ? Theme.ink : Theme.secondary;
    }
    badge := Rectangle {
        visible: root.count > 0;
        x: label.x + label.width + 6px; y: (parent.height - self.height) / 2;
        width: max(20px, badge-text.preferred-width + 10px); height: 20px;
        background: Theme.ink;
        badge-text := Text {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            text: root.count; color: Theme.paper; font-family: Theme.numbers; font-size: 12px;
            font-weight: 700; horizontal-alignment: center; vertical-alignment: center;
        }
    }
    if root.active: Rectangle {
        x: root.inset; y: parent.height - 4px; width: parent.width - root.inset * 2; height: 3px;
        background: Theme.ink;
    }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { root.clicked(); } }
}

component ExtensionLanguageFilter inherits SegmentedControl {
    // Show a separate Traditional Chinese filter when published sources use it.
    property <bool> traditional: State.source-has-traditional || State.source-language == "zh-Hant";
    property <[string]> codes: root.traditional ? ["all", "zh-Hans", "en", "ja", "zh-Hant"] : ["all", "zh-Hans", "en", "ja"];
    labels: root.traditional ? [Strings.source-language-all, Strings.chinese, Strings.english, Strings.japanese, Strings.traditional-chinese] : [Strings.source-language-all, Strings.chinese, Strings.english, Strings.japanese];
    selected: State.source-language == "zh-Hans" ? 1 : State.source-language == "en" ? 2 : State.source-language == "ja" ? 3 : State.source-language == "zh-Hant" ? 4 : 0;
    cell-height: State.large-screen ? 48px : 42px;
    text-size: State.large-screen ? 17px : 15px;
    chosen(index) => { Commands.action("sources", "language", root.codes[index]); }
}

component SourceManagementRow inherits Rectangle {
    in property <SourceItem> source;
    property <bool> installed-tab: State.source-filter == 0;
    property <bool> installable-tab: State.source-filter == 1;
    property <bool> update-tab: State.source-filter == 2;
    property <bool> local: root.source.id == "local";
    property <bool> has-settings: root.installed-tab && !root.local && !root.source.needs-setup;
    property <string> subtitle: root.update-tab ? root.source.update-subtitle : root.source.compact-status;
    property <length> label-height: State.large-screen ? 30px : 26px;
    property <length> subtitle-height: State.large-screen ? 24px : 22px;
    property <length> text-height: root.label-height + (root.subtitle == "" ? 0px : root.subtitle-height + 2px);
    property <length> text-width: max(0px, action.x - (root.has-settings ? Theme.touch + 8px : 0px) - 8px);
    height: State.large-screen ? 80px : 72px;
    BodyText {
        x: 0px; y: (parent.height - root.text-height) / 2; width: root.text-width; height: root.label-height;
        text: root.source.name; font-size: State.large-screen ? 22px : 19px;
        color: root.installed-tab && !root.source.available ? Theme.secondary : Theme.ink;
    }
    if root.subtitle != "": Caption {
        x: 0px; y: (parent.height - root.text-height) / 2 + root.label-height + 2px; width: root.text-width; height: root.subtitle-height;
        text: root.subtitle; font-family: root.update-tab ? Theme.numbers : Theme.sans;
    }
    if root.has-settings: IconButton {
        x: action.x - Theme.touch - 8px; y: (parent.height - self.height) / 2;
        icon: "settings"; label: root.source.name + " · " + Strings.source-preferences;
        enabled: !State.busy;
        clicked => { Commands.action("sources", "preferences", root.source.id); }
    }
    action := ActionButton {
        x: parent.width - self.width; y: (parent.height - self.height) / 2;
        width: max(State.large-screen ? 112px : 96px, self.preferred-width);
        text: root.installable-tab ? (root.source.installed ? Strings.installed : Strings.install) : root.update-tab ? Strings.update :
            root.local ? Strings.import-short : !root.source.available ? Strings.migrate : root.source.needs-setup ? Strings.configure : Strings.open;
        enabled: !State.busy && (!root.installable-tab || !root.source.installed);
        clicked => {
            if root.installed-tab && root.local { Commands.action("panel", "choose", "import"); }
            else { Commands.action("sources", root.installable-tab ? "install" : root.update-tab ? "update" :
                !root.source.available ? "migrate" : root.source.needs-setup ? "preferences" : "open", root.source.id); }
        }
    }
}

export component SourcesPage inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <bool> installed-tab: State.source-filter == 0;
    property <bool> installable-tab: State.source-filter == 1;
    property <bool> update-tab: State.source-filter == 2;
    property <[SourceItem]> rows: root.installed-tab ? State.installed-sources : root.installable-tab ? State.available-sources : State.sources;
    property <length> row-height: State.large-screen ? 80px : 72px;
    property <length> group-height: State.large-screen ? 44px : 36px;
    property <int> builtin-count: root.installed-tab ? State.installed-page-builtin-count : 0;
    property <length> builtin-heading: root.builtin-count > 0 ? root.group-height : 0px;
    property <length> extension-heading: root.installed-tab && root.rows.length > root.builtin-count ? root.group-height : 0px;
    property <length> body-top: Theme.toolbar-height + (root.installable-tab ? 26px + language-filter.height : root.update-tab ? root.row-height : 0px);
    property <int> page-count: root.installed-tab ? State.installed-source-page-count : State.page-count;
    property <length> left-inset: State.large-screen ? 30px : 18px;
    property <length> right-inset: State.large-screen ? 28px : 14px;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: Theme.toolbar-height;
        if State.source-management-back: IconButton {
            x: root.left-inset; y: (parent.height - self.height) / 2; icon: "back"; label: Strings.back;
            clicked => { Commands.action("sources", "back", ""); }
        }
        HorizontalLayout {
            x: root.left-inset + (State.source-management-back ? Theme.touch : 0px); y: 0px;
            width: max(0px, pager.x - self.x); height: parent.height;
            alignment: start;
            for label[index] in [Strings.installed, Strings.installable, Strings.updates-available]: SourceTab {
                text: label; width: min(self.preferred-width, parent.width / 3); height: parent.height;
                active: State.source-filter == index; count: index == 2 ? State.source-update-count : 0;
                clicked => { Commands.action("sources", "filter", index); }
            }
        }
        pager := CompactPager {
            x: parent.width - root.right-inset - Theme.touch - (root.page-count > 1 ? self.width : 0px); y: (parent.height - self.height) / 2;
            page: root.installed-tab ? State.installed-source-page : State.page; count: root.page-count;
            turn(delta) => { Commands.action(root.installed-tab ? "sources" : "page", root.installed-tab ? "installed-page" : "turn", delta); }
        }
        IconButton {
            x: parent.width - root.right-inset - self.width; y: (parent.height - self.height) / 2;
            icon: "plus"; label: Strings.source-list;
            clicked => { Commands.action("sources", "list", ""); }
        }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
    }
    language-filter := ExtensionLanguageFilter {
        visible: root.installable-tab;
        x: Theme.margin; y: Theme.toolbar-height + 14px; width: parent.width - Theme.margin * 2;
    }
    if root.update-tab: Rectangle {
        x: Theme.margin; y: Theme.toolbar-height; width: parent.width - Theme.margin * 2; height: root.row-height;
        Caption {
            x: 0px; y: 0px; width: parent.width - (State.source-update-count > 0 ? 180px : 0px); height: parent.height;
            font-size: Theme.body; text: State.source-update-summary;
        }
        if State.source-update-count > 0: ActionButton {
            x: parent.width - self.width; y: (parent.height - self.height) / 2; width: self.preferred-width;
            text: Strings.update-all; primary: true; enabled: !State.busy; horizontal-padding: 22px;
            clicked => { Commands.action("sources", "update-all", ""); }
        }
    }
    Rectangle {
        x: Theme.margin; y: root.body-top; width: parent.width - Theme.margin * 2; height: max(0px, parent.height - self.y); clip: true;
        if root.builtin-heading > 0px: Caption {
            x: 0px; y: 0px; width: parent.width; height: root.builtin-heading - 6px;
            text: Strings.builtin; letter-spacing: 2px; vertical-alignment: bottom;
        }
        if root.extension-heading > 0px: Caption {
            x: 0px; y: root.builtin-heading + root.builtin-count * root.row-height; width: parent.width; height: root.extension-heading - 6px;
            text: Strings.extensions; letter-spacing: 2px; vertical-alignment: bottom;
        }
        for source[index] in root.rows: SourceManagementRow {
            x: 0px; y: root.builtin-heading + index * root.row-height + (index >= root.builtin-count ? root.extension-heading : 0px);
            width: parent.width; source: source;
        }
        if root.rows.length == 0 && !root.update-tab: TitleText {
            x: 0px; y: 80px; width: parent.width; height: Theme.toolbar-height;
            text: Strings.no-results; font-size: State.large-screen ? 28px : 22px; font-weight: 700; horizontal-alignment: center;
        }
    }
}

component CatalogFilterButton inherits Rectangle {
    property <bool> selected: State.catalog-active-filter-count > 0;
    width: Theme.touch; height: Theme.touch;
    accessible-role: button;
    accessible-label: Strings.filter + (root.selected ? " " + State.catalog-active-filter-count : "");
    accessible-checkable: true;
    accessible-checked: root.selected;
    Icon {
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        width: State.large-screen ? 26px : 24px; height: self.width; kind: "filter";
    }
    if root.selected: Rectangle {
        x: parent.width - 17px; y: 9px; width: 9px; height: 9px;
        border-width: 2px; border-color: Theme.paper; background: Theme.ink;
    }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { Commands.action("catalog", "filter-menu", ""); } }
}

export component CatalogPage inherits Rectangle {
    property <bool> show-catalog: State.source-available && (!State.source-needs-setup || State.catalog-result-count > 0);
    property <bool> browse: !State.catalog-search-results;
    property <bool> can-search: root.browse && root.show-catalog && State.catalog-source-searchable;
    property <length> right-inset: State.large-screen ? 28px : 14px;
    property <length> tab-height: State.large-screen ? 56px : 48px;
    property <int> columns: State.large-screen ? 5 : 3;
    property <int> rows: State.large-screen ? 3 : 2;
    property <length> column-gap: State.large-screen ? 24px : 20px;
    property <length> row-gap: State.large-screen ? 34px : 20px;
    property <length> grid-top: Theme.toolbar-height + root.tab-height + (State.large-screen ? 22px : 18px);
    property <length> cell-width: max(1px, (root.width - Theme.margin * 2 - root.column-gap * (root.columns - 1)) / root.columns);
    property <length> title-height: State.large-screen ? 28px : 24px;
    property <length> metadata-height: State.large-screen ? 23px : 19px;
    property <length> cover-target: (State.large-screen ? 236px : 232px) + max(0px, root.height - (State.large-screen ? 1124px : 724px)) / root.rows;
    property <length> cover-height: max(1px, min(root.cover-target, (root.height - root.grid-top - root.row-gap * (root.rows - 1)) / root.rows - root.title-height - root.metadata-height - 8px));
    property <length> cell-height: root.cover-height + root.title-height + root.metadata-height + 8px;
    background: Theme.paper;
    clip: true;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: Theme.toolbar-height;
        if !root.browse: IconButton {
            x: Theme.margin; y: (parent.height - self.height) / 2; icon: "back"; label: Strings.back;
            clicked => { Commands.action("catalog", "back", ""); }
        }
        Rectangle {
            x: Theme.margin + (root.browse ? 0px : Theme.touch + 6px); y: (parent.height - self.height) / 2;
            width: min(max(Theme.touch, source-name.preferred-width + (root.browse ? 26px : 0px)), max(Theme.touch, pager.x - self.x - 8px)); height: Theme.touch;
            source-name := BodyText {
                x: 0px; y: 0px; width: parent.width - (root.browse ? 26px : 0px); height: parent.height;
                text: State.source-title; font-size: State.large-screen ? 24px : 20px; font-weight: 700;
            }
            if root.browse: DownChevron { x: parent.width - 20px; y: (parent.height - self.height) / 2; width: 20px; height: 20px; }
            if root.browse: TouchArea {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                accessible-role: button; accessible-label: State.source-title;
                clicked => { Commands.action("sources", "picker", ""); }
            }
        }
        pager := CompactPager {
            x: parent.width - root.right-inset - (root.browse && root.show-catalog ? Theme.touch + 8px : 0px)
                - (root.can-search ? (State.large-screen ? 316px : Theme.touch + 8px) : 0px) - self.width;
            y: (parent.height - self.height) / 2;
            count: max(1, State.page-count - (State.catalog-has-more ? 1 : 0));
            page: min(State.page, self.count); visible: root.show-catalog;
            previous-enabled: State.page > 1;
            next-enabled: !State.busy && State.page < State.page-count;
            turn(delta) => { Commands.action("page", "turn", delta); }
        }
        if State.large-screen && root.can-search: Rectangle {
            x: filter.x - 8px - self.width; y: (parent.height - self.height) / 2;
            width: 300px; height: 48px;
            border-width: Theme.control-border; border-color: Theme.ink; background: Theme.paper;
            accessible-role: button; accessible-label: search-label.text;
            Icon { x: 14px; y: (parent.height - self.height) / 2; width: 22px; height: 22px; kind: "search"; secondary: true; }
            search-label := Caption {
                x: 46px; y: 0px; width: parent.width - 60px; height: parent.height;
                text: Strings.source-search-prefix + State.source-title + Strings.source-search-suffix; font-size: 17px;
            }
            TouchArea { x: 0px; y: -4px; width: parent.width; height: Theme.touch; clicked => { Commands.action("catalog", "search", ""); } }
        }
        if !State.large-screen && root.can-search: IconButton {
            x: filter.x - 8px - self.width; y: (parent.height - self.height) / 2;
            icon: "search"; label: Strings.search;
            clicked => { Commands.action("catalog", "search", ""); }
        }
        filter := CatalogFilterButton { visible: root.browse && root.show-catalog; x: parent.width - root.right-inset - self.width; y: (parent.height - self.height) / 2; }
        if !root.show-catalog: Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
    }
    if root.show-catalog: Rectangle {
        x: 0px; y: Theme.toolbar-height; width: parent.width; height: root.tab-height;
        if !root.browse: Caption {
            x: Theme.margin; y: 0px; width: parent.width - Theme.margin * 2; height: parent.height;
            text: Strings.opening-quote + State.query + Strings.closing-quote + " · "
                + State.catalog-result-count + (State.catalog-has-more ? "+ " : " ") + Strings.books-unit;
        }
        if root.browse: HorizontalLayout {
            x: Theme.margin; y: 0px; width: parent.width - Theme.margin * 2; height: parent.height;
            alignment: start; spacing: State.large-screen ? 30px : 24px;
            for label[index] in State.catalog-tabs: Tab {
                text: label; width: min(180px, self.preferred-width); height: parent.height; visual-height: self.height - 1px;
                selected: State.catalog-filter == index;
                clicked => { Commands.action("catalog", "filter", index); }
            }
        }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
    }
    if root.show-catalog: Rectangle {
        x: Theme.margin; y: root.grid-top; width: parent.width - Theme.margin * 2; height: max(0px, parent.height - self.y); clip: true;
        for book[index] in State.catalog: Rectangle {
            x: mod(index, root.columns) * (root.cell-width + root.column-gap);
            y: floor(index / root.columns) * (root.cell-height + root.row-gap);
            width: root.cell-width; height: root.cell-height;
            Cover { x: 0px; y: 0px; width: parent.width; height: root.cover-height; book: book; border-color: Theme.ink; border-radius: Theme.control-radius; opened => { Commands.action("catalog", "open", book.id); } }
            title-fit := IdentityTextFit {
                x: 0px; y: 0px; full-text: book.title; compact-text: book.display-title; available-width: title-label.width;
                font-family: title-label.font-family; font-size: title-label.font-size;
                font-weight: title-label.font-weight; letter-spacing: title-label.letter-spacing;
            }
            title-label := BodyText {
                x: 0px; y: root.cover-height + 6px;
                width: parent.width - (book.in-library ? 21px : 0px); height: root.title-height;
                text: title-fit.display-text; accessible-label: book.title; font-size: Theme.book-title;
            }
            if book.in-library: Icon { x: parent.width - self.width; y: title-label.y + (title-label.height - self.height) / 2; width: 15px; height: 15px; kind: "bookmark-filled"; }
            Caption {
                x: 0px; y: title-label.y + title-label.height + 2px; width: parent.width; height: root.metadata-height;
                text: book.subtitle; font-size: State.large-screen ? 15px : 13px;
            }
            TouchArea { x: 0px; y: root.cover-height; width: parent.width; height: parent.height - self.y; clicked => { Commands.action("catalog", "open", book.id); } }
        }
    }
    if !root.show-catalog || State.catalog.length == 0: Rectangle {
        x: Theme.margin; y: State.large-screen ? 404px : 272px; width: parent.width - Theme.margin * 2; height: 184px;
        TitleText {
            x: 0px; y: 0px; width: parent.width; height: Theme.touch;
            text: !State.source-available ? State.source-subtitle : State.source-needs-setup ? State.source-connection-status : State.busy ? Strings.loading : Strings.empty-catalog;
            font-size: State.large-screen ? 28px : 22px; font-weight: 700; horizontal-alignment: center;
        }
        HorizontalLayout {
            x: 0px; y: Theme.touch + 12px; width: parent.width; height: Theme.touch; alignment: center; spacing: 12px;
            if !State.source-available: ActionButton { width: self.preferred-width; text: Strings.migrate; primary: true; clicked => { Commands.action("sources", "migrate", State.source-id); } }
            if !State.source-available: ActionButton { width: self.preferred-width; text: Strings.uninstall; clicked => { Commands.action("sources", "uninstall", State.source-id); } }
            if State.source-available && State.source-needs-setup: ActionButton { width: self.preferred-width; text: Strings.configure; primary: true; clicked => { Commands.action("catalog", "settings", ""); } }
            if root.show-catalog && !State.source-needs-setup && !State.busy: ActionButton {
                width: self.preferred-width; text: State.catalog-has-more ? Strings.load-more : Strings.retry; primary: true;
                clicked => { Commands.action(State.catalog-has-more ? "catalog" : "sources", State.catalog-has-more ? "load-more" : "open", State.catalog-has-more ? "" : State.source-id); }
            }
        }
    }
}
