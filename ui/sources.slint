import { CompactPager } from "native-controls.slint";
import { State, Commands, SourceItem, BookItem } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { BodyText, Icon, IconButton, ActionButton, PageBar, PageHeader, Tab, EmptyState, Cover, GroupLabel } from "widgets.slint";
import { IdentityTextFit } from "identity-text.slint";

component DashedFrame inherits Rectangle {
    in property <color> stroke-color: Theme.secondary;
    background: transparent;
    clip: true;
    for dash in ceil(root.width / 7px): Rectangle { x: dash * 7px; y: 0px; width: 4px; height: 1.5px; background: root.stroke-color; }
    for dash in ceil(root.width / 7px): Rectangle { x: dash * 7px; y: root.height - 1.5px; width: 4px; height: 1.5px; background: root.stroke-color; }
    for dash in ceil(root.height / 7px): Rectangle { x: 0px; y: dash * 7px; width: 1.5px; height: 4px; background: root.stroke-color; }
    for dash in ceil(root.height / 7px): Rectangle { x: root.width - 1.5px; y: dash * 7px; width: 1.5px; height: 4px; background: root.stroke-color; }
}

component SourceMark inherits Rectangle {
    in property <string> initial;
    in property <bool> builtin: false;
    in property <bool> available: true;
    in property <bool> inverted: false;
    in property <bool> show-warning: true;
    in property <length> type-size: State.large-screen ? 18px : 17px;
    border-radius: Theme.control-radius;
    border-width: root.available ? Theme.control-border : 0px;
    border-color: root.inverted ? Theme.paper : Theme.ink;
    background: (root.available && root.builtin) != root.inverted ? Theme.ink : Theme.paper;
    if root.available || !root.show-warning: Text { x: 0px; y: 0px;
        text: root.initial; font-family: Theme.numbers; font-size: root.type-size; font-weight: 700;
        color: !root.available ? Theme.muted : root.builtin != root.inverted ? Theme.paper : Theme.ink;
        horizontal-alignment: center; vertical-alignment: center;
    }
    if !root.available: DashedFrame { x: 0px; y: 0px; width: parent.width; height: parent.height; stroke-color: root.inverted ? Theme.paper : Theme.secondary; }
    if !root.available && root.show-warning: Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: State.large-screen ? 22px : 20px; height: self.width; kind: "warning"; secondary: true; inverted: root.inverted; }
}

component SourceLanguageFilter inherits Rectangle {
    property <[string]> labels: [Strings.source-language-all, Strings.source-language-simplified, Strings.source-language-traditional, Strings.source-language-english, Strings.source-language-japanese];
    property <[string]> codes: ["all", "zh-Hans", "zh-Hant", "en", "ja"];
    height: State.large-screen ? 66px : 60px;
    HorizontalLayout {
        x: Theme.margin; y: 9px; width: parent.width - Theme.margin * 2; height: Theme.touch; alignment: start; spacing: 8px;
        for label[index] in root.labels: Rectangle {
            preferred-width: caption.preferred-width + 32px + Theme.control-border * 2;
            min-width: Theme.touch;
            height: Theme.touch;
            property <bool> inverted: (State.source-language-index == index) != touch.pressed;
            Rectangle { x: 0px; y: (parent.height - self.height) / 2; width: parent.width; height: State.large-screen ? 42px : 38px; border-width: Theme.control-border; border-color: Theme.ink; border-radius: Theme.control-radius; background: parent.inverted ? Theme.ink : Theme.paper; }
            caption := Text { x: 0px; y: 0px; width: parent.width; height: parent.height; text: label; font-family: Theme.sans; font-size: State.large-screen ? 15px : 14px; font-weight: State.source-language-index == index ? 700 : 500; color: parent.inverted ? Theme.paper : Theme.ink; horizontal-alignment: center; vertical-alignment: center; }
            accessible-role: button;
            accessible-label: label;
            accessible-checkable: true;
            accessible-checked: State.source-language-index == index;
            touch := TouchArea { x: 0px; y: 0px;
                clicked => { Commands.action("sources", "language", root.codes[index]); }
                pointer-event(event) => { if event.kind == PointerEventKind.down { Commands.refresh("fast"); } else if event.kind == PointerEventKind.up { Commands.refresh("ui"); } }
            }
        }
    }
}

component CatalogFilterButton inherits Rectangle {
    property <bool> selected: State.catalog-active-filter-count > 0;
    property <bool> inverted: root.selected != touch.pressed;
    width: Theme.touch;
    height: Theme.touch;
    accessible-role: button;
    accessible-label: Strings.filter + (State.catalog-active-filter-count > 0 ? " " + State.catalog-active-filter-count : "");
    accessible-checkable: true;
    accessible-checked: root.selected;
    Rectangle {
        x: (parent.width - 48px) / 2; y: (parent.height - 48px) / 2; width: 48px; height: 48px;
        border-width: State.large-screen ? Theme.control-border : 0px; border-color: Theme.ink; border-radius: Theme.control-radius; background: root.inverted ? Theme.ink : Theme.paper;
        Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: State.large-screen ? 22px : 23px; height: self.width; kind: "filter"; inverted: root.inverted; }
    }
    if !State.large-screen && State.catalog-active-filter-count > 0: Rectangle {
        x: parent.width - 20px; y: 2px; width: 20px; height: 20px;
        border-width: Theme.control-border; border-color: Theme.ink; border-radius: 2px; background: Theme.paper;
        Text { x: 0px; y: 0px; text: State.catalog-active-filter-count; font-family: Theme.numbers; font-size: 12px; font-weight: 700; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; }
    }
    touch := TouchArea { x: 0px; y: 0px;
        clicked => { Commands.action("catalog", "filter-menu", ""); }
        pointer-event(event) => { if event.kind == PointerEventKind.down { Commands.refresh("fast"); } else if event.kind == PointerEventKind.up { Commands.refresh("ui"); } }
    }
}

component CatalogTabs inherits Rectangle {
    property <[string]> labels: State.catalog-tabs.length > 0 ? State.catalog-tabs : [Strings.popular, Strings.recently-updated, Strings.newly-added];
    height: State.large-screen ? 63px : 49px;
    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
    HorizontalLayout {
        x: Theme.margin; y: 0px; width: State.large-screen ? parent.width - Theme.margin - 420px : parent.width - Theme.margin * 2; height: parent.height - 1px;
        alignment: start; spacing: State.large-screen ? 30px : 24px;
        for label[index] in root.labels: Tab { text: label; height: State.large-screen ? 62px : 48px; visual-height: self.height; selected: State.catalog-filter == index; clicked => { Commands.action("catalog", "filter", index); } }
    }
    if State.large-screen: Rectangle {
        x: parent.width - 28px - 48px - 10px - self.width; y: 7px; width: 300px; height: 48px;
        border-width: Theme.control-border; border-color: Theme.ink; border-radius: Theme.control-radius; background: touch.pressed ? Theme.ink : Theme.paper;
        accessible-role: button; accessible-label: Strings.source-search-prefix + State.source-title + Strings.source-search-suffix;
        Icon { x: 14px; y: 14px; width: 20px; height: 20px; kind: "search"; inverted: touch.pressed; }
        Text { x: 44px; y: 0px; width: parent.width - 58px; height: parent.height; text: Strings.source-search-prefix + State.source-title + Strings.source-search-suffix; font-family: Theme.sans; font-size: 16px; color: touch.pressed ? Theme.paper : Theme.secondary; vertical-alignment: center; overflow: elide; }
        touch := TouchArea { x: 0px;
            y: -4px; height: 56px;
            clicked => { Commands.action("catalog", "search", ""); }
            pointer-event(event) => { if event.kind == PointerEventKind.down { Commands.refresh("fast"); } else if event.kind == PointerEventKind.up { Commands.refresh("ui"); } }
        }
    }
    if State.large-screen: CatalogFilterButton { x: parent.width - 28px - 52px; y: 3px; }
}

export component CatalogGrid inherits Rectangle {
    in property <[BookItem]> books;
    in property <int> columns: 5;
    property <length> gap: 20px;
    property <length> card-width: (root.width - (root.columns - 1) * root.gap) / root.columns;
    property <length> cover-width: min(152px, root.card-width);
    clip: true;
    for book[index] in root.books: Rectangle {
        visible: index < 15;
        x: mod(index, root.columns) * (root.card-width + root.gap); y: floor(index / root.columns) * 277px; width: root.card-width; height: 257px;
        background: touch.pressed ? Theme.ink : Theme.paper;
        accessible-role: button; accessible-label: book.title;
        Cover { x: 0px; y: 0px; width: root.cover-width; height: 204px; book: book; opened => { Commands.action("catalog", "open", book.id); } }
        title-fit := IdentityTextFit { x: 0px; y: 0px;
            full-text: book.title; compact-text: book.display-title; available-width: title-label.width;
            font-family: title-label.font-family; font-size: title-label.font-size;
            font-weight: title-label.font-weight; letter-spacing: title-label.letter-spacing;
        }
        title-label := Text { x: 0px; y: 212px; width: parent.width - (book.in-library ? 22px : 0px); height: 23px; text: title-fit.display-text; accessible-label: book.title; font-family: Theme.sans; font-size: 17px; font-weight: 500; color: touch.pressed ? Theme.paper : Theme.ink; vertical-alignment: center; overflow: elide; }
        if book.in-library: Icon { x: parent.width - 16px; y: 215px; width: 16px; height: 16px; kind: "bookmark-filled"; inverted: touch.pressed; }
        Text { x: 0px; y: 239px; width: parent.width; height: 18px; text: book.status; font-family: Theme.sans; font-size: 14px; color: touch.pressed ? Theme.paper : Theme.secondary; vertical-alignment: center; overflow: elide; }
        touch := TouchArea { x: 0px; y: 0px;
            clicked => { Commands.action("catalog", "open", book.id); }
            pointer-event(event) => { if event.kind == PointerEventKind.down { Commands.refresh("fast"); } else if event.kind == PointerEventKind.up { Commands.refresh("ui"); } }
        }
    }
}

export component SourcesPage inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <[SourceItem]> rows: State.source-filter == 0 ? State.installed-sources : State.source-filter == 1 ? State.available-sources : State.sources;
    property <length> header-height: Theme.touch + 16px;
    property <length> row-height: State.large-screen ? 96px : 80px;
    property <int> count: State.source-filter == 0 ? State.installed-source-page-count : State.page-count;
    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: root.header-height;
        IconButton { x: Theme.margin; y: 0px; icon: "back"; label: Strings.back; clicked => { Commands.action("sources", "back", ""); } }
        HorizontalLayout {
            x: Theme.margin + Theme.touch + 12px; y: 0px; width: parent.width - self.x - Theme.margin - Theme.touch; height: Theme.touch; spacing: 16px; alignment: start;
            for label[index] in [Strings.installed, Strings.installable, Strings.updates-available]: ActionButton {
                text: label; quiet: true; horizontal-padding: 4px; clicked => { Commands.action("sources", "filter", "" + index); }
                if State.source-filter == index: Rectangle { x: 4px; y: parent.height - 4px; width: parent.width - 8px; height: 2px; background: Theme.ink; }
            }
        }
        IconButton { x: parent.width - Theme.margin - Theme.touch; y: 0px; icon: "plus"; label: Strings.add-source; clicked => { Commands.action("sources", "add", ""); } }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
    }
    if State.source-filter == 1: SourceLanguageFilter { x: 0px; y: root.header-height; width: parent.width; }
    Rectangle {
        x: Theme.margin; y: root.header-height + (State.source-filter == 1 ? (State.large-screen ? 66px : 60px) : 0px);
        width: parent.width - Theme.margin * 2; height: parent.height - self.y - (root.count > 1 ? Theme.touch : 0px); clip: true;
        for source[index] in root.rows: Rectangle {
            x: 0px; y: index * root.row-height; width: parent.width; height: root.row-height;
            BodyText { x: 0px; y: 0px; width: parent.width - 180px; height: parent.height; text: source.name; font-size: State.large-screen ? 24px : 22px; }
            ActionButton {
                x: parent.width - 104px; y: (parent.height - Theme.touch) / 2; width: 104px;
                text: State.source-filter == 1 ? (source.installed ? Strings.installed : Strings.install) : State.source-filter == 2 ? Strings.update : source.id == "local" ? Strings.import-short : source.builtin ? Strings.configure : Strings.open;
                enabled: !State.busy && (State.source-filter != 1 || !source.installed);
                clicked => { if State.source-filter == 0 && source.id == "local" { Commands.action("panel", "choose", "import"); } else { Commands.action("sources", State.source-filter == 1 ? "install" : State.source-filter == 2 ? "update" : "open", source.id); } }
            }
            if State.source-filter == 0 && source.id != "local": IconButton { x: parent.width - 112px - Theme.touch; y: (parent.height - Theme.touch) / 2; icon: "settings"; label: Strings.source-preferences; clicked => { Commands.action("sources", "preferences", source.id); } }
            Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
        }
        if root.rows.length == 0: EmptyState { x: 0px; y: 24px; width: parent.width; height: 260px; title: State.source-filter == 2 ? Strings.no-updates : Strings.no-results; }
    }
    if root.count > 1: CompactPager { x: parent.width - Theme.margin - self.width; y: parent.height - Theme.touch; page: State.source-filter == 0 ? State.installed-source-page : State.page; count: root.count; turn(delta) => { Commands.action(State.source-filter == 0 ? "sources" : "page", State.source-filter == 0 ? "installed-page" : "turn", delta); } }
}
export component CatalogPage inherits Rectangle {
    property <bool> picker-open: State.modal == "choices" && State.modal-context == "source-picker";
    property <bool> has-catalog: State.catalog.length > 0 || State.catalog-result-count > 0;
    property <bool> show-setup: State.source-available && State.source-needs-setup && !root.has-catalog;
    property <bool> show-catalog: State.source-available && !root.show-setup;
    property <string> source-caption: State.source-needs-setup && root.has-catalog && State.source-connection-status != "" ? State.source-connection-status + " · " + State.source-subtitle : State.source-subtitle;
    background: Theme.paper;
    clip: true;
    property <int> columns: State.large-screen ? 5 : 3;
    property <length> cell-width: (root.width - Theme.margin * 2 - 20px * (root.columns - 1)) / root.columns;
    property <length> cover-height: root.cell-width * 1.24;
    Rectangle { x: 0px; y: 0px;
        width: parent.width; height: Theme.touch + 16px;
        ActionButton { y: 0px; x: Theme.margin; width: max(Theme.touch, pager.x - Theme.margin - 16px); text: State.source-title + "  ⌄"; quiet: true; clicked => { Commands.action("sources", "picker", ""); } }
        pager := CompactPager { y: 0px; x: parent.width - Theme.margin - Theme.touch * 2 - self.width; page: State.page; count: State.page-count; turn(delta) => { Commands.action("page", "turn", delta); } }
        IconButton { y: 0px; x: parent.width - Theme.margin - Theme.touch * 2; icon: "search"; label: Strings.search; clicked => { Commands.action("catalog", "search", ""); } }
        CatalogFilterButton { y: 0px; x: parent.width - Theme.margin - Theme.touch; }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
    }
    if root.show-catalog: CatalogTabs { x: 0px; y: Theme.touch + 16px; width: parent.width; }
    if root.show-catalog: Rectangle {
        x: Theme.margin; y: Theme.touch * 2 + 48px; width: parent.width - Theme.margin * 2; height: parent.height - self.y; clip: true;
        for book[index] in State.catalog: Rectangle {
            x: mod(index, root.columns) * (root.cell-width + 20px); y: floor(index / root.columns) * (root.cover-height + 54px); width: root.cell-width; height: root.cover-height + 54px;
            Cover { x: 0px; y: 0px; width: parent.width; height: root.cover-height; book: book; show-progress: false; opened => { Commands.action("catalog", "open", book.id); } }
            BodyText { x: 0px; y: root.cover-height + 8px; width: parent.width; height: 26px; text: book.title; font-size: State.large-screen ? 18px : 17px; }
            TouchArea { x: 0px; y: root.cover-height; width: parent.width; height: Theme.touch; clicked => { Commands.action("catalog", "open", book.id); } }
        }
    }    if root.show-catalog && State.catalog.length == 0: EmptyState {
        x: Theme.margin; y: State.large-screen ? 240px : 200px; width: parent.width - Theme.margin * 2; height: 300px;
        title: State.busy ? Strings.loading : Strings.empty-catalog; message: State.message;
        action: State.busy ? "" : State.catalog-has-more ? Strings.load-more : Strings.retry;
        clicked => { Commands.action(State.catalog-has-more ? "catalog" : "sources", State.catalog-has-more ? "load-more" : "open", State.catalog-has-more ? "" : State.source-id); }
    }
    if root.show-setup: Rectangle {
        x: 0px; y: State.large-screen ? 132px : 127.5px; width: parent.width; height: parent.height - self.y;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
        Text { x: Theme.margin; y: State.large-screen ? 30px : 22px; width: min(640px, parent.width - Theme.margin * 2); height: 19.5px; text: Strings.server-url; font-family: Theme.sans; font-size: State.large-screen ? 13px : 12px; letter-spacing: State.large-screen ? 3px : 2px; color: Theme.secondary; vertical-alignment: center; }
        Rectangle {
            x: Theme.margin; y: State.large-screen ? 57.5px : 48px; width: min(640px, parent.width - Theme.margin * 2); height: State.large-screen ? 58px : 50px;
            border-width: Theme.control-border; border-color: Theme.ink; border-radius: Theme.control-radius; background: address-touch.pressed ? Theme.ink : Theme.paper;
            accessible-role: button; accessible-label: Strings.configure + " " + Strings.server-url;
            Text { x: 18px; y: 0px; width: parent.width - 36px; height: parent.height; text: State.source-server-address == "" ? "http://" : State.source-server-address; font-family: Theme.numbers; font-size: State.large-screen ? 18px : 16px; color: address-touch.pressed ? Theme.paper : State.source-server-address == "" ? Theme.muted : Theme.ink; vertical-alignment: center; overflow: elide; }
            address-touch := TouchArea { x: 0px; y: 0px;
                clicked => { Commands.action("sources", "edit-address", State.source-id); }
                pointer-event(event) => { if event.kind == PointerEventKind.down { Commands.refresh("fast"); } else if event.kind == PointerEventKind.up { Commands.refresh("ui"); } }
            }
        }
        Text { x: Theme.margin; y: State.large-screen ? 133.5px : 116px; width: min(640px, parent.width - Theme.margin * 2); height: 19.5px; text: Strings.server-credentials; font-family: Theme.sans; font-size: State.large-screen ? 13px : 12px; letter-spacing: State.large-screen ? 3px : 2px; color: Theme.secondary; vertical-alignment: center; }
        Rectangle {
            x: Theme.margin; y: State.large-screen ? 161px : 142px; width: min(640px, parent.width - Theme.margin * 2); height: State.large-screen ? 58px : 50px;
            border-width: Theme.control-border; border-color: Theme.ink; border-radius: Theme.control-radius; background: credentials-touch.pressed ? Theme.ink : Theme.paper;
            accessible-role: button; accessible-label: Strings.configure + " " + Strings.server-credentials;
            Text { x: 18px; y: 0px; width: parent.width - 36px; height: parent.height; text: State.source-server-credential == "" ? "[API Key]" : State.source-server-credential; font-family: Theme.numbers; font-size: State.large-screen ? 18px : 16px; color: credentials-touch.pressed ? Theme.paper : State.source-server-credential == "" ? Theme.muted : Theme.ink; vertical-alignment: center; overflow: elide; }
            credentials-touch := TouchArea { x: 0px; y: 0px;
                clicked => { Commands.action("sources", "edit-credential", State.source-id); }
                pointer-event(event) => { if event.kind == PointerEventKind.down { Commands.refresh("fast"); } else if event.kind == PointerEventKind.up { Commands.refresh("ui"); } }
            }
        }
        Rectangle {
            x: Theme.margin; y: State.large-screen ? 237px : 210px; width: min(640px, parent.width - Theme.margin * 2); height: State.large-screen ? 60px : 54px;
            ActionButton { x: 0px; y: 0px; width: (parent.width - 12px) / 2; text: Strings.fill-on-phone; height: parent.height; clicked => { Commands.action("sources", "configure", State.source-id); } }
            ActionButton { x: (parent.width + 12px) / 2; y: 0px; width: (parent.width - 12px) / 2; text: Strings.test-and-connect; height: parent.height; primary: true; enabled: !State.busy && State.source-server-address != ""; clicked => { Commands.action("sources", "test-connect", State.source-id); } }
        }
        if State.source-connection-status != "": Text { x: Theme.margin; y: State.large-screen ? 315px : 282px; width: min(640px, parent.width - Theme.margin * 2); height: 66px; text: State.source-connection-status; font-family: Theme.sans; font-size: Theme.body; color: Theme.secondary; wrap: word-wrap; }
    }
    if !State.source-available: Rectangle {
        x: 0px; y: State.large-screen ? 132px : 124px; width: parent.width; height: parent.height - self.y;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.line; }
        Rectangle {
            x: (parent.width - self.width) / 2; y: State.large-screen ? 91px : 60px; width: State.large-screen ? 132px : 96px; height: self.width;
            if State.large-screen: Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: @image-url("../assets/icons/source-unavailable.svg"); image-fit: contain; accessible-role: none; }
            if !State.large-screen: Rectangle { x: 0px; y: 0px;
                width: parent.width; height: parent.height; border-width: Theme.control-border; border-color: Theme.ink; border-radius: self.width / 2; background: Theme.paper;
                Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 34px; height: 34px; kind: "warning"; }
            }
        }
        Text { x: State.large-screen ? 120px : Theme.margin; y: State.large-screen ? 244px : 174px; width: parent.width - self.x * 2; height: 38px; text: State.source-subtitle == "" ? Strings.unavailable : State.source-subtitle; font-family: Theme.serif; font-size: State.large-screen ? 28px : 22px; font-weight: 900; letter-spacing: 2px; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        HorizontalLayout {
            x: (parent.width - self.width) / 2; y: State.large-screen ? 306px : 240px; width: State.large-screen ? 292px : 260px; height: State.large-screen ? 58px : 52px; spacing: 12px;
            ActionButton { width: State.large-screen ? 184px : 164px; height: parent.height; text: Strings.migrate-source; primary: true; clicked => { Commands.action("sources", "migrate", State.source-id); } }
            ActionButton { width: State.large-screen ? 96px : 84px; height: parent.height; text: Strings.uninstall; clicked => { Commands.action("sources", "uninstall", State.source-id); } }
        }
    }

}
