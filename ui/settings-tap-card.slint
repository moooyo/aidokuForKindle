import { State, Commands } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { BodyText } from "widgets.slint";

component TapLayoutCard inherits Rectangle {
    in property <string> label;
    in property <string> layout;
    in property <bool> selected;
    callback clicked();
    height: State.large-screen ? 104px : 92px;
    background: root.selected ? Theme.ink : Theme.paper;
    accessible-role: radio-button;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.selected;

    preview := Rectangle {
        x: (root.width - self.width) / 2; y: (root.height - 46px - 8px - label-text.height) / 2;
        width: 34px; height: 46px;
        background: Theme.paper; border-width: Theme.control-border; border-color: Theme.ink;
        Rectangle {
            x: Theme.control-border; y: Theme.control-border;
            width: parent.width - 2 * Theme.control-border; height: parent.height - 2 * Theme.control-border;
            if root.layout != "swipe-only": Rectangle {
                x: 0px; y: 0px; width: parent.width * 0.3;
                height: root.layout == "l-shaped" ? parent.height * 2 / 3 : parent.height;
                background: Theme.line;
            }
            if root.layout != "swipe-only": Rectangle {
                x: parent.width - self.width; y: 0px; width: parent.width * 0.3;
                height: root.layout == "l-shaped" ? parent.height * 2 / 3 : parent.height;
                background: Theme.secondary;
            }
            if root.layout == "l-shaped": Rectangle {
                x: 0px; y: parent.height - self.height; width: parent.width; height: parent.height / 3;
                background: Theme.secondary;
            }
            if root.layout == "swipe-only": BodyText {
                x: 0px; y: 0px; width: parent.width; height: parent.height;
                text: "⇆"; font-size: 16px; horizontal-alignment: center;
            }
        }
    }
    label-text := BodyText {
        x: 4px; y: preview.y + preview.height + 8px; width: root.width - 8px;
        height: State.large-screen ? 26px : 23px;
        text: root.label; font-size: State.large-screen ? 19px : 17px;
        font-weight: root.selected ? 700 : 400; color: root.selected ? Theme.paper : Theme.ink;
        horizontal-alignment: center;
    }
    TouchArea {
        x: 0px; y: 0px; width: root.width; height: root.height;
        clicked => { if !root.selected { root.clicked(); } }
    }
}

export component TapLayoutSelector inherits Rectangle {
    property <length> edge: Theme.control-border;
    property <length> cell-width: (root.width - root.edge * 2 - 2px) / 3;
    height: (State.large-screen ? 104px : 92px) + 2 * root.edge;
    background: Theme.ink;
    for label[index] in [Strings.setting-tap-thirds, Strings.tap-l-shape, Strings.swipe-only]: TapLayoutCard {
        x: root.edge + index * (root.cell-width + 1px); y: root.edge; width: root.cell-width;
        label: label;
        layout: index == 0 ? "thirds" : index == 1 ? "l-shaped" : "swipe-only";
        selected: index == 0 ? State.tap-layout != "l-shaped" && State.tap-layout != "swipe-only" : State.tap-layout == self.layout;
        clicked => { Commands.action("settings", "set", "tap-layout=" + self.layout); }
    }
}
