import { State, Commands, SourcePreferenceGroup } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { BodyText, Caption, Icon, ActionButton, SegmentedControl, ToggleRow } from "widgets.slint";
import { CompactPager } from "native-controls.slint";
import { PanelAction, PanelHeader } from "panels-common.slint";

component SourcePreferenceControl inherits Rectangle {
    in property <SourcePreferenceGroup> group;
    property <bool> enabled: root.group.enabled && !State.busy;
    property <bool> options: root.group.options.length > 0 && root.group.options.length <= 12;
    property <bool> multi: root.group.kind == "multi-select";
    property <int> columns: max(1, ceil(root.group.options.length * 1.0 / (root.group.options.length > (State.large-screen ? 6 : 4) ? 2 : 1)));
    property <int> rows: ceil(root.group.options.length * 1.0 / root.columns);
    property <length> label-height: State.large-screen ? 24px : 22px;
    property <length> choice-height: State.large-screen ? 52px : 44px;
    property <length> content-height: root.options ? root.label-height + 10px + root.rows * root.choice-height + (root.multi ? max(0, root.rows - 1) * 8px : max(0, root.rows - 1) * 1px + 2 * Theme.control-border) : (State.large-screen ? 62px : 56px);
    min-height: root.content-height; preferred-height: root.content-height; max-height: root.content-height;
    if root.options: Caption { x: 0px; y: 0px; width: parent.width; height: root.label-height; text: root.group.title; }
    if root.options && root.multi: Rectangle {
        x: 0px; y: root.label-height + 10px; width: parent.width; height: root.content-height - self.y;
        for row in root.rows: HorizontalLayout {
            x: 0px; y: row * (root.choice-height + 8px); width: parent.width; height: root.choice-height;
            spacing: 8px; alignment: start;
            for column in min(root.columns, max(0, root.group.options.length - row * root.columns)): PanelAction {
                property <int> option-index: row * root.columns + column;
                width: min(self.preferred-width, (root.width - (root.columns - 1) * 8px) / root.columns);
                height: root.choice-height; text: root.group.options[self.option-index].title;
                selected: root.group.options[self.option-index].value == "✓"; enabled: root.enabled && root.group.options[self.option-index].enabled;
                text-size: Theme.caption; horizontal-padding: 14px;
                clicked => { Commands.action("panel", "choose", root.group.options[self.option-index].id); }
            }
        }
    }
    if root.options && !root.multi: SegmentedControl {
        x: 0px; y: root.label-height + 10px; width: parent.width;
        labels: root.group.labels; selected: root.group.selected-option; columns: root.columns; cell-height: root.choice-height;
        enabled: root.enabled;
        chosen(index) => { Commands.action("panel", "choose", root.group.options[index].id); }
    }
    if !root.options && root.group.kind == "switch": ToggleRow {
        x: 0px; y: 0px; width: parent.width; height: root.content-height; text: root.group.title;
        value: root.group.value == "true"; enabled: root.enabled;
        toggled => { Commands.action("panel", "choose", root.group.id); }
    }
    if !root.options && root.group.kind != "switch": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: root.content-height;
        accessible-role: button; accessible-label: root.group.title; accessible-enabled: root.enabled;
        BodyText { x: 0px; y: 0px; width: max(0px, parent.width - value.width - 44px); height: parent.height; text: root.group.title; color: root.enabled ? Theme.ink : Theme.disabled; }
        value := Caption { x: parent.width - self.width - 32px; y: 0px; width: min(parent.width * 0.46, self.preferred-width); height: parent.height; text: root.group.value; horizontal-alignment: right; }
        if root.enabled: Icon { x: parent.width - 18px; y: (parent.height - 18px) / 2; width: 18px; height: 18px; kind: "chevron-right"; }
        TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: root.enabled; clicked => { Commands.action("panel", "choose", root.group.id); } }
    }
}

export component SourceSettingsPanel inherits Rectangle {
    height: layout.preferred-height;
    background: Theme.paper;
    border-width: State.large-screen ? Theme.popup-border : 0px;
    border-color: Theme.ink;
    if !State.large-screen: Rectangle { x: 0px; y: 0px; width: parent.width; height: Theme.popup-border; background: Theme.ink; }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    layout := VerticalLayout {
        x: 0px; y: 0px; width: parent.width;
        padding-left: State.large-screen ? 28px : 22px;
        padding-right: State.large-screen ? 28px : 22px;
        padding-top: State.large-screen ? 26px : 20px;
        padding-bottom: State.large-screen ? 28px : 24px;
        spacing: 8px;
        PanelHeader {
            text: State.modal-title; action-text: Strings.keyboard-done;
            closed => { Commands.action("panel", "close", ""); }
        }
        for group in State.source-preference-groups: SourcePreferenceControl { group: group; }
        if State.source-preference-groups.length == 0: Caption {
            height: State.large-screen ? 62px : 56px;
            text: Strings.source-preferences-empty; horizontal-alignment: center;
        }
        if State.panel-page-count > 1: Rectangle {
            min-height: Theme.touch; preferred-height: Theme.touch; max-height: Theme.touch;
            CompactPager {
                x: parent.width - self.width; y: 0px; page: State.panel-page; count: State.panel-page-count;
                turn(delta) => { Commands.action("panel", "page", delta); }
            }
        }
        if State.source-settings-can-remove: ActionButton {
            text: Strings.uninstall; enabled: !State.busy;
            clicked => { Commands.action("sources", "uninstall", State.source-settings-id); }
        }
    }
}

component ServerField inherits Rectangle {
    in property <string> text;
    in property <string> label;
    in property <string> placeholder;
    in property <string> action;
    property <length> label-height: State.large-screen ? 24px : 22px;
    height: root.label-height + 6px + Theme.touch;
    Caption { x: 0px; y: 0px; width: parent.width; height: root.label-height; text: root.label; }
    Rectangle {
        x: 0px; y: root.label-height + 6px; width: parent.width; height: Theme.touch;
        border-width: Theme.control-border; border-color: Theme.ink; background: Theme.paper;
        accessible-role: button; accessible-label: root.label;
        BodyText {
            x: 14px; y: 0px; width: parent.width - 28px; height: parent.height;
            text: root.text == "" ? root.placeholder : root.text;
            font-family: root.action == "edit-address" ? Theme.numbers : Theme.sans;
            color: root.text == "" ? Theme.secondary : Theme.ink;
        }
        TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { Commands.action("panel", "choose", "server-config:" + root.action); } }
    }
}

export component ServerConfigurationPanel inherits Rectangle {
    property <length> pad: State.large-screen ? 28px : 22px;
    property <length> pad-top: State.large-screen ? 26px : 20px;
    property <length> heading-height: State.large-screen ? 50px : 44px;
    property <bool> has-source-id: State.modal-items.length > 3 && State.modal-items[2].id == "server-config:edit-source-id";
    property <int> status-index: root.has-source-id ? 3 : 2;
    property <length> buttons-top: credentials.y + credentials.height + (root.has-source-id ? credentials.height + 14px : 0px) + 47px;
    height: pairing.y + pairing.height + (State.large-screen ? 28px : 24px);
    background: Theme.paper;
    border-width: State.large-screen ? Theme.popup-border : 0px;
    border-color: Theme.ink;
    if !State.large-screen: Rectangle { x: 0px; y: 0px; width: parent.width; height: Theme.popup-border; background: Theme.ink; }
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    PanelHeader {
        x: root.pad; y: root.pad-top; width: parent.width - root.pad * 2;
        text: State.modal-title; action-text: Strings.cancel; primary: false;
        closed => { Commands.action("panel", "close", ""); }
    }
    address := ServerField {
        x: root.pad; y: root.pad-top + root.heading-height + 14px; width: parent.width - root.pad * 2;
        label: Strings.server-url; text: State.modal-items.length > 0 ? State.modal-items[0].value : ""; placeholder: "http://";
        action: "edit-address";
    }
    credentials := ServerField {
        x: root.pad; y: address.y + address.height + 14px; width: parent.width - root.pad * 2;
        label: root.has-source-id ? Strings.server-credentials : Strings.api-key;
        text: State.modal-items.length > 1 ? State.modal-items[1].value : "";
        action: "edit-credential";
    }
    if root.has-source-id: ServerField {
        x: root.pad; y: credentials.y + credentials.height + 14px; width: parent.width - root.pad * 2;
        label: Strings.server-source-id; text: State.modal-items[2].value; action: "edit-source-id";
    }
    Caption {
        x: root.pad; y: root.buttons-top - 35px; width: parent.width - root.pad * 2; height: 27px;
        text: State.modal-items.length > root.status-index ? State.modal-items[root.status-index].value : "";
    }
    ActionButton {
        x: root.pad; y: root.buttons-top; width: (parent.width - root.pad * 2 - 10px) / 2;
        text: Strings.test-connection; enabled: !State.busy && address.text != "";
        clicked => { Commands.action("panel", "choose", "server-config:preview"); }
    }
    ActionButton {
        x: (parent.width + 10px) / 2; y: root.buttons-top; width: (parent.width - root.pad * 2 - 10px) / 2;
        text: Strings.save; primary: true; enabled: !State.busy;
        clicked => { Commands.action("panel", "choose", "server-config:save"); }
    }
    pairing := PanelAction {
        x: (parent.width - self.width) / 2; y: root.buttons-top + Theme.touch + 8px;
        width: self.preferred-width; height: Theme.touch;
        text: Strings.fill-on-phone; quiet: true; enabled: !State.busy;
        clicked => { Commands.action("panel", "choose", "server-config:pair"); }
    }
}
