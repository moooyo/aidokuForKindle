import { State, Commands, SourcePreferenceGroup } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { BodyText, Caption, Icon, PageBar, ToggleRow } from "widgets.slint";
import { PanelAction, PanelHeader } from "panels-common.slint";

component SourcePreferenceControl inherits Rectangle {
    in property <SourcePreferenceGroup> group;
    property <bool> options: root.group.options.length > 0 && root.group.options.length <= 12;
    property <int> columns: min(State.large-screen ? 6 : 4, max(1, root.group.options.length));
    property <int> rows: ceil(root.group.options.length * 1.0 / root.columns);
    property <length> label-height: State.large-screen ? 21px : 18px;
    property <length> choice-height: State.large-screen ? 50px : 44px;
    property <length> content-height: root.options ? root.label-height + 12px + root.rows * root.choice-height + max(0, root.rows - 1) * 8px : State.large-screen ? 60px : 54px;
    min-height: root.content-height;
    preferred-height: root.content-height;
    max-height: root.content-height;
    if root.options: Caption { x: 0px; y: 0px; width: parent.width; height: root.label-height; text: root.group.title; font-size: State.large-screen ? 14px : 12px; letter-spacing: State.large-screen ? 3px : 2px; }
    if root.options && root.group.kind == "multi-select": Rectangle {
        x: 0px; y: root.label-height + 12px; width: parent.width; height: root.content-height - self.y;
        for row in root.rows: HorizontalLayout {
            x: 0px; y: row * (root.choice-height + 8px); width: parent.width; height: root.choice-height;
            spacing: 8px; alignment: start;
            for column in min(root.columns, max(0, root.group.options.length - row * root.columns)): PanelAction {
                property <int> option-index: row * root.columns + column;
                width: min(self.preferred-width, (root.width - (root.columns - 1) * 8px) / root.columns);
                height: root.choice-height; text: root.group.options[self.option-index].title;
                selected: root.group.options[self.option-index].value == "✓"; enabled: root.group.enabled && root.group.options[self.option-index].enabled && !State.busy;
                text-size: State.large-screen ? 16px : 15px;
                horizontal-padding: State.large-screen ? 20px : 18px;
                clicked => { Commands.action("panel", "choose", root.group.options[self.option-index].id); }
            }
        }
    }
    if root.options && root.group.kind != "multi-select": Rectangle {
        x: 0px; y: root.label-height + 12px; width: parent.width; height: root.content-height - self.y;
        for option[index] in root.group.options: PanelAction {
            x: mod(index, root.columns) * ((parent.width - (root.columns - 1) * 8px) / root.columns + 8px);
            y: floor(index * 1.0 / root.columns) * (root.choice-height + 8px);
            width: (parent.width - (root.columns - 1) * 8px) / root.columns;
            height: root.choice-height; text: option.title; selected: option.value == "✓";
            enabled: root.group.enabled && option.enabled && !State.busy; text-size: State.large-screen ? 16px : 15px; horizontal-padding: 0px;
            clicked => { if option.value != "✓" { Commands.action("panel", "choose", option.id); } }
        }
    }
    if !root.options && root.group.kind == "switch": ToggleRow {
        x: 0px; y: 0px; width: parent.width; height: root.content-height; text: root.group.title;
        value: root.group.value == "true"; enabled: root.group.enabled && !State.busy;
        toggled => { Commands.action("panel", "choose", root.group.id); }
    }
    if !root.options && root.group.kind != "switch": Rectangle {
        x: 0px; y: 0px; width: parent.width; height: root.content-height;
        background: hit.pressed && root.group.enabled ? Theme.ink : Theme.paper;
        BodyText { x: 0px; y: 0px; width: max(0px, parent.width - value.width - 44px); height: parent.height; text: root.group.title; font-size: State.large-screen ? 18px : 16px; color: !root.group.enabled ? Theme.disabled : hit.pressed ? Theme.paper : Theme.ink; }
        value := Caption { x: parent.width - self.width - 32px; y: 0px; width: min(parent.width * 0.46, self.preferred-width); height: parent.height; text: root.group.value; font-size: State.large-screen ? 16px : 14px; horizontal-alignment: right; color: hit.pressed && root.group.enabled ? Theme.paper : Theme.secondary; }
        Icon { x: parent.width - 18px; y: (parent.height - 18px) / 2; width: 18px; height: 18px; kind: "chevron-right"; inverted: hit.pressed; enabled: root.group.enabled; }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
        hit := TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; enabled: root.group.enabled && !State.busy; clicked => { Commands.action("panel", "choose", root.group.id); } }
    }
}

component SourceSettingsHeader inherits Rectangle {
    in property <string> text;
    in property <string> action-text: Strings.keyboard-done;
    in property <length> title-size: State.large-screen ? 26px : 23px;
    callback closed();
    height: State.large-screen ? 50px : 44px;
    if !State.large-screen: PanelHeader {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        text: root.text; action-text: root.action-text; title-size: root.title-size;
        closed => { root.closed(); }
    }
    if State.large-screen: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        Rectangle {
            x: 0px; y: 0px; width: max(0px, parent.width - done.width - 16px); height: parent.height;
            accessible-role: AccessibleRole.text; accessible-label: root.text;
            source-name := Text {
                x: 0px; y: 0px; width: min(self.preferred-width, max(0px, parent.width - settings-label.preferred-width)); height: parent.height;
                text: State.source-title + " "; font-family: Theme.numbers; font-size: root.title-size; font-weight: 700; letter-spacing: 0px;
                color: Theme.ink; vertical-alignment: center; overflow: elide; accessible-role: none;
            }
            settings-label := Text {
                x: source-name.width; y: 0px; width: min(self.preferred-width, max(0px, parent.width - source-name.width)); height: parent.height;
                text: Strings.settings; font-family: Theme.serif; font-size: root.title-size; font-weight: 700; letter-spacing: 0px;
                color: Theme.ink; vertical-alignment: center; overflow: elide; accessible-role: none;
            }
        }
        done := PanelAction {
            x: parent.width - self.width; y: 0px; width: self.preferred-width; height: parent.height;
            text: root.action-text; primary: true;
            clicked => { root.closed(); }
        }
    }
}

export component SourceSettingsPanel inherits Rectangle {
    property <length> empty-height: State.large-screen ? 180px : 156px;
    height: State.source-preference-groups.length == 0 ? root.empty-height : contents.preferred-height;
    background: Theme.paper;
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    if !State.large-screen: Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
    if State.large-screen: Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; border-width: 2px; border-color: Theme.ink; border-radius: Theme.control-radius; background: transparent; }
    if State.source-preference-groups.length == 0: Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        SourceSettingsHeader {
            x: State.large-screen ? 28px : 22px; y: State.large-screen ? 26px : 20px;
            width: parent.width - self.x * 2; height: State.large-screen ? 50px : 44px;
            text: State.source-title + " " + Strings.settings; action-text: Strings.keyboard-done;
            title-size: State.large-screen ? 26px : 23px;
            closed => { Commands.action("panel", "close", ""); }
        }
        Caption {
            x: State.large-screen ? 28px : 22px; y: State.large-screen ? 88px : 76px;
            width: parent.width - self.x * 2; height: State.large-screen ? 64px : 54px;
            text: Strings.source-preferences-empty; font-size: State.large-screen ? 17px : 16px;
            horizontal-alignment: center;
        }
    }
    contents := Rectangle {
        visible: State.source-preference-groups.length > 0;
        x: 0px; y: 0px; width: parent.width;
        VerticalLayout {
            x: 0px; y: 0px; width: parent.width;
            padding-left: State.large-screen ? 28px : 22px;
            padding-right: State.large-screen ? 28px : 22px;
            padding-top: State.large-screen ? 26px : 20px;
            padding-bottom: State.large-screen ? 28px : 26px;
            spacing: 12px;
            Rectangle {
                min-height: State.large-screen ? 50px : 44px; preferred-height: self.min-height; max-height: self.min-height;
                SourceSettingsHeader { x: 0px; y: 0px; width: parent.width; height: parent.height; text: State.source-title + " " + Strings.settings; action-text: Strings.keyboard-done; title-size: State.large-screen ? 26px : 23px; closed => { Commands.action("panel", "close", ""); } }
            }
            for group in State.source-preference-groups: SourcePreferenceControl { group: group; }
            if State.panel-page-count > 1: Rectangle {
                min-height: Theme.pager-height; preferred-height: self.min-height; max-height: self.min-height;
                PageBar { x: 0px; y: 0px; width: parent.width; page: State.panel-page; count: State.panel-page-count; context: "panel"; turn(delta) => { Commands.action("panel", "page", delta); } }
            }
        }
    }
}

