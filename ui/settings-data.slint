import { State, Commands, SettingItem } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, BodyText, Caption, InlineAction, SegmentedControl, ToggleRow } from "widgets.slint";
import { SettingsSectionLabel, SettingsValueRow } from "settings-controls.slint";

component StorageLegend inherits Rectangle {
    in property <string> text;
    in property <string> value;
    in property <color> swatch;
    height: 34px;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text + " " + root.value;

    Rectangle {
        x: 0px; y: (root.height - self.height) / 2; width: 14px; height: 14px;
        background: root.swatch; border-width: Theme.control-border; border-color: Theme.ink;
    }
    Caption {
        x: 24px; y: 0px; width: max(0px, number.x - self.x - 8px); height: root.height;
        text: root.text;
    }
    number := BodyText {
        x: root.width - self.width; y: 0px; width: self.preferred-width; height: root.height;
        text: root.value; font-family: Theme.numbers; font-size: Theme.caption;
        font-weight: 700; horizontal-alignment: right;
    }
}

export component StorageSettings inherits Rectangle {
    property <length> row-height: State.large-screen ? 60px : 54px;
    property <length> legend-column: (root.width - 24px) / 2;
    property <length> group-gap: State.large-screen ? 26px : 20px;
    property <int> ranked-count: min(State.storage-books.length, State.large-screen ? 6 : 4);
    property <bool> has-status-line: State.storage-scale-known && State.storage-status != "";
    property <length> ranking-top: ranking-heading.y + ranking-heading.height + 8px;
    property <string> downloaded-text: State.storage-downloaded-known ? State.storage-downloaded-text : "—";
    property <string> cache-text: State.storage-image-cache-known ? State.storage-image-cache-text : "—";
    property <string> covers-text: State.storage-covers-known ? State.storage-covers-text : "—";
    property <string> free-text: State.storage-free-known ? State.storage-free-text : "—";
    height: actions.y + actions.height;

    if State.storage-scale-known: Rectangle {
        x: 0px; y: 0px; width: root.width; height: 24px;
        border-width: Theme.control-border; border-color: Theme.ink; background: Theme.paper;
        Rectangle {
            x: Theme.control-border; y: Theme.control-border;
            width: max(0px, parent.width - Theme.control-border * 2);
            height: max(0px, parent.height - Theme.control-border * 2);
            clip: true;
            downloaded := Rectangle {
                x: 0px; y: 0px; width: parent.width * clamp(State.storage-downloaded-fraction, 0, 1); height: parent.height;
                background: Theme.ink;
            }
            cached := Rectangle {
                x: downloaded.width; y: 0px; width: parent.width * clamp(State.storage-image-cache-fraction, 0, 1); height: parent.height;
                background: Theme.secondary;
            }
            Rectangle {
                x: cached.x + cached.width; y: 0px; width: parent.width * clamp(State.storage-covers-fraction, 0, 1); height: parent.height;
                background: Theme.disabled;
            }
        }
    }
    if !State.storage-scale-known: Caption {
        x: 0px; y: 0px; width: root.width; height: 24px;
        text: State.storage-status != "" ? State.storage-status : State.storage-loading ? Strings.storage-calculating : Strings.storage-unknown;
    }
    StorageLegend { x: 0px; y: 34px; width: root.legend-column; text: Strings.downloaded-chapters; value: root.downloaded-text; swatch: Theme.ink; }
    StorageLegend { x: root.legend-column + 24px; y: 34px; width: root.legend-column; text: Strings.image-cache; value: root.cache-text; swatch: Theme.secondary; }
    StorageLegend { x: 0px; y: 68px; width: root.legend-column; text: Strings.covers; value: root.covers-text; swatch: Theme.disabled; }
    StorageLegend { x: root.legend-column + 24px; y: 68px; width: root.legend-column; text: Strings.available-space; value: root.free-text; swatch: Theme.paper; }
    if root.has-status-line: Caption {
        x: 0px; y: 102px; width: root.width; height: 24px; text: State.storage-status;
    }

    ranking-heading := SettingsSectionLabel {
        x: 0px; y: 102px + root.group-gap + (root.has-status-line ? 24px : 0px);
        width: max(0px, root.width - 130px); text: Strings.storage-largest-books;
    }
    if State.storage-ready: HorizontalLayout {
        x: root.width - 130px; y: ranking-heading.y; width: 130px; height: ranking-heading.height;
        spacing: 4px; alignment: end;
        Caption { text: Strings.total; font-size: ranking-heading.font-size; }
        BodyText { text: State.storage-book-count; font-family: Theme.numbers; font-weight: 700; font-size: ranking-heading.font-size; }
        Caption { text: Strings.books-unit; font-size: ranking-heading.font-size; }
    }
    for index in root.ranked-count: SettingsValueRow {
        property <SettingItem> book: State.storage-books[index];
        x: 0px; y: root.ranking-top + index * root.row-height; width: root.width;
        text: self.book.title; value: self.book.value; action: Strings.manage; enabled: self.book.enabled && !State.busy;
        title-family: Theme.serif; title-size: Theme.book-title; title-weight: 700; value-family: Theme.numbers;
        clicked => { Commands.action("settings", "detail", self.book.id); }
    }
    if root.ranked-count == 0: Caption {
        x: 0px; y: root.ranking-top; width: root.width; height: root.row-height;
        text: State.storage-books-status != "" ? State.storage-books-status : State.storage-loading ? Strings.storage-calculating : State.storage-ready ? Strings.storage-books-empty : Strings.storage-unknown;
        wrap: word-wrap;
    }
    actions := HorizontalLayout {
        x: 0px; y: root.ranking-top + max(1, root.ranked-count) * root.row-height + 16px;
        width: root.width; height: Theme.touch; spacing: 10px;
        ActionButton {
            preferred-width: 1px; horizontal-stretch: 1; text: Strings.clear-cache; enabled: !State.busy;
            clicked => { Commands.action("settings", "detail", "clear-cache"); }
        }
        ActionButton {
            preferred-width: 1px; horizontal-stretch: 1; text: Strings.remove-read-downloads; enabled: !State.busy;
            clicked => { Commands.action("settings", "detail", "remove-read-downloads"); }
        }
    }
}

export component CategoriesSettings inherits Rectangle {
    property <length> row-height: State.large-screen ? 60px : 54px;
    property <length> list-top: heading.height + 8px;
    height: create.y + create.height;

    heading := SettingsSectionLabel { x: 0px; y: 0px; width: root.width; text: Strings.setting-library-categories; }
    for item[index] in State.settings-details: SettingsValueRow {
        x: 0px; y: root.list-top + index * root.row-height; width: root.width;
        text: item.title; value: item.value == "" ? "" : item.value + " " + Strings.books-unit;
        value-family: Theme.numbers; action: item.enabled ? Strings.rename : ""; enabled: item.enabled && !State.busy;
        clicked => { Commands.action("settings", "category-rename", item.id); }
    }
    if State.settings-details.length == 0: Caption {
        x: 0px; y: root.list-top; width: root.width; height: root.row-height;
        text: State.settings-status == "" ? "—" : State.settings-status;
    }
    create := ActionButton {
        x: 0px; y: root.list-top + max(1, State.settings-details.length) * root.row-height + 16px; width: root.width;
        text: "+  " + Strings.create-category; enabled: !State.busy;
        clicked => { Commands.action("settings", "category-create", ""); }
    }
}

component SettingsPathRow inherits Rectangle {
    in property <SettingItem> item;
    property <length> value-height-limit: State.large-screen ? 72px : 66px;
    height: value-label.y + value-label.height;
    BodyText {
        x: 0px; y: 0px; width: max(0px, root.width - open-path.width - 12px); height: Theme.touch;
        text: root.item.title;
    }
    open-path := InlineAction {
        x: root.width - self.width; y: 0px;
        text: Strings.view-full-path; enabled: root.item.value != "";
        clicked => { Commands.action("settings", "detail", "download-path"); }
    }
    value-label := Caption {
        x: 0px; y: open-path.height + 6px; width: root.width; height: min(self.preferred-height, root.value-height-limit);
        text: root.item.value; font-family: Theme.numbers; wrap: word-wrap; vertical-alignment: top;
    }
}

export component DownloadSettings inherits Rectangle {
    height: queue.y + queue.height;
    heading := SettingsSectionLabel { x: 0px; y: 0px; width: root.width; text: Strings.ahead-download; }
    ahead := SegmentedControl {
        x: 0px; y: heading.height + 8px; width: root.width;
        labels: [Strings.no-advance-download, Strings.ahead-one, Strings.ahead-two, Strings.ahead-three];
        selected: State.ahead-chapters;
        chosen(index) => { Commands.action("settings", "set", "ahead-chapters=" + index); }
    }
    resize := ToggleRow {
        x: 0px; y: ahead.y + ahead.height + 12px; width: root.width;
        text: Strings.resize-for-screen; value: State.resize-downloads;
        toggled => { Commands.action("settings", "set", "resize-downloads=" + (State.resize-downloads ? "false" : "true")); }
    }
    gray := ToggleRow {
        x: 0px; y: resize.y + resize.height; width: root.width;
        text: Strings.save-grayscale; value: State.grayscale-downloads;
        toggled => { Commands.action("settings", "set", "grayscale-downloads=" + (State.grayscale-downloads ? "false" : "true")); }
    }
    path := SettingsPathRow {
        visible: State.settings-details.length > 0;
        x: 0px; y: gray.y + gray.height + 12px; width: root.width;
        item: State.settings-details[0];
    }
    queue := ActionButton {
        x: 0px; y: path.y + (path.visible ? path.height + 16px : 0px);
        width: self.preferred-width; text: Strings.download-queue;
        clicked => { Commands.action("downloads", "open", ""); }
    }
}

export component SourceListsSettings inherits Rectangle {
    property <length> row-height: State.large-screen ? 60px : 54px;
    height: actions.y + actions.height;
    for item[index] in State.settings-details: SettingsValueRow {
        x: 0px; y: index * root.row-height; width: root.width;
        text: item.title; detail: item.value; action: item.enabled ? Strings.remove : ""; enabled: item.enabled;
        clicked => { Commands.action("settings", "detail", item.id); }
    }
    if State.settings-details.length == 0: Caption {
        x: 0px; y: 0px; width: root.width; height: root.row-height;
        text: State.settings-status == "" ? Strings.source-lists-empty : State.settings-status;
    }
    actions := HorizontalLayout {
        x: 0px; y: max(1, State.settings-details.length) * root.row-height + 16px;
        width: root.width; height: Theme.touch; spacing: 10px;
        ActionButton {
            preferred-width: 1px; horizontal-stretch: 1; text: Strings.add-source-list;
            clicked => { Commands.action("settings", "detail", "add-repository"); }
        }
        ActionButton {
            preferred-width: 1px; horizontal-stretch: 1; text: Strings.open-source-management;
            clicked => { Commands.action("settings", "detail", "manage-sources"); }
        }
    }
}
