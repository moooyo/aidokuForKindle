import { State, Commands, SettingItem } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { ActionButton, BodyText, Caption, GroupLabel, PageBar, ToggleRow } from "widgets.slint";
import { SettingsChoice, SettingsValueRow } from "settings-controls.slint";
import { DashedFrame } from "panels-common.slint";

component SettingsCreationButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    property <bool> inverted: root.enabled && hit.pressed;
    x: 0px;
    y: 0px;
    preferred-width: max(Theme.touch, label.preferred-width + (State.large-screen ? 48px : 40px));
    height: State.large-screen ? 54px : 48px;
    background: root.inverted ? Theme.ink : Theme.paper;
    border-radius: Theme.control-radius;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    DashedFrame {
        x: 0px; y: 0px; width: root.width; height: root.height;
        line-color: !root.enabled ? Theme.dotted : root.inverted ? Theme.paper : Theme.ink;
    }
    label := BodyText {
        x: 0px; y: 0px; width: root.width; height: root.height;
        text: root.text;
        font-weight: 700;
        horizontal-alignment: center;
        color: !root.enabled ? Theme.disabled : root.inverted ? Theme.paper : Theme.ink;
    }
    hit := TouchArea {
        x: 0px; y: 0px; width: root.width; height: root.height;
        enabled: root.enabled;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down { Commands.refresh("fast"); }
            else if event.kind == PointerEventKind.up { Commands.refresh("ui"); }
        }
        clicked => { root.clicked(); }
    }
}

component StorageLegend inherits Rectangle {
    in property <string> text;
    in property <string> value;
    in property <color> swatch;
    in property <bool> outlined: false;
    x: 0px;
    y: 0px;
    preferred-width: label.x + label.preferred-width + 6px + number.preferred-width;
    height: State.large-screen ? 26px : 24px;
    Rectangle {
        x: 0px; y: (root.height - self.height) / 2;
        width: State.large-screen ? 16px : 14px; height: self.width;
        background: root.swatch;
        border-width: root.outlined ? 1px : 0px;
        border-color: Theme.secondary;
    }
    label := BodyText {
        x: State.large-screen ? 24px : 21px; y: 0px;
        width: self.preferred-width; height: root.height;
        text: root.text; font-size: State.large-screen ? 15px : 14px;
    }
    number := Text {
        x: label.x + label.width + 6px; y: 0px;
        width: self.preferred-width; height: root.height;
        text: root.value;
        font-family: Theme.numbers; font-size: State.large-screen ? 15px : 14px;
        color: Theme.secondary; vertical-alignment: center;
    }
}

export component StorageSettings inherits Rectangle {
    property <length> row-height: State.large-screen ? 60px : 54px;
    property <length> legend-top: State.large-screen ? 44px : 40px;
    property <length> legend-pitch: State.large-screen ? 30px : 28px;
    property <length> status-top: root.legend-top + root.legend-pitch * 2 + 4px;
    property <bool> has-status-line: State.storage-scale-known && State.storage-status != "";
    property <length> ranking-title-top: root.status-top + (root.has-status-line ? 40px : 12px);
    property <length> ranking-top: root.ranking-title-top + (State.large-screen ? 34px : 30px);
    property <length> ranking-height: max(1, State.storage-books.length) * root.row-height;
    x: 0px;
    y: 0px;

    if State.storage-scale-known: Rectangle {
        x: 0px; y: 0px; width: root.width; height: State.large-screen ? 32px : 28px;
        border-width: 1px; border-color: Theme.secondary; border-radius: Theme.control-radius;
        background: Theme.paper; clip: true;
        Rectangle {
            x: 1px; y: 1px; width: max(0px, parent.width - 2px); height: max(0px, parent.height - 2px);
            clip: true;
            downloaded := Rectangle {
                x: 0px; y: 0px; width: parent.width * clamp(State.storage-downloaded-fraction, 0, 1); height: parent.height;
                background: Theme.ink;
            }
            cached := Rectangle {
                x: downloaded.width; y: 0px; width: parent.width * clamp(State.storage-image-cache-fraction, 0, 1); height: parent.height;
                background: Theme.secondary;
            }
            covers := Rectangle {
                x: cached.x + cached.width; y: 0px; width: parent.width * clamp(State.storage-covers-fraction, 0, 1); height: parent.height;
                background: Theme.disabled;
            }
            Rectangle {
                x: covers.x + covers.width; y: 0px; width: parent.width * clamp(State.storage-free-fraction, 0, 1); height: parent.height;
                background: Theme.paper;
            }
        }
    }
    if !State.storage-scale-known: Caption {
        x: 0px; y: 0px; width: root.width; height: State.large-screen ? 32px : 28px;
        text: State.storage-status != "" ? State.storage-status : State.storage-loading ? Strings.storage-calculating : Strings.storage-unknown;
        font-size: State.large-screen ? 15px : 14px;
    }
    HorizontalLayout {
        x: 0px; y: root.legend-top; width: root.width; height: State.large-screen ? 26px : 24px;
        spacing: State.large-screen ? 20px : 18px; alignment: start;
        StorageLegend { text: Strings.downloaded-chapters; value: State.storage-downloaded-known ? State.storage-downloaded-text : "—"; swatch: Theme.ink; horizontal-stretch: 0; }
        StorageLegend { text: Strings.image-cache; value: State.storage-image-cache-known ? State.storage-image-cache-text : "—"; swatch: Theme.secondary; horizontal-stretch: 0; }
        StorageLegend { text: Strings.covers; value: State.storage-covers-known ? State.storage-covers-text : "—"; swatch: Theme.disabled; horizontal-stretch: 0; }
    }
    StorageLegend {
        x: 0px; y: root.legend-top + root.legend-pitch; width: self.preferred-width; height: State.large-screen ? 26px : 24px;
        text: Strings.available-space; value: State.storage-free-known ? State.storage-free-text : "—";
        swatch: Theme.paper; outlined: true;
    }
    if root.has-status-line: Caption {
        x: 0px; y: root.status-top; width: root.width; height: 24px;
        text: State.storage-status; font-size: State.large-screen ? 14px : 13px;
    }
    GroupLabel {
        x: 0px; y: root.ranking-title-top; width: max(0px, root.width - 130px); height: State.large-screen ? 22px : 20px;
        text: Strings.storage-largest-books; font-size: State.large-screen ? 14px : 12px;
    }
    if State.storage-ready: Caption {
        x: max(0px, root.width - 130px); y: root.ranking-title-top; width: min(130px, root.width); height: State.large-screen ? 22px : 20px;
        text: Strings.total + " " + State.storage-book-count + " " + Strings.books-unit;
        font-size: State.large-screen ? 14px : 13px; horizontal-alignment: right;
    }
    if State.storage-books.length > 0: Rectangle { x: 0px; y: root.ranking-top; width: root.width; height: 1px; background: Theme.line; }
    for item[index] in State.storage-books: SettingsValueRow {
        x: 0px; y: root.ranking-top + index * root.row-height; width: root.width; height: root.row-height;
        text: item.title; value: item.value; action: Strings.manage; enabled: item.enabled;
        clicked => { Commands.action("settings", "detail", item.id); }
    }
    if State.storage-books.length == 0: Caption {
        x: 0px; y: root.ranking-top; width: root.width; height: root.row-height;
        text: State.storage-books-status != "" ? State.storage-books-status : State.storage-loading ? Strings.storage-calculating : State.storage-ready ? Strings.storage-books-empty : Strings.storage-unknown;
        font-size: State.large-screen ? 15px : 14px;
        wrap: word-wrap;
    }
    Rectangle {
        x: 0px; y: root.ranking-top + root.ranking-height + 12px; width: root.width; height: State.large-screen ? 54px : 48px;
        clear-cache := ActionButton {
            x: 0px; y: 0px; width: self.preferred-width; height: parent.height;
            horizontal-padding: 24px;
            text: Strings.clear-cache;
            clicked => { Commands.action("settings", "detail", "clear-cache"); }
        }
        ActionButton {
            x: clear-cache.width + 12px; y: 0px; width: self.preferred-width; height: parent.height;
            horizontal-padding: 24px;
            text: Strings.remove-read-downloads;
            clicked => { Commands.action("settings", "detail", "remove-read-downloads"); }
        }
    }
}

export component CategoriesSettings inherits Rectangle {
    property <length> row-height: State.large-screen ? 60px : 54px;
    property <length> list-height: max(1, State.settings-details.length) * root.row-height;
    x: 0px;
    y: 0px;
    if State.settings-details.length > 0: Rectangle { x: 0px; y: 0px; width: root.width; height: 1px; background: Theme.line; }
    for item[index] in State.settings-details: SettingsValueRow {
        x: 0px; y: index * root.row-height; width: root.width; height: root.row-height;
        text: item.title; value: item.value == "" ? "" : item.value + " " + Strings.books-unit;
        action: Strings.rename; enabled: item.enabled && !State.busy;
        clicked => { Commands.action("settings", "category-rename", item.id); }
    }
    if State.settings-details.length == 0: Caption {
        x: 0px; y: 0px; width: root.width; height: 32px;
        text: State.settings-status == "" ? "—" : State.settings-status;
    }
    create := SettingsCreationButton {
        x: 0px; y: root.list-height + 12px; width: self.preferred-width; height: State.large-screen ? 54px : 48px;
        text: Strings.create-category; enabled: !State.busy;
        clicked => { Commands.action("settings", "category-create", ""); }
    }
}

component SettingsPathRow inherits Rectangle {
    in property <SettingItem> item;
    property <length> value-height-limit: State.large-screen ? 72px : 66px;
    property <length> content-height: max(State.large-screen ? 94px : 86px, value-label.y + value-label.height + 14px);
    x: 0px;
    y: 0px;
    min-height: root.content-height;
    preferred-height: root.content-height;
    max-height: root.content-height;
    BodyText {
        x: 0px; y: 8px; width: max(0px, root.width - open-path.width - 12px); height: 26px;
        text: root.item.title; font-size: State.large-screen ? 17px : 16px;
    }
    open-path := ActionButton {
        x: root.width - self.width; y: 0px; width: self.preferred-width; height: 44px;
        text: Strings.view-full-path; enabled: root.item.value != "";
        clicked => { Commands.action("settings", "detail", "download-path"); }
    }
    value-label := Text {
        x: 0px; y: State.large-screen ? 42px : open-path.y + open-path.height + 12px; width: root.width; height: min(self.preferred-height, root.value-height-limit);
        text: root.item.value;
        font-family: Theme.numbers; font-size: State.large-screen ? 15px : 14px;
        color: Theme.secondary; wrap: word-wrap; overflow: elide; vertical-alignment: top;
    }
    Rectangle { x: 0px; y: root.height - 1px; width: root.width; height: 1px; background: Theme.line; }
}

export component DownloadSettings inherits Rectangle {
    property <length> row-height: State.large-screen ? 60px : 54px;
    property <length> details-top: State.large-screen ? 237px : 204px;
    x: 0px;
    y: 0px;
    GroupLabel { x: 0px; y: State.large-screen ? 10px : 0px; width: max(0px, root.width - 110px); height: State.large-screen ? 21px : 18px; text: Strings.ahead-download; font-size: State.large-screen ? 14px : 12px; }
    for label[index] in [Strings.no-advance-download, Strings.ahead-one, Strings.ahead-two, Strings.ahead-three]: SettingsChoice {
        x: index * (root.width + 8px) / 4; y: State.large-screen ? 43px : 28px; width: (root.width - 24px) / 4;
        text: label; selected: State.ahead-chapters == index;
        clicked => { if State.ahead-chapters != index { Commands.action("settings", "set", "ahead-chapters=" + index); } }
    }
    ToggleRow { x: 0px; y: State.large-screen ? 105px : 84px; width: root.width; height: root.row-height; text: Strings.resize-for-screen; value: State.resize-downloads; toggled => { Commands.action("settings", "set", "resize-downloads=" + (State.resize-downloads ? "false" : "true")); } }
    ToggleRow { x: 0px; y: (State.large-screen ? 105px : 84px) + root.row-height; width: root.width; height: root.row-height; text: Strings.save-grayscale; value: State.grayscale-downloads; toggled => { Commands.action("settings", "set", "grayscale-downloads=" + (State.grayscale-downloads ? "false" : "true")); } }
    details := VerticalLayout {
        x: 0px; y: root.details-top; width: root.width; height: self.preferred-height;
        spacing: 0px; alignment: start;
        for item in State.settings-details: SettingsPathRow { item: item; horizontal-stretch: 1; }
    }
    ActionButton {
        x: 0px; y: details.y + details.height + 12px; width: self.preferred-width; height: State.large-screen ? 54px : 48px;
        text: Strings.downloads;
        clicked => { Commands.action("downloads", "open", ""); }
    }
}

export component SourceListsSettings inherits Rectangle {
    property <length> action-height: State.large-screen ? 54px : 48px;
    property <length> pager-reserve: State.settings-details-page-count > 1 ? Theme.pager-height + 12px : 0px;
    property <length> row-height: State.large-screen ? clamp((root.height - root.pager-reserve - 12px - root.action-height) / max(1, State.settings-details.length), 54px, 60px) : 54px;
    property <length> list-height: max(1, State.settings-details.length) * root.row-height;
    x: 0px;
    y: 0px;
    if State.settings-details.length > 0: Rectangle { x: 0px; y: 0px; width: root.width; height: 1px; background: Theme.line; }
    for item[index] in State.settings-details: SettingsValueRow {
        x: 0px; y: index * root.row-height; width: root.width; height: root.row-height;
        text: item.title; detail: item.value; action: item.enabled ? Strings.remove : ""; enabled: item.enabled;
        clicked => { Commands.action("settings", "detail", item.id); }
    }
    if State.settings-details.length == 0: Caption {
        x: 0px; y: 0px; width: root.width; height: 32px;
        text: State.settings-status == "" ? Strings.source-lists-empty : State.settings-status;
        font-size: State.large-screen ? 15px : 13px;
    }
    Rectangle {
        x: 0px; y: root.list-height + 12px; width: root.width; height: root.action-height;
        add := SettingsCreationButton {
            x: 0px; y: 0px; width: self.preferred-width; height: parent.height;
            text: Strings.add-source-list;
            clicked => { Commands.action("settings", "detail", "add-repository"); }
        }
        ActionButton {
            x: add.width + 12px; y: 0px; width: self.preferred-width; height: parent.height;
            horizontal-padding: 24px;
            text: Strings.open-source-management;
            clicked => { Commands.action("settings", "detail", "manage-sources"); }
        }
    }
    if State.settings-details-page-count > 1: PageBar {
        x: State.large-screen ? -36px : -22px; y: root.height - self.height;
        width: root.width + (State.large-screen ? 72px : 44px); height: Theme.pager-height;
        page: State.settings-details-page; count: State.settings-details-page-count; context: "settings-details";
        turn(delta) => { Commands.action("settings", "detail-page", delta); }
    }
}
