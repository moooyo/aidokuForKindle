import { State, Commands, SettingItem } from "state.slint";
import { Theme } from "theme.slint";
import { BodyText, Caption, GroupLabel, InlineAction } from "widgets.slint";

component SettingSymbol inherits Path {
    in property <string> kind;
    in property <bool> selected: false;
    width: 24px;
    height: self.width;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: Theme.ink;
    stroke-width: root.selected ? 2.2px : 1.7px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands: root.kind == "default-direction" ? "M3 6.5h6.5a2.5 2.5 0 0 1 2.5 2.5v11a2 2 0 0 0-2-2H3zM21 6.5h-6.5A2.5 2.5 0 0 0 12 9v11a2 2 0 0 1 2-2h7z" :
        root.kind == "frontlight-warmth" ? "M12 8a4 4 0 1 0 0 8a4 4 0 1 0 0-8zM12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" :
        root.kind == "screen-refresh" ? "M19.5 10A8 8 0 0 0 5.3 7.2M4.5 3.5v4h4M4.5 14a8 8 0 0 0 14.2 2.8M19.5 20.5v-4h-4" :
        root.kind == "hardware-acceleration" ? "M7 7h10v10H7zM10 10h4v4h-4zM9.5 3.5V7M14.5 3.5V7M9.5 17v3.5M14.5 17v3.5M3.5 9.5H7M3.5 14.5H7M17 9.5h3.5M17 14.5h3.5" :
        root.kind == "manage-sources" ? "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM16 8l-2.5 5.5L8 16l2.5-5.5z" :
        root.kind == "storage" ? "M12 4v11M7 10.5l5 5 5-5M5 20h14" :
        root.kind == "categories" ? "M3.5 12.5V4h8.5l8.5 8.5-8 8zM8 8.5h.01" :
        root.kind == "backup" ? "M3.5 4.5h17v4h-17zM5 8.5v11h14v-11M10 12.5h4" :
        root.kind == "language" ? "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3z" :
        root.kind == "startup-options" ? "M12 3v8M7 5.7A8 8 0 1 0 17 5.7" :
        root.kind == "exit" ? "M10 4H4.5v16H10M15 8l4 4-4 4M19 12H9" :
        "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM12 11v6M12 7.5h.01";
}

export component SettingsSectionLabel inherits GroupLabel {
    height: State.large-screen ? 22px : 19px;
    font-size: State.large-screen ? 15px : 13px;
    font-weight: 700;
    letter-spacing: 1px;
}

export component SettingsEntry inherits Rectangle {
    in property <SettingItem> entry;
    in property <bool> sidebar;
    in property <bool> selected: false;
    accessible-role: button;
    accessible-label: root.sidebar || root.entry.value == "" ? root.entry.title : root.entry.title + " · " + root.entry.value;

    if root.selected: Rectangle {
        x: -16px; y: (root.height - 28px) / 2; width: 4px; height: 28px; background: Theme.ink;
    }
    SettingSymbol {
        x: 0px; y: root.sidebar ? (root.height - self.height) / 2 : 12px;
        kind: root.entry.id; selected: root.selected;
    }
    BodyText {
        x: root.sidebar ? 40px : 0px; y: root.sidebar ? 0px : 42px;
        width: root.width - self.x - (root.sidebar ? 0px : 8px);
        height: root.sidebar ? root.height : 21px;
        text: root.entry.title; font-size: root.sidebar ? 20px : 18px;
        font-weight: root.selected ? 700 : root.sidebar ? 400 : 500;
        wrap: root.sidebar ? word-wrap : no-wrap;
    }
    if !root.sidebar: Caption {
        x: 0px; y: 64px; width: root.width - 8px; height: 20px;
        text: root.entry.value; font-size: 14px;
    }
    TouchArea {
        x: 0px; y: 0px; width: root.width; height: root.height;
        clicked => {
            if root.entry.id == "exit" { Commands.action("app", "exit", ""); }
            else { Commands.action("settings", "open", root.entry.id); }
        }
    }
}

export component SettingsValueRow inherits Rectangle {
    in property <string> text;
    in property <string> value;
    in property <string> value-unit;
    in property <string> detail;
    in property <string> action;
    in property <bool> enabled: true;
    in property <string> title-family: Theme.sans;
    in property <string> value-family: Theme.sans;
    in property <int> title-weight: 400;
    in property <length> title-size: Theme.body;
    callback clicked();
    height: State.large-screen ? 60px : 54px;

    BodyText {
        x: 0px; y: root.detail == "" ? 0px : (root.height - 48px) / 2;
        width: max(0px, root.value != "" ? value-label.x - 12px : root.action != "" ? button.x - 12px : root.width);
        height: root.detail == "" ? root.height : 26px;
        text: root.text; font-family: root.title-family; font-size: root.title-size; font-weight: root.title-weight;
    }
    if root.detail != "": Caption {
        x: 0px; y: (root.height - 48px) / 2 + 26px;
        width: max(0px, root.width - (root.action == "" ? 0px : button.width + 12px)); height: 22px;
        text: root.detail;
    }
    value-label := Caption {
        x: unit-label.x - self.width - (root.value-unit == "" ? 0px : 4px); y: 0px;
        width: min(max(0px, unit-label.x), min(root.width * 0.68, self.preferred-width)); height: root.height;
        text: root.value; font-family: root.value-family; horizontal-alignment: right;
    }
    unit-label := Caption {
        x: root.width - self.width - (root.action == "" ? 0px : button.width + 12px); y: 0px;
        width: root.value-unit == "" ? 0px : self.preferred-width; height: root.height;
        text: root.value-unit;
        visible: root.value-unit != "";
    }
    button := InlineAction {
        visible: root.action != "";
        x: root.width - self.width; y: (root.height - self.height) / 2;
        width: self.preferred-width; text: root.action; enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}
