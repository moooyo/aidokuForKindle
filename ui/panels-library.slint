import { State, Commands } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { BodyText, Caption, TitleText, FilterChip, PageBar } from "widgets.slint";
import { PanelAction, PanelHeader } from "panels-common.slint";

export component LibrarySortPanel inherits Rectangle {
    x: 0px;
    y: 0px;
    property <length> pad: State.large-screen ? 24px : 22px;
    property <length> choice-height: State.large-screen ? 54px : 46px;
    property <length> choice-gap: State.large-screen ? 10px : 8px;
    property <length> grid-top: State.large-screen ? 75px : 111.5px;
    property <length> grid-height: root.choice-height * 4 + root.choice-gap * 3;
    property <length> direction-top: root.grid-top + root.grid-height + (State.large-screen ? 14px : 12px);
    property <length> filters-top: root.direction-top + (State.large-screen ? 50px : 46px) + (State.large-screen ? 18px : 16px);
    property <length> filter-cells-top: root.filters-top + (State.large-screen ? 29px : 31.5px);
    property <length> done-top: root.filter-cells-top + (State.large-screen ? 46px : 44px) + 14px;
    height: State.large-screen ? root.done-top + 56px + 24px : root.filter-cells-top + 44px + 24px;
    background: Theme.paper;
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    if !State.large-screen: Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
    if State.large-screen: Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; border-width: 2px; border-color: Theme.ink; border-radius: Theme.control-radius; background: transparent; }
    if !State.large-screen: PanelHeader {
        x: root.pad; y: 20px; width: parent.width - root.pad * 2;
        text: Strings.sort-and-filter; action-text: Strings.keyboard-done;
        closed => { Commands.action("panel", "close", ""); }
    }
    if State.large-screen: TitleText {
        x: root.pad; y: 24px; width: parent.width - root.pad * 2; height: 39px;
        text: Strings.sort-method; font-size: 26px; letter-spacing: 2px;
    }
    if !State.large-screen: Caption {
        x: root.pad; y: 80px; width: parent.width - root.pad * 2; height: 19.5px;
        text: Strings.sort-method; letter-spacing: 2px;
    }
    for key[index] in ["title", "recent-read", "recent-open", "recent-update", "added-at", "latest-chapter", "unread-count", "chapter-count"]: PanelAction {
        x: root.pad + mod(index, 2) * ((root.width - root.pad * 2 - root.choice-gap) / 2 + root.choice-gap);
        y: root.grid-top + floor(index / 2) * (root.choice-height + root.choice-gap);
        width: (root.width - root.pad * 2 - root.choice-gap) / 2;
        height: root.choice-height;
        text: index == 0 ? Strings.sort-title : index == 1 ? Strings.sort-recent : index == 2 ? Strings.sort-recent-open : index == 3 ? Strings.sort-recent-update : index == 4 ? Strings.sort-added-at : index == 5 ? Strings.sort-latest-chapter : index == 6 ? Strings.sort-unread-count : Strings.sort-chapter-count;
        selected: State.library-sort == key; align-left: true;
        text-size: State.large-screen ? 18px : 16px;
        horizontal-padding: State.large-screen ? 22px : 18px;
        clicked => { Commands.action("library", "sort", key); }
    }
    for ascending[index] in [false, true]: PanelAction {
        x: root.pad + index * ((root.width - root.pad * 2 - root.choice-gap) / 2 + root.choice-gap);
        y: root.direction-top; width: (root.width - root.pad * 2 - root.choice-gap) / 2;
        height: State.large-screen ? 50px : 46px;
        text: State.library-sort == "title" ? (ascending ? Strings.ascending : Strings.descending) : (ascending ? Strings.old-to-new : Strings.new-to-old);
        selected: State.library-ascending == ascending;
        clicked => { Commands.action("library", "sort-direction", ascending ? "ascending" : "descending"); }
    }
    Caption {
        x: root.pad; y: root.filters-top; width: parent.width - root.pad * 2;
        height: State.large-screen ? 21px : 19.5px; text: Strings.filter; letter-spacing: 2px;
    }
    HorizontalLayout {
        x: root.pad; y: root.filter-cells-top; width: parent.width - root.pad * 2;
        height: State.large-screen ? 46px : 44px; spacing: 8px; alignment: start;
        for key[index] in ["downloaded", "unread", "tracked", "completed"]: FilterChip {
            text-size: 16px;
            horizontal-padding: State.large-screen ? 18px : 19px;
            max-width: (parent.width - 24px) / 4;
            text: index == 0 ? Strings.downloaded : index == 1 ? Strings.has-unread : index == 2 ? Strings.tracked : Strings.completed;
            state: State.library-filters[index];
            clicked => { Commands.action("library", "cycle-filter", key); }
        }
    }
    if State.large-screen: PanelAction {
        x: root.pad; y: root.done-top; width: parent.width - root.pad * 2; height: 56px;
        text: Strings.keyboard-done; primary: true; text-size: 18px;
        clicked => { Commands.action("panel", "close", ""); }
    }
}

export component DownloadQueuePanel inherits Rectangle {
    x: 0px;
    y: 0px;
    property <length> pad-x: State.large-screen ? 32px : 22px;
    property <length> pad-top: State.large-screen ? 30px : 20px;
    property <length> header-height: State.large-screen ? 50px : 44px;
    property <length> row-height: State.large-screen ? 95px : 77px;
    property <length> row-gap: State.large-screen ? 12px : 10px;
    property <length> list-top: root.pad-top + root.header-height + root.row-gap;
    property <length> list-height: State.download-queue.length == 0 ? 77px : State.download-queue.length * root.row-height + max(0, State.download-queue.length - 1) * root.row-gap;
    property <length> surface-inset: State.large-screen ? 2px : 0px;
    property <length> pad-bottom: State.large-screen ? 28px : 24px;
    property <length> pager-height: State.panel-page-count > 1 ? Theme.pager-height : 0px;
    property <length> pager-top: root.list-top + root.list-height + (root.pager-height > 0px ? 8px : 0px);
    height: root.pager-top + root.pager-height + root.pad-bottom;
    background: Theme.paper;
    border-radius: State.large-screen ? Theme.control-radius : 0px;
    TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; }
    if !State.large-screen: Rectangle { x: 0px; y: 0px; width: parent.width; height: 2px; background: Theme.ink; }
    TitleText {
        x: root.pad-x; y: root.pad-top; width: max(0px, parent.width - self.x * 2 - pause.width - done.width - (State.large-screen ? 20px : 16px));
        height: root.header-height; text: Strings.download-queue; font-size: State.large-screen ? 28px : 23px; letter-spacing: 2px;
    }
    pause := PanelAction {
        x: done.x - self.width - (State.large-screen ? 10px : 8px); y: root.pad-top;
        width: self.preferred-width; height: root.header-height;
        text: State.downloads-paused ? Strings.resume-all : Strings.pause-all;
        horizontal-padding: State.large-screen ? 20px : 18px;
        enabled: State.downloads-paused ? State.download-queue-can-resume : State.download-queue-can-pause;
        clicked => { Commands.action("downloads", "pause-toggle", ""); }
    }
    done := PanelAction {
        x: parent.width - root.pad-x - self.width; y: root.pad-top;
        width: self.preferred-width; height: root.header-height;
        text: Strings.close; primary: true;
        clicked => { Commands.action("panel", "close", ""); }
    }
    for item[index] in State.download-queue: Rectangle {
        x: root.pad-x; y: root.list-top + index * (root.row-height + root.row-gap);
        width: parent.width - root.pad-x * 2; height: root.row-height;
        background: hit.pressed ? Theme.ink : Theme.paper;
        accessible-role: button;
        accessible-label: item.title + " " + item.chapter + " " + item.status;
        Rectangle {
            x: 0px; y: State.large-screen ? 14px : 12px;
            width: State.large-screen ? 48px : 38px; height: State.large-screen ? 66px : 52px;
            border-width: 1px; border-color: hit.pressed ? Theme.paper : Theme.secondary;
            background: Theme.paper; clip: true;
            if item.cover.width == 0: TitleText { x: 2px; y: 2px; width: parent.width - 4px; height: parent.height - 4px; text: item.title; font-size: State.large-screen ? 10px : 9px; wrap: word-wrap; horizontal-alignment: center; }
            Image { x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px; source: item.cover; image-fit: cover; }
        }
        content := Rectangle {
            x: State.large-screen ? 64px : 52px; y: State.large-screen ? 24px : 21px;
            width: parent.width - self.x; height: State.large-screen ? 44px : 34px;
            BodyText { x: 0px; y: 0px; width: max(0px, parent.width - status.width - 12px); height: State.large-screen ? 27px : 24px; text: item.title + (item.chapter == "" ? "" : " · " + item.chapter); font-size: State.large-screen ? 18px : 16px; font-weight: 500; color: hit.pressed ? Theme.paper : Theme.ink; }
            status := Caption { x: parent.width - self.width; y: 0px; width: min(parent.width * 0.35, self.preferred-width); height: State.large-screen ? 27px : 24px; text: item.total > 0 && (item.state == "downloading" || item.state == "completed") ? item.completed + " / " + item.total + " " + Strings.pages-unit : item.status; font-family: Theme.numbers; font-size: State.large-screen ? 15px : 14px; color: hit.pressed ? Theme.paper : Theme.secondary; horizontal-alignment: right; }
            Rectangle { x: 0px; y: State.large-screen ? 37px : 32px; width: parent.width; height: State.large-screen ? 5px : 4px; background: Theme.line; border-radius: 2px;
                Rectangle { x: 0px; y: 0px; width: parent.width * clamp(item.progress, 0, 1); height: parent.height; background: Theme.ink; border-radius: 2px; }
            }
        }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
        hit := TouchArea {
            x: 0px; y: 0px; width: parent.width; height: parent.height;
            pointer-event(event) => { if event.kind == PointerEventKind.down { Commands.refresh("fast"); } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel { Commands.refresh("ui"); } }
            clicked => { Commands.action("panel", "choose", "job:" + item.id); }
        }
    }
    if State.download-queue.length == 0: BodyText {
        x: root.pad-x; y: root.list-top; width: parent.width - root.pad-x * 2; height: root.list-height;
        text: Strings.no-downloads; color: Theme.secondary; horizontal-alignment: center;
    }
    // Keep the frame outside the pager fill and below any upward page-jump surface.
    if State.large-screen: Rectangle { x: 0px; y: 0px; width: root.width; height: root.height; border-width: 2px; border-color: Theme.ink; border-radius: Theme.control-radius; background: transparent; }
    if State.panel-page-count > 1: PageBar {
        x: root.surface-inset; y: root.pager-top;
        width: max(0px, root.width - root.surface-inset * 2); height: root.pager-height;
        page: State.panel-page; count: State.panel-page-count; context: "panel";
        turn(delta) => { Commands.action("panel", "page", delta); }
    }
}
