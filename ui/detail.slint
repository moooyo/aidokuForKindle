import { State, Commands, ChapterItem } from "state.slint";
import { Theme } from "theme.slint";
import { Strings } from "strings.slint";
import { BodyText, Caption, TitleText, Icon, IconButton, ActionButton, InlineAction, Tab, PageBar, Cover, EmptyState, ChapterDownloadButton } from "widgets.slint";

component ChapterRow inherits Rectangle {
    in property <ChapterItem> chapter;
    property <bool> suppress-click: false;
    property <length> press-x;
    property <length> press-y;
    property <length> action-width: State.large-screen ? 60px : 52px;
    property <length> title-left: State.large-screen ? 66px : 58px;
    property <length> text-top: (root.height - (State.large-screen ? 54px : 48px)) / 2;
    background: root.chapter.current ? Theme.fill : Theme.paper;
    height: State.large-screen ? 80px : 70px;
    accessible-role: button;
    accessible-label: root.chapter.number + " " + root.chapter.title;
    accessible-checkable: State.chapter-selection-mode;
    accessible-checked: root.chapter.selected;
    Text {
        x: 10px; y: 0px; width: State.large-screen ? 42px : 34px; height: parent.height;
        text: root.chapter.number; font-family: Theme.numbers; font-size: State.large-screen ? 22px : 18px;
        font-weight: root.chapter.current ? 700 : 400; vertical-alignment: center; overflow: elide;
        color: root.chapter.read && !root.chapter.current ? Theme.secondary : Theme.ink;
    }
    title := BodyText {
        x: root.title-left; y: root.text-top;
        width: min(self.preferred-width, parent.width - self.x - root.action-width - (root.chapter.is-new ? badge.width + 8px : 0px));
        height: State.large-screen ? 29px : 26px;
        text: root.chapter.title; font-weight: root.chapter.current ? 700 : 400;
        color: root.chapter.read && !root.chapter.current ? Theme.secondary : Theme.ink;
    }
    badge := Rectangle {
        visible: root.chapter.is-new; x: title.x + title.width + 8px; y: title.y + (title.height - self.height) / 2;
        width: new-label.preferred-width + 10px; height: 18px; background: Theme.ink;
        new-label := BodyText { x: 0px; y: 0px; width: parent.width; height: parent.height; text: Strings.chapter-new; font-size: 12px; font-weight: 700; color: Theme.paper; horizontal-alignment: center; }
    }
    Caption {
        x: root.title-left; y: title.y + title.height + 2px;
        width: parent.width - self.x - root.action-width; height: 22px;
        text: root.chapter.current ? root.chapter.progress : root.chapter.read ? Strings.read : Strings.unread;
        font-family: root.chapter.current ? Theme.numbers : Theme.sans;
    }
    touch := TouchArea {
        x: 0px; y: 0px;
        width: State.chapter-selection-mode ? parent.width : parent.width - root.action-width; height: parent.height;
        moved => {
            if self.pressed && (abs(self.mouse-x - root.press-x) >= 12px || abs(self.mouse-y - root.press-y) >= 12px) {
                root.suppress-click = true; hold.running = false;
            }
        }
        pointer-event(event) => {
            if event.kind == PointerEventKind.down {
                root.press-x = self.mouse-x; root.press-y = self.mouse-y;
                root.suppress-click = false; hold.running = !State.chapter-selection-mode;
            } else if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                hold.running = false;
                if event.kind == PointerEventKind.cancel { root.suppress-click = true; }
            }
        }
        clicked => {
            if !root.suppress-click { Commands.action("detail", State.chapter-selection-mode ? "select-chapter" : "open-chapter", root.chapter.id); }
        }
    }
    hold := Timer {
        interval: 500ms; running: false;
        triggered => {
            self.running = false;
            if touch.pressed && !root.suppress-click {
                root.suppress-click = true;
                Commands.action("detail", "select-chapter", root.chapter.id);
            }
        }
    }
    if !State.chapter-selection-mode: ChapterDownloadButton {
        x: parent.width - root.action-width; y: 0px; width: root.action-width; height: parent.height;
        state: root.chapter.download-state; progress: root.chapter.download-progress; downloaded: root.chapter.downloaded;
        clicked => { Commands.action("detail", self.command, root.chapter.id); }
    }
    if State.chapter-selection-mode: Rectangle {
        x: parent.width - (root.action-width + self.width) / 2; y: (parent.height - self.height) / 2;
        width: 28px; height: 28px; border-width: Theme.control-border; border-color: Theme.ink;
        background: root.chapter.selected ? Theme.ink : Theme.paper;
        if root.chapter.selected: Icon { x: 4px; y: 4px; width: 20px; height: 20px; kind: "check"; inverted: true; }
    }
}

export component DetailPage inherits Rectangle {
    background: Theme.paper;
    clip: true;
    property <length> chapter-left: State.large-screen ? 320px : Theme.margin;
    property <length> chapter-width: root.width - root.chapter-left - Theme.margin;
    property <length> chapter-header-top: State.large-screen ? 64px : 284px;
    property <length> chapter-top: root.chapter-header-top + 96px;
    property <length> chapter-row-height: State.large-screen ? 80px : 70px;
    property <bool> bookmarks: State.detail-filter == 3;
    property <bool> can-read: State.current-chapter-id != "";
    IconButton { y: 0px; x: Theme.margin - 8px; icon: "back"; label: Strings.back; clicked => { Commands.action("detail", "back", ""); } }
    IconButton { y: 0px; x: parent.width - Theme.margin + 8px - Theme.touch; icon: "more"; label: Strings.more; clicked => { Commands.action("detail", "more", ""); } }
    Rectangle {
        x: Theme.margin; y: Theme.toolbar-height; width: State.large-screen ? 240px : parent.width - Theme.margin * 2;
        height: State.large-screen ? parent.height - self.y : 222px;
        property <length> text-left: State.large-screen ? 0px : 120px;
        Cover { x: 0px; y: 0px; width: State.large-screen ? 200px : 102px; height: State.large-screen ? 272px : 138px; book: State.current-book; }
        TitleText { x: parent.text-left; y: State.large-screen ? 288px : 0px; width: parent.width - self.x; height: State.large-screen ? 36px : 34px; text: State.current-book.title; font-size: State.large-screen ? 27px : 23px; font-weight: 700; }
        Caption { x: parent.text-left; y: State.large-screen ? 330px : 38px; width: parent.width - self.x; height: 24px; text: State.current-book.author; }
        Caption { x: parent.text-left; y: State.large-screen ? 360px : 66px; width: parent.width - self.x; height: 24px; text: State.book-metadata; }
        if State.current-chapter-number != "": HorizontalLayout {
            x: parent.text-left; y: State.large-screen ? 396px : 94px; width: parent.width - self.x; height: 24px; spacing: 4px; alignment: start;
            BodyText { text: Strings.chapter-prefix + State.current-chapter-number + Strings.chapter-suffix + " ·"; font-size: Theme.caption; }
            BodyText { text: State.reader-page + " / " + State.reader-total; font-family: Theme.numbers; font-size: Theme.caption; }
        }
        ActionButton { x: parent.text-left; y: State.large-screen ? 440px : 128px; width: State.large-screen ? parent.width : parent.width - self.x - Theme.touch - 8px; text: Strings.continue-reading; primary: !State.chapter-selection-mode; enabled: root.can-read; clicked => { Commands.action("detail", "continue", ""); } }
        IconButton { x: State.large-screen ? 0px : parent.width - Theme.touch; y: State.large-screen ? 506px : 128px; icon: State.current-book.in-library ? "check" : "plus"; filled: true; checkable: true; checked: State.current-book.in-library; label: State.current-book.in-library ? Strings.in-library : Strings.add-to-library; clicked => { Commands.action("detail", "favorite", ""); } }
        if State.large-screen: IconButton { x: 64px; y: 506px; width: parent.width - self.x; icon: "download"; text: Strings.batch-download-menu; filled: true; enabled: root.can-read; clicked => { Commands.action("detail", "batch-download", ""); } }
        if State.large-screen && State.book-description != "": Rectangle {
            x: 0px; y: 580px; width: parent.width; height: max(0px, parent.height - self.y);
            Caption { x: 0px; y: 0px; width: parent.width; height: 30px; text: Strings.description; letter-spacing: 2px; }
            BodyText { x: 0px; y: 36px; width: parent.width; height: parent.height - self.y; text: State.book-description; font-size: Theme.caption; wrap: word-wrap; vertical-alignment: top; }
            TouchArea { x: 0px; y: 0px; width: parent.width; height: parent.height; clicked => { Commands.action("detail", "summary", ""); } }
        }
        if !State.large-screen: Rectangle {
            x: 0px; y: 186px; width: parent.width; height: 36px;
            BodyText { x: 0px; y: 0px; width: summary.x - 8px; height: parent.height; text: State.book-description; font-size: Theme.caption; }
            summary := Caption { x: parent.width - self.width; y: 0px; width: self.preferred-width; height: parent.height; text: Strings.description + " ›"; }
            TouchArea { x: 0px; y: (parent.height - Theme.touch) / 2; width: parent.width; height: Theme.touch; clicked => { Commands.action("detail", "summary", ""); } }
        }
    }
    Rectangle {
        x: root.chapter-left; y: root.chapter-header-top; width: root.chapter-width; height: 96px;
        Heading := HorizontalLayout {
            x: 0px; y: 0px; width: parent.width; height: 36px; spacing: 10px; alignment: start;
            BodyText { text: Strings.chapters; font-size: State.large-screen ? 26px : 22px; font-weight: 700; }
            BodyText { text: State.chapter-count; font-family: Theme.numbers; font-size: State.large-screen ? 26px : 22px; font-weight: 600; }
        }
        if !State.large-screen && !State.chapter-selection-mode && !root.bookmarks: InlineAction {
            x: parent.width - self.width; y: -8px;
            text: Strings.batch-download-menu;
            enabled: State.chapter-count > 0;
            clicked => { Commands.action("detail", "batch-download", ""); }
        }
        if !State.chapter-selection-mode: HorizontalLayout {
            x: 0px; y: 40px; height: Theme.touch; width: parent.width - Theme.touch * 2 - 12px;
            spacing: State.large-screen ? 18px : 14px; alignment: start;
            for label[index] in [Strings.all, Strings.unread, Strings.downloaded, Strings.bookmark]: Tab {
                text: label; height: parent.height; text-size: Theme.body;
                selected: State.detail-filter == index;
                clicked => { Commands.action("detail", "filter", index); }
            }
        }
        if !State.chapter-selection-mode && !root.bookmarks: IconButton { x: parent.width - Theme.touch * 2; y: 40px; icon: "bookmark"; label: Strings.locate-chapter; enabled: State.can-locate-chapter; clicked => { Commands.action("detail", "locate", ""); } }
        if !State.chapter-selection-mode && !root.bookmarks: IconButton { x: parent.width - Theme.touch; y: 40px; icon: "sort"; label: Strings.sort; enabled: State.chapters.length > 1 || State.page-count > 1; clicked => { Commands.action("detail", "sort", ""); } }
        if !State.chapter-selection-mode && root.bookmarks: ActionButton { x: parent.width - self.width; y: 40px; width: self.preferred-width; text: State.bookmark-edit ? Strings.keyboard-done : Strings.edit; quiet: true; visible: State.detail-bookmarks.length > 0; clicked => { Commands.action("detail", "bookmark-edit", ""); } }
        if State.chapter-selection-mode: Rectangle {
            x: 0px; y: 40px; width: parent.width; height: Theme.touch;
            select-all := ActionButton {
                x: 0px; y: 0px; width: self.preferred-width; horizontal-padding: 18px;
                text: Strings.select-all; clicked => { Commands.action("detail", "select-all-chapters", ""); }
            }
            ActionButton {
                x: select-all.width + 8px; y: 0px; width: max(0px, cancel.x - self.x - 8px);
                text: Strings.download + " " + State.selected-chapter-count + " " + Strings.chapters-unit;
                primary: true; enabled: State.selected-chapter-count > 0;
                clicked => { Commands.action("detail", "download-selected", ""); }
            }
            cancel := ActionButton {
                x: parent.width - self.width; y: 0px; width: self.preferred-width; horizontal-padding: 18px;
                text: Strings.cancel; clicked => { Commands.action("detail", "cancel-selection", ""); }
            }
        }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.line; }
    }
    if !root.bookmarks && State.chapters.length == 0: EmptyState {
        x: root.chapter-left; y: root.chapter-top + 48px; width: root.chapter-width;
        icon: ""; title: State.busy ? Strings.loading : Strings.chapters-empty;
        action: State.busy ? "" : State.detail-filter == 0 ? Strings.retry : Strings.all; primary: false;
        clicked => { Commands.action("detail", State.detail-filter == 0 ? "reload" : "filter", "0"); }
    }
    for chapter[index] in State.chapters: ChapterRow { x: root.chapter-left; y: root.chapter-top + index * root.chapter-row-height; width: root.chapter-width; height: root.chapter-row-height; chapter: chapter; }
    if root.bookmarks && State.detail-bookmarks.length == 0: EmptyState {
        x: root.chapter-left; y: root.chapter-top + 48px; width: root.chapter-width;
        icon: ""; title: Strings.no-bookmarks; action: Strings.continue-reading; primary: false;
        clicked => { Commands.action("detail", "continue", ""); }
    }
    for item[index] in State.detail-bookmarks: Rectangle {
        x: root.chapter-left; y: root.chapter-top + index * root.chapter-row-height; width: root.chapter-width; height: root.chapter-row-height;
        BodyText { x: 10px; y: (parent.height - 48px) / 2; width: parent.width - Theme.touch - 20px; height: 26px; text: item.title; }
        Caption { x: 10px; y: (parent.height - 48px) / 2 + 26px; width: parent.width - Theme.touch - 20px; height: 22px; text: item.value; }
        TouchArea { x: 0px; y: 0px; width: parent.width - Theme.touch; height: parent.height; clicked => { if !State.bookmark-edit { Commands.action("panel", "choose", "bookmark:" + item.id); } } }
        IconButton { x: parent.width - Theme.touch; y: (parent.height - Theme.touch) / 2; icon: State.bookmark-edit ? "trash" : "chevron-right"; label: State.bookmark-edit ? Strings.delete : Strings.open; clicked => { if State.bookmark-edit { Commands.action("detail", "bookmark-remove", item.id); } else { Commands.action("panel", "choose", "bookmark:" + item.id); } } }
    }
    if State.page-count > 1: PageBar { x: root.chapter-left; y: parent.height - self.height; width: root.chapter-width; page: State.page; count: State.page-count; turn(delta) => { Commands.action("page", "turn", delta); } }
}
