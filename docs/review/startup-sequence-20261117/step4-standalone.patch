diff --git a/src/native_query/worker.c b/src/native_query/worker.c
index 5217d82..cd23fcc 100644
--- a/src/native_query/worker.c
+++ b/src/native_query/worker.c
@@ -90,8 +90,44 @@ static void *load_api(struct lipc_api *api) {
     return library;
 }
 
+static int module_space(unsigned char byte) {
+    return byte == ' ' || byte == '\t' || byte == '\r' || byte == '\n';
+}
+
+static int stock_sleep_modules(const char *value) {
+    if (value == NULL) return 0;
+    size_t length = strnlen(value, MAX_VALUE + 1);
+    if (length == 0 || length > MAX_VALUE) return 0;
+    int screensaver = 0;
+    for (size_t offset = 0; offset < length;) {
+        if (module_space((unsigned char)value[offset])) { offset++; continue; }
+        size_t start = offset;
+        while (offset < length && !module_space((unsigned char)value[offset])) offset++;
+        size_t size = offset - start;
+        if (size == 11 && memcmp(value + start, "screensaver", 11) == 0) screensaver = 1;
+        else if (size == 10 && memcmp(value + start, "langpicker", 10) == 0) {}
+        else if (size == 11 && memcmp(value + start, "blankwindow", 11) == 0) {}
+        else if (size == 3 && memcmp(value + start, "usb", 3) == 0) {}
+        else return 0;
+    }
+    return screensaver;
+}
+
+/* A separate command leaves the existing AQ1 session and opcode set unchanged.
+ * Older helpers reject this command before opening LIPC; the launcher falls
+ * back to its original bounded observation and parser. */
+static int sleep_capability(struct lipc_api *api, LipcHandle *handle) {
+    char *value = NULL;
+    int status = api->get_string(handle, "com.lab126.blanket", "load", &value);
+    if (status != 0) return -1;
+    int supported = stock_sleep_modules(value);
+    if (value != NULL) api->free_string(value);
+    return write_all(supported ? "1\n" : "0\n", 2);
+}
+
 int main(int argc, char **argv) {
-    if (argc != 2 || strcmp(argv[1], "--session") != 0) return 64;
