+    if (!probe_sleep && (argc != 2 || strcmp(argv[1], "--session") != 0)) return 64;
     pid_t parent = getppid();
     if (parent <= 1 || prctl(PR_SET_PDEATHSIG, SIGKILL) != 0 || getppid() != parent)
         return 70;
@@ -106,6 +142,12 @@ int main(int argc, char **argv) {
         dlclose(library);
         return 69;
     }
+    if (probe_sleep) {
+        int result = sleep_capability(&api, handle);
+        api.close(handle);
