--- a/packaging/kindle/launch.sh
+++ b/packaging/kindle/launch.sh
@@ -228,6 +228,14 @@ configure_cover_sleep() {
     # Probe once before display takeover; capability belongs to this managed
     # session. Sleep and wake still recheck current ownership independently.
     COVER_SLEEP_SUPPORTED=0
+    if [ -x "$APP_DIR/aidoku-native-query" ] &&
+        native_read_command "$APP_DIR/aidoku-native-query" --sleep-cover-capability; then
+        case "$(native_read_hex)" in
+            310a) COVER_SLEEP_SUPPORTED=1; return 0 ;;
+            300a) return 0 ;;
+        esac
+    fi
+    # Missing, older, or incompatible helpers retain the original observation.
     native_read_command lipc-get-prop -s com.lab126.blanket load || return 0
     cover_configuration_size=$(LC_ALL=C stat -c %s "$LOCK_DIR/native-read-output") || return 0
     [ "$cover_configuration_size" -gt 0 ] && [ "$cover_configuration_size" -le 128 ] || return 0
diff --git a/packaging/tests/launcher_test.py b/packaging/tests/launcher_test.py
index 5cffc3d..8305bbc 100644
--- a/packaging/tests/launcher_test.py
+++ b/packaging/tests/launcher_test.py
@@ -863,6 +863,44 @@ cat "$AIDOKU_TEST_ROOT/power-state"
         (self.root / "cover-configuration").write_text("screensaver langpicker blankwindow usb ad_screensaver\n")
         self.assert_cover_fallback(requested=False)
 
+    def test_native_sleep_capability_probe_preserves_retained_sleep_and_wake(self) -> None:
+        self.configure_sleep_cover()
+        self.shell(self.home / "app/aidoku-native-query", '''
+[ "$*" = --sleep-cover-capability ]
+printf '%s|%s\\n' "$(cat "$AIDOKU_TEST_ROOT/power-state")" "$(cat "$AIDOKU_TEST_ROOT/statusbar")" >"$AIDOKU_TEST_ROOT/native-cover-context"
+printf '1\\n'
+''')
+        pid = self.start_launcher()
+        self.assertEqual((self.root / "native-cover-context").read_text(), "active|running\n")
+        self.assertFalse((self.root / "cover-queries").exists())
+        self.park_with_cover(pid)
+        self.wake()
+        self.assertEqual(self.traces("resumed")[-1]["pid"], pid)
+        self.stop_launcher()
+        self.assert_recovered()
+
+    def test_native_sleep_capability_denial_keeps_stock_sleep(self) -> None:
+        self.configure_sleep_cover()
+        self.shell(self.home / "app/aidoku-native-query", "printf '0\\n'")
+        self.assert_cover_fallback(requested=False)
+        self.assertFalse((self.root / "cover-queries").exists())
+
+    def test_old_native_sleep_helper_falls_back_to_the_legacy_observation(self) -> None:
+        self.configure_sleep_cover()
+        self.shell(self.home / "app/aidoku-native-query", "exit 64")
+        pid = self.start_launcher()
+        self.assertEqual(len((self.root / "cover-queries").read_text().splitlines()), 1)
+        self.park_with_cover(pid)
+        self.stop_launcher()
+        self.assert_recovered()
+
+    def test_malformed_native_sleep_output_is_not_trusted(self) -> None:
+        self.configure_sleep_cover()
+        (self.root / "cover-configuration").write_text("screensaver unknown\n")
+        self.shell(self.home / "app/aidoku-native-query", "printf '1 unexpected\\n'")
+        self.assert_cover_fallback(requested=False)
+        self.assertEqual(len((self.root / "cover-queries").read_text().splitlines()), 1)
+
     def test_unknown_module_configuration_keeps_stock_sleep(self) -> None:
         self.configure_sleep_cover()
         (self.root / "cover-configuration").write_text("screensaver langpicker blankwindow usb unknown\n")
